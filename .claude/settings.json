{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.js\"",
            "timeout": 10,
            "statusMessage": "git-guard"
          }
        ]
      }
    ]
  }
}
