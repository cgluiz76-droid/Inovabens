@* Página do imóvel no site público (/site/imovel/{id}, aberta a visitantes; também pelo botão "Ver no site" da ficha).
   Mostra só o que o site mostra: fotos públicas, características públicas e o endereço apenas se for público. *@
@using System.Globalization

<SiteMoldura Titulo="@(SoSimulador ? "Simular financiamento · " + Im.Titulo : Im.Titulo)" Ativo="@(Locacao ? "locacao" : "venda")" MensagemWhatsapp="@MensagemWhatsapp"
             Descricao="@DescricaoMeta" Canonico="@(SoSimulador ? $"site/imovel/{Im.Id}/simulador" : $"site/imovel/{Im.Id}")"
             Imagem="@(Fotos.Count > 0 ? Fotos[0].Src : null)" DadosEstruturados="@Trilha">
    <Faixa>
        é assim que o @Im.Codigo aparece no site.
        @if (!Im.DivulgarSite)
        {
            <span class="alerta"> Este imóvel não está marcado para divulgar no site (não aparece no início nem na busca).</span>
        }
        @if (Fotos.Count == 0)
        {
            <span class="alerta"> Nenhuma foto marcada como pública.</span>
        }
    </Faixa>
    <FaixaLinks>
        @if (LinkImobibrasil is not null)
        {
            <a href="@LinkImobibrasil" target="_blank" rel="noopener">Ver no site atual (Imobibrasil) ↗</a>
            <span> · </span>
        }
        <a href="imoveis/@Im.Id">Ficha do sistema</a>
    </FaixaLinks>
    <ChildContent>
        @if (SoSimulador)
        {
            <main class="miolo imovel-pag">
                <nav class="trilha" aria-label="Você está em">
                    <a href="site">Início</a><span>›</span><a href="@LinkLista">Comprar</a>
                    <span>›</span><a href="site/imovel/@Im.Id">@Codigo</a><span>›</span><span>Simular financiamento</span>
                </nav>
                <div class="sim-cab">
                    @if (Fotos.Count > 0)
                    {
                        <img src="@Fotos[0].Pequena" alt="" width="400" height="300" fetchpriority="high" />
                    }
                    <div>
                        <span class="rotulo">@TipoRotulo à venda · @Codigo</span>
                        <h1>@Im.Titulo</h1>
                        @if (Onde.Length > 0) { <div class="local"><svg class="ico"><use href="#i-pino" /></svg>@Onde</div> }
                        <div class="preco num">@PrecoTexto</div>
                    </div>
                    <div class="sim-cab-acoes">
                        <a class="btn btn-zap" href="@LinkWhatsapp" target="_blank" rel="noopener"><svg class="ico"><use href="#i-zap" /></svg> Conversar no WhatsApp</a>
                        <a class="btn btn-linha" href="site/imovel/@Im.Id">Ver o imóvel</a>
                    </div>
                </div>
            @if (Simulador is { } sim && Caixa is { } cx)
            {
                <div class="bloco" id="simulador">
                    <h2>Simule o financiamento</h2>
                    <p class="aviso-simulacao" role="note">
                        <b>Isto é uma simulação.</b> O financiamento real pode ter variação nas parcelas e depende de
                        análise de crédito e aprovação da instituição financeira.
                    </p>
                    <form class="simulador" id="simForm" onsubmit="return false">
                        <fieldset class="sim-sistema">
                            <legend>Sistema de amortização</legend>
                            <label><input type="radio" name="sistema" value="sac" checked /> <span><b>SAC</b><small>parcelas que diminuem · financia até @Pct(FinanciamentoCaixa.CotaSac)</small></span></label>
                            <label><input type="radio" name="sistema" value="price" /> <span><b>Price</b><small>parcelas fixas · financia até @Pct(FinanciamentoCaixa.CotaPrice)</small></span></label>
                        </fieldset>
                        <label>Valor do imóvel (R$)
                            <input id="simValor" type="text" inputmode="numeric" autocomplete="off" value="@Brl2(Preco ?? 0)" data-valor="@Num(Preco ?? 0, "0.00")" />
                        </label>
                        <label>Entrada (R$) <small class="mudo" id="simEntradaPct">@Pct(sim.Entrada / (Preco ?? 1)) do valor</small>
                            <input id="simEntrada" type="text" inputmode="numeric" autocomplete="off" value="@Brl2(sim.Entrada)" data-valor="@Num(sim.Entrada, "0.00")" />
                        </label>
                        <label>Prazo <output id="simPrazoTxt" for="simPrazo">@PrazoTexto(sim.Prazo)</output>
                            <input id="simPrazo" type="range" min="12" max="@FinanciamentoCaixa.PrazoMaximo" step="6" value="@sim.Prazo" />
                        </label>
                        <label>Idade do comprador mais velho <small class="mudo">(opcional)</small>
                            <input id="simIdade" type="number" min="18" max="80" inputmode="numeric" placeholder="ex.: 35" />
                        </label>
                        <label>Renda familiar bruta (R$) <small class="mudo">(opcional)</small>
                            <input id="simRenda" type="text" inputmode="numeric" autocomplete="off" placeholder="ex.: 8.000,00" />
                        </label>
                    </form>

                    <div class="sim-detalhe" id="simDetalhe" aria-live="polite">
                        <div class="sim-detalhe-cab">
                            <span class="banco-logo" id="dLogo"><img src="@cx.Banco.Logo" alt="@cx.Banco.Nome" /></span>
                            <div>
                                <b id="dNome">@cx.Banco.Nome</b>
                                <small class="mudo" id="dTaxa">Taxa média de @Pct(cx.TaxaAno) ao ano + TR (Banco Central, @Mes(cx.Competencia))</small>
                            </div>
                        </div>
                        <div class="sim-resultado">
                            <div><small>Valor financiado</small><b class="num" id="rFinanciado">@Brl(sim.ValorFinanciado)</b></div>
                            <div class="destaque"><small id="rPrimeiraRotulo">1ª parcela</small><b class="num" id="rPrimeira">@Brl(sim.PrimeiraParcela)</b></div>
                            <div id="rUltimaCaixa"><small>Última parcela</small><b class="num" id="rUltima">@Brl(sim.UltimaParcela)</b></div>
                            <div><small>Renda familiar mínima</small><b class="num" id="rRenda">@Brl(sim.RendaMinima)</b></div>
                            <div><small>Total de juros</small><b class="num" id="rJuros">@Brl(sim.TotalJuros)</b></div>
                            <div><small>Taxa efetiva</small><b class="num" id="rEfetiva">@Pct(sim.TaxaEfetivaAnual) a.a.</b></div>
                        </div>
                        <ul class="sim-notas" id="simNotas"></ul>
                        <a class="btn btn-linha" id="dLink" href="@cx.Banco.LinkSimulacao" target="_blank" rel="noopener">Simular no site da Caixa ↗</a>
                    </div>

                    <h3 class="sim-sub">Compare os bancos <small class="mudo">do menor para o maior valor de parcela</small></h3>
                    <div class="sim-bancos" id="simBancos" role="radiogroup" aria-label="Bancos"></div>
                    <div class="sim-mcmv" id="simMcmv" hidden></div>

                    <div class="sim-letras mudo">
                        <p>
                            Comparativo independente: as taxas são as médias que cada banco praticou no mês (Banco Central, financiamento
                            imobiliário com taxas de mercado + TR), não uma oferta do banco. A sua taxa depende do relacionamento com o banco
                            e da análise de crédito. As regras usadas são as gerais do mercado: financia até @Pct(FinanciamentoCaixa.CotaSac) do valor
                            no SAC e até @Pct(FinanciamentoCaixa.CotaPrice) na Price; prazo de até @FinanciamentoCaixa.PrazoMaximo meses;
                            idade mais prazo até 80 anos e 6 meses; parcela de até @Pct(FinanciamentoCaixa.ComprometimentoRenda) da renda bruta familiar.
                        </p>
                        <p>
                            Não entram na conta: a TR (atualiza o saldo todo mês), os seguros obrigatórios MIP e DFI (variam com a idade e o valor do imóvel),
                            tarifas de administração, ITBI, registro em cartório e avaliação do imóvel. Minha Casa, Minha Vida: regras e taxas
                            conferidas em @ComparadorFinanciamento.McmvConferidoEm; subsídios das faixas 1 e 2 não entram na simulação.
                        </p>
                    </div>
                    <script id="sim-dados" type="application/json">@((MarkupString)ParametrosSimulador)</script>
                </div>
            }

            </main>
        }
        else
        {
        <main class="miolo imovel-pag">
            <nav class="trilha" aria-label="Você está em">
                <a href="site">Início</a><span>›</span><a href="@LinkLista">@(Locacao ? "Alugar" : "Comprar")</a>
                @if (Im.Cidade is not null) { <span>›</span><a href="@(LinkLista + "&cidade=" + Uri.EscapeDataString(Im.Cidade))">@Im.Cidade</a> }
                @if (Im.Bairro is not null) { <span>›</span><span>@Im.Bairro</span> }
                <span>›</span><span>@Codigo</span>
            </nav>

            @if (Fotos.Count == 0)
            {
                <div class="galeria poucas">
                    <div class="principal"><img src="img/sem-foto.svg" alt="Imóvel sem foto" /></div>
                </div>
                @if (Logado) { <p class="pequeno mudo aviso-sem-fotos">Sem fotos públicas: marque as fotos como públicas na ficha do imóvel.</p> }
            }
            else
            {
                <div class="galeria @(Fotos.Count < 5 ? "poucas" : "")">
                    @foreach (var (f, k) in Fotos.Take(Fotos.Count < 5 ? 1 : 5).Select((f, k) => (f, k)))
                    {
                        <button type="button" class="@(k == 0 ? "principal" : "")" data-luz="@k" aria-label="Ampliar foto @(k + 1) de @Fotos.Count">
                            @if (Fotos.Count < 5)
                            {
                                @* foto sozinha: aparece inteira, na proporção dela; as laterais ficam com a própria foto desfocada *@
                                <img class="fundo" src="@f.Pequena" alt="" aria-hidden="true" decoding="async" />
                            }
                            <img src="@f.Src" srcset="@f.Srcset" sizes="@(k == 0 ? "(max-width: 760px) 100vw, 50vw" : "(max-width: 760px) 50vw, 25vw")"
                                 alt="@(f.Legenda ?? Im.Titulo)" loading="@(k == 0 ? "eager" : "lazy")" fetchpriority="@(k == 0 ? "high" : "auto")" decoding="@(k == 0 ? "sync" : "async")" />
                        </button>
                    }
                    <button type="button" class="ver-todas" data-luz="0"><svg class="ico"><use href="#i-fotos" /></svg> Ver as @Fotos.Count fotos</button>
                </div>
            }

            <div class="cab-imovel">
                <span class="rotulo">@TipoRotulo @(Locacao ? "para alugar" : "à venda") · @Codigo</span>
                <h1>@Im.Titulo</h1>
                @if (Onde.Length > 0)
                {
                    <div class="local"><svg class="ico"><use href="#i-pino" /></svg>@Onde</div>
                }
            </div>

            <div class="imovel-grade">
                <div style="min-width:0">
                    @if (Numeros.Count > 0)
                    {
                        <div class="bloco">
                            <div class="numeros">
                                @foreach (var (ico, valor, rotulo) in Numeros)
                                {
                                    <div class="numero"><svg class="ico"><use href="#i-@ico" /></svg><b class="num">@valor</b><small>@rotulo</small></div>
                                }
                            </div>
                        </div>
                    }

                    @if (Paragrafos.Count > 0)
                    {
                        <div class="bloco">
                            <h2>Sobre o imóvel</h2>
                            <div class="descricao">
                                @foreach (var p in Paragrafos)
                                {
                                    if (p.Itens is { } itens)
                                    {
                                        <ul class="carac">
                                            @foreach (var it in itens)
                                            {
                                                <li><svg class="ico"><use href="#i-ok" /></svg>@it</li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p>@p.Texto</p>
                                    }
                                }
                            </div>
                        </div>
                    }

                    @if (Grupos.Count > 0)
                    {
                        <div class="bloco">
                            <h2>Características</h2>
                            @foreach (var g in Grupos)
                            {
                                <div class="grupo">
                                    @if (Grupos.Count > 1 || g.Key is not null)
                                    {
                                        <h3>@(g.Key ?? "Outras")</h3>
                                    }
                                    <ul class="carac">
                                        @foreach (var c in g)
                                        {
                                            <li><svg class="ico"><use href="#i-ok" /></svg>@(c.Valor is null ? c.Chave : $"{c.Chave}: {c.Valor}")</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }

                    @if (Quadro is not null)
                    {
                        <QuadroLotesSite Quadro="Quadro" Links="true" />
                    }

                    @if (Dados.Count > 0)
                    {
                        <div class="bloco">
                            <h2>Ficha técnica</h2>
                            <dl class="ficha-dados">
                                @foreach (var (rotulo, valor) in Dados)
                                {
                                    <div><dt>@rotulo</dt><dd>@valor</dd></div>
                                }
                            </dl>
                        </div>
                    }

                    @if (YoutubeId is not null || Videos.Count > 0)
                    {
                        <div class="bloco">
                            <h2>Vídeo do imóvel</h2>
                            @if (YoutubeId is not null)
                            {
                                <div class="video-quadro">
                                    <iframe src="https://www.youtube-nocookie.com/embed/@YoutubeId" title="Vídeo do imóvel" loading="lazy"
                                            allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen></iframe>
                                </div>
                            }
                            @foreach (var v in Videos)
                            {
                                <div class="video-quadro"><video src="@v" controls preload="metadata" style="width:100%;height:100%"></video></div>
                            }
                        </div>
                    }

                    @if (ConsultaMapa is not null)
                    {
                        <div class="bloco">
                            <h2>Localização</h2>
                            <div class="mapa-quadro">
                                @* fachada: o mapa do Google (~330 KB de scripts de terceiros) só carrega quando a seção chega perto
                                   da tela ou no clique (web.dev/articles/third-party-facades) *@
                                <button type="button" class="mapa-fachada" data-mapa="https://www.google.com/maps?q=@ConsultaMapa&t=k&z=@(Im.EnderecoPublico ? 17 : 13)&output=embed">
                                    <svg class="ico"><use href="#i-mapa" /></svg> Ver no mapa
                                </button>
                                <script>
                                    // carrega sozinho quando a seção chega perto da tela; o clique continua valendo
                                    document.querySelectorAll("[data-mapa]").forEach(b => {
                                        const abrir = foco => {
                                            if (!b.isConnected) return;
                                            const f = document.createElement("iframe");
                                            f.src = b.dataset.mapa; f.title = "Mapa da localização"; f.referrerPolicy = "no-referrer-when-downgrade";
                                            b.replaceWith(f); if (foco) f.focus();
                                        };
                                        b.addEventListener("click", () => abrir(true), { once: true });
                                        if ("IntersectionObserver" in window)
                                            new IntersectionObserver((es, o) => { if (es.some(e => e.isIntersecting)) { o.disconnect(); abrir(false); } },
                                                { rootMargin: "300px" }).observe(b);
                                    });
                                </script>
                            </div>
                            @if (Im.EnderecoPublico)
                            {
                                <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
                                    <span>@EnderecoCompleto</span>
                                    @if (LinkMapa is not null)
                                    {
                                        <a class="btn btn-linha" href="@LinkMapa" target="_blank" rel="noopener"><svg class="ico"><use href="#i-mapa" /></svg> Abrir no Google Maps</a>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="mudo" style="font-size:.85rem">Mostramos a região aproximada. O endereço exato é informado no atendimento.</p>
                            }
                        </div>
                    }
                </div>

                <aside class="contato" aria-label="Fale com a Inovabens">
                    <div>
                        <span class="mudo" style="font-size:.82rem">@(Locacao ? "Aluguel" : APartir ? "Lotes a partir de" : "Valor de venda")</span>
                        <div class="preco num">@PrecoTexto</div>
                        @if (Custos.Count > 0)
                        {
                            <div class="mudo num" style="font-size:.84rem">@string.Join(" · ", Custos)</div>
                        }
                    </div>
                    @if (Selos.Count > 0)
                    {
                        <div class="selos">
                            @foreach (var s in Selos)
                            {
                                <span class="selo">@s</span>
                            }
                        </div>
                    }
                    <div class="corretor">
                        <span class="avatar">@Iniciais</span>
                        <div><b>@(CorretorNome ?? "Equipe Inovabens")</b><div class="mudo" style="font-size:.82rem">Inovabens · CRECI 50457-J</div></div>
                    </div>
                    <a class="btn btn-zap" href="@LinkWhatsapp" target="_blank" rel="noopener" style="width:100%"><svg class="ico"><use href="#i-zap" /></svg> Conversar no WhatsApp</a>
                    @if (Simulador is not null)
                    {
                        <a class="btn btn-linha" href="site/imovel/@Im.Id/simulador" target="_blank" rel="noopener" style="width:100%"><svg class="ico"><use href="#i-calc" /></svg> Simular financiamento</a>
                    }
                </aside>
            </div>
        </main>
        }
    </ChildContent>
    <Scripts>
        @if (Fotos.Count > 0)
        {
            <dialog class="luz" id="luz" aria-label="Fotos do imóvel">
                <div class="luz-topo"><span class="num" id="luzConta"></span><button type="button" class="btn-ico" id="luzFechar" aria-label="Fechar">✕</button></div>
                <div class="luz-palco">
                    <button type="button" class="luz-nav ant" id="luzAnt" aria-label="Foto anterior">‹</button>
                    <img id="luzFoto" alt="" />
                    <button type="button" class="luz-nav prox" id="luzProx" aria-label="Próxima foto">›</button>
                </div>
                <div class="luz-legenda" id="luzLegenda"></div>
            </dialog>
            <script id="fotos-dados" type="application/json">@((MarkupString)FotosJson)</script>
            <script>
                (() => {
                    const fotos = JSON.parse(document.getElementById("fotos-dados").textContent);
                    const luz = document.getElementById("luz"), img = document.getElementById("luzFoto");
                    let atual = 0;
                    const mostrar = k => {
                        atual = (k + fotos.length) % fotos.length;
                        img.src = fotos[atual].src;
                        img.alt = fotos[atual].legenda || "";
                        document.getElementById("luzLegenda").textContent = fotos[atual].legenda || "";
                        document.getElementById("luzConta").textContent = `${atual + 1} / ${fotos.length}`;
                        new Image().src = fotos[(atual + 1) % fotos.length].src;
                    };
                    document.querySelectorAll("[data-luz]").forEach(b => b.addEventListener("click", () => { mostrar(+b.dataset.luz); luz.showModal(); }));
                    document.getElementById("luzAnt").onclick = () => mostrar(atual - 1);
                    document.getElementById("luzProx").onclick = () => mostrar(atual + 1);
                    document.getElementById("luzFechar").onclick = () => luz.close();
                    luz.addEventListener("keydown", e => { if (e.key === "ArrowLeft") mostrar(atual - 1); if (e.key === "ArrowRight") mostrar(atual + 1); });
                    let x0 = null;
                    luz.addEventListener("touchstart", e => x0 = e.touches[0].clientX, { passive: true });
                    luz.addEventListener("touchend", e => { if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) mostrar(atual + (dx < 0 ? 1 : -1)); x0 = null; });
                })();
            </script>
        }
        @if (SoSimulador && Simulador is not null)
        {
            <script src="site-simulador.js"></script>
        }
    </Scripts>
</SiteMoldura>

@inject InovabensOpcoes Op
@code {
    [Parameter, EditorRequired] public ImovelDetalhe Detalhe { get; set; } = default!;
    [Parameter] public string? LinkImobibrasil { get; set; }
    /// <summary>Página só do simulador de financiamento (site/imovel/{id}/simulador), aberta em nova aba pelo botão da ficha.</summary>
    [Parameter] public bool SoSimulador { get; set; }
    /// <summary>Taxas dos bancos do comparativo (só na página do simulador).</summary>
    [Parameter] public IReadOnlyList<TaxaBanco>? Taxas { get; set; }
    /// <summary>Empreendimento em lotes: quadro dos lotes e preço "a partir de" (o lote disponível mais barato).</summary>
    [Parameter] public QuadroLotes? Quadro { get; set; }
    [CascadingParameter] public HttpContext? Http { get; set; }
    private bool Logado => Http?.User.Identity?.IsAuthenticated == true;

    /// <param name="Src">Foto para exibir grande (1200 px).</param>
    /// <param name="Pequena">Versão reduzida (400 px): fundos desfocados, miniaturas e telas pequenas.</param>
    /// <param name="Media">Versão de 800 px: a foto principal no celular (tela de ~400 px com densidade 2) sem baixar a de 1200.</param>
    private sealed record FotoSite(string Src, string Pequena, string? Media, string? Legenda)
    {
        public string Srcset => Pequena == Src ? Src
            : Media is null ? $"{Pequena} 400w, {Src} 1200w" : $"{Pequena} 400w, {Media} 800w, {Src} 1200w";
    }
    private sealed record Paragrafo(string? Texto, IReadOnlyList<string>? Itens);

    private static readonly CultureInfo Br = Texto.PtBr;

    private Imovel Im => Detalhe.Dados;
    private bool Locacao => Im.Finalidade == FinalidadeImovel.LOCACAO;
    private string Codigo => Im.Referencia ?? Im.Codigo;
    private string? CorretorNome => Detalhe.CorretorNome;
    private string TipoRotulo => Im.Subtipo ?? Texto.Rotulo(Im.Tipo);
    private bool Rural => Im.Tipo is "fazenda/sítio" or "Chácara" || (Im.Zona?.Contains("rural", StringComparison.OrdinalIgnoreCase) ?? false);

    private List<FotoSite> Fotos = [];
    private List<string> Videos = [];
    private List<Paragrafo> Paragrafos = [];
    private List<IGrouping<string?, ImovelCaracteristica>> Grupos = [];
    private List<(string Ico, string Valor, string Rotulo)> Numeros = [];
    private List<(string Rotulo, string Valor)> Dados = [];
    private List<string> Custos = [];
    private List<string> Selos = [];
    private string FotosJson = "[]";

    private string Onde => $"{(Im.Bairro is { } b ? b + ", " : "")}{Im.Cidade}{(Im.Uf is { } uf ? " - " + uf : "")}";

    private string? EnderecoCompleto => RegrasImovel.EnderecoParaMapa(Im.Logradouro, Im.Numero, Im.Bairro, Im.Cidade, Im.Uf, null)?.Replace(", Brasil", "");

    /// <summary>
    /// Site público. Endereço público: o ponto cadastrado (coordenadas têm prioridade sobre o endereço). Endereço não
    /// público: só bairro e cidade, nunca o ponto exato — a localização exata é só para usuários do sistema.
    /// </summary>
    private string? ConsultaMapa => Im.EnderecoPublico
        ? RegrasImovel.ConsultaMapa(Im.Latitude, Im.Longitude, EnderecoCompleto)
        : RegrasImovel.ConsultaMapa(null, null, RegrasImovel.EnderecoParaMapa(null, null, Im.Bairro, Im.Cidade, Im.Uf, null));

    private string? LinkMapa => RegrasImovel.LinkGoogleMaps(Im.Latitude, Im.Longitude, EnderecoCompleto);

    private string? YoutubeId => RegrasImovel.IdYoutube(Im.VideoUrl);

    private bool APartir => !Locacao && Quadro?.APartirDe is not null;
    private decimal? Preco => Locacao ? Im.PrecoLocacao : Quadro?.APartirDe ?? Im.PrecoVenda ?? Im.PrecoLocacao;
    private string PrecoTexto => Preco is { } p ? (APartir ? "A partir de " : "") + p.ToString("C0", Br) + (Locacao ? "/mês" : "") : "Consulte";

    private string Iniciais => CorretorNome is { } n
        ? string.Concat(n.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])))
        : "IB";

    private string MensagemWhatsapp => $"Olá! Tenho interesse no imóvel {Codigo} ({Im.Titulo}). Pode me passar mais informações?";
    private string LinkWhatsapp => $"https://wa.me/{SiteMoldura.Whatsapp}?text=" + Uri.EscapeDataString(MensagemWhatsapp);
    /// <summary>Meta description: o que é, onde, números principais e preço; depois o começo do texto do anúncio.</summary>
    private string DescricaoMeta => DadosSite.Resumo(string.Join(". ", new[]
    {
        $"{TipoRotulo} {(Locacao ? "para alugar" : "à venda")}{(Onde.Length > 0 ? " em " + Onde : "")}",
        string.Join(", ", Numeros.Take(3).Select(n => $"{n.Rotulo.ToLowerInvariant()} {n.Valor}")),
        PrecoTexto == "Consulte" ? "" : PrecoTexto,
        Texto.Limpo(Im.DescricaoPublica) ?? "",
    }.Where(x => x.Length > 0)));

    private IReadOnlyList<string> Trilha =>
    [
        DadosSite.Trilha(Op, ("Início", "site"), (Locacao ? "Alugar" : "Comprar", LinkLista), (Im.Titulo, $"site/imovel/{Im.Id}")),
    ];

    private string LinkLista => $"site/imoveis?finalidade={(Locacao ? "locacao" : "venda")}";

    /* ------- simulador de financiamento (regras em FinanciamentoCaixa, bancos e MCMV em ComparadorFinanciamento) ------- */

    /// <summary>Primeira simulação, feita no servidor com a taxa da Caixa (SAC, 20% de entrada, prazo máximo); o script recalcula ao mudar os campos.</summary>
    private SimulacaoFinanciamento? Simulador;
    private TaxaBanco? Caixa;
    private string ParametrosSimulador = "{}";

    private static string Brl(decimal v) => v.ToString("C2", Br);
    private static string Brl0(decimal v) => v.ToString("C0", Br);
    private static string Brl2(decimal v) => v.ToString("N2", Br);
    private static string Pct(decimal v) => (v * 100).ToString("0.##", Br) + "%";
    private static string Num(decimal v, string formato = "0") => v.ToString(formato, CultureInfo.InvariantCulture);
    private static string PrazoTexto(int meses) => $"{meses / 12} anos{(meses % 12 > 0 ? $" e {meses % 12} meses" : "")} ({meses} meses)";
    private static string Mes(DateOnly? d) => d is { } m ? m.ToString("MMM'/'yyyy", Br).Replace(".", "") : "mês de referência";

    protected override void OnParametersSet()
    {
        var midias = Detalhe.Midias.Where(m => m.Midia.Publica && m.Url is not null)
            .OrderByDescending(m => m.Midia.Capa).ThenBy(m => m.Midia.Ordem).ToList();
        Fotos = [.. midias.Where(m => m.Midia.Tipo == TipoMidia.FOTO).Select(m => new FotoSite(m.Tela ?? m.Url!, m.Miniatura ?? m.Tela ?? m.Url!, m.Media, m.Midia.Legenda))];
        Videos = [.. midias.Where(m => m.Midia.Tipo == TipoMidia.VIDEO).Select(m => m.Url!)];
        FotosJson = System.Text.Json.JsonSerializer.Serialize(Fotos.Select(f => new { src = f.Src, legenda = f.Legenda }))
            .Replace("<", "\\u003c"); // dentro de <script>: nunca fecha a tag

        Paragrafos = [];
        List<string>? lista = null;
        foreach (var linha in (Im.DescricaoPublica ?? "").Split('\n').Select(l => l.Trim()))
        {
            // itens de lista: "- item" (importação) ou "• item" (texto colado do anúncio)
            if (linha.StartsWith("- ", StringComparison.Ordinal) || linha.StartsWith('•')) { (lista ??= []).Add(linha.TrimStart('-', '•', ' ').Trim()); continue; }
            if (lista is not null) { Paragrafos.Add(new(null, lista)); lista = null; }
            if (linha.Length > 0) Paragrafos.Add(new(linha, null));
        }
        if (lista is not null) Paragrafos.Add(new(null, lista));

        Grupos = [.. Detalhe.Caracteristicas.Where(c => c.Publico)
            .GroupBy(c => c.Grupo)
            .OrderBy(g => g.Key is null ? 99 : (RegrasImovel.GruposCaracteristicas.ToList().IndexOf(g.Key) is var i and >= 0 ? i : 50))];

        Numeros = [];
        var terreno = Im.AreaTerrenoM2 ?? (Rural ? Im.AreaTotalM2 : null);
        if (terreno is { } t) Numeros.Add(("area", Area(t), Rural || t >= 10_000 ? "Área do terreno" : "Terreno"));
        if ((Im.AreaConstruidaM2 ?? Im.AreaUtilM2 ?? (terreno is null ? Im.AreaTotalM2 : null)) is { } a)
            Numeros.Add(("area", Area(a), Im.AreaConstruidaM2 is not null ? "Área construída" : Im.AreaUtilM2 is not null ? "Área útil" : "Área total"));
        if (Im.Quartos is > 0 and var q) Numeros.Add(("cama", q.ToString(), q > 1 ? "Quartos" : "Quarto"));
        if (Im.Suites is > 0 and var s) Numeros.Add(("suite", s.ToString(), s > 1 ? "Suítes" : "Suíte"));
        if (Im.Banheiros is > 0 and var b) Numeros.Add(("banho", b.ToString(), b > 1 ? "Banheiros" : "Banheiro"));
        if (Im.Salas is > 0 and var sl) Numeros.Add(("sala", sl.ToString(), sl > 1 ? "Salas" : "Sala"));
        if (Im.Vagas is > 0 and var v) Numeros.Add(("carro", v.ToString(), v > 1 ? "Vagas" : "Vaga"));

        Dados = [];
        void D(string rotulo, string? valor) { if (!string.IsNullOrWhiteSpace(valor)) Dados.Add((rotulo, valor)); }
        D("Referência", Codigo);
        D("Tipo", TipoRotulo);
        D("Área total", M2(Im.AreaTotalM2));
        D("Área construída", M2(Im.AreaConstruidaM2));
        D("Área útil", M2(Im.AreaUtilM2));
        D("Área do terreno", M2(Im.AreaTerrenoM2));
        D("Frente", Metros(Im.TerrenoFrenteM));
        D("Fundo", Metros(Im.TerrenoFundoM));
        D("Lado esquerdo", Metros(Im.TerrenoEsquerdaM));
        D("Lado direito", Metros(Im.TerrenoDireitaM));
        D("Pavimento", Im.Pavimento);
        D("Ano de construção", Im.AnoConstrucao?.ToString());
        D("Região", Im.Regiao);
        if (Im.EnderecoPublico) D("Ponto de referência", Im.PontoReferencia);
        if (!Locacao && Im.PrecoVenda is { } pv && (Im.AreaConstruidaM2 ?? Im.AreaTerrenoM2 ?? Im.AreaTotalM2) is { } base_ and > 0)
            D("Valor por m²", (pv / base_).ToString("C0", Br));

        Custos = [];
        if (Im.ValorCondominio is { } cond) Custos.Add($"Condomínio {cond.ToString("C0", Br)}");
        if (Im.ValorIptu is { } iptu) Custos.Add($"IPTU {iptu.ToString("C0", Br)}");

        Simulador = null;
        // a ficha (sem as taxas gravadas) usa as de referência só para decidir se mostra o botão do simulador
        var taxas = Taxas is { Count: > 0 } ? Taxas : ComparadorFinanciamento.TaxasDeReferencia();
        Caixa = taxas.FirstOrDefault(t => t.Banco.Codigo == "caixa");
        if (!Locacao && Im.PrecoVenda is { } venda and > 0 && Caixa is { } cx)
        {
            Simulador = FinanciamentoCaixa.Simular(venda, FinanciamentoCaixa.EntradaPadraoDe(venda), FinanciamentoCaixa.PrazoMaximo,
                ComparadorFinanciamento.NominalDeEfetiva(cx.TaxaAno), sac: true);
            ParametrosSimulador = System.Text.Json.JsonSerializer.Serialize(new
            {
                cotaSac = FinanciamentoCaixa.CotaSac, cotaPrice = FinanciamentoCaixa.CotaPrice,
                entradaPadrao = FinanciamentoCaixa.EntradaPadrao,
                prazoMax = FinanciamentoCaixa.PrazoMaximo, idadeMaxMeses = FinanciamentoCaixa.IdadeMaximaMeses,
                comprometimento = FinanciamentoCaixa.ComprometimentoRenda,
                padrao = "caixa",
                bancos = taxas.Select(t => new
                {
                    codigo = t.Banco.Codigo, nome = t.Banco.Nome, sigla = t.Banco.Sigla, cor = t.Banco.Cor, corTexto = t.Banco.CorTexto,
                    link = t.Banco.LinkSimulacao, cooperativa = t.Banco.Cooperativa, logo = t.Banco.Logo,
                    taxaAno = t.TaxaAno, nominal = ComparadorFinanciamento.NominalDeEfetiva(t.TaxaAno), mes = Mes(t.Competencia),
                }),
                mcmv = new
                {
                    link = ComparadorFinanciamento.McmvLink, logo = ComparadorFinanciamento.McmvLogo,
                    faixas = ComparadorFinanciamento.FaixasMcmv.Select(f => new { numero = f.Numero, renda = f.RendaMaxima, teto = f.TetoImovel, min = f.TaxaMinima, max = f.TaxaMaxima }),
                },
            }).Replace("<", "\\u003c"); // dentro de <script>: nunca fecha a tag
        }

        Selos = [];
        if (Im.AceitaPermuta) Selos.Add("Aceita permuta");
        if (Im.EmCondominio) Selos.Add("Em condomínio");
        if (Rural) Selos.Add("Zona rural");
    }

    private static string? M2(decimal? v) => v is { } x ? Area(x) : null;

    /// <summary>Áreas grandes também em hectares ("30.417 m² · 3,04 ha").</summary>
    private static string Area(decimal m2) =>
        m2 >= 10_000 ? $"{m2.ToString("N0", Br)} m² · {(m2 / 10_000).ToString("0.##", Br)} ha" : $"{m2.ToString(m2 % 1 == 0 ? "N0" : "N2", Br)} m²";

    private static string? Metros(decimal? v) => v is { } x ? $"{x.ToString(x % 1 == 0 ? "N0" : "N2", Br)} m" : null;
}
