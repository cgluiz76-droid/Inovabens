@* Moldura das páginas da pré-visualização do site público: cabeçalho (logo e menu com links), faixa de aviso e rodapé.
   Todas as páginas do site (início, busca e ficha) usam esta moldura, então os atalhos ficam iguais em todas. *@

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#03075f" />
    <title>@Titulo · Inovabens (pré-visualização)</title>
    <link rel="icon" type="image/svg+xml" href="img/marca.svg" />
    <link rel="stylesheet" href="site-previa.css" />
</head>
<body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <symbol id="i-cama" viewBox="0 0 24 24"><path d="M3 18v-7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v7M3 14h18M3 18v2M21 18v2M7 9V6h10v3" /></symbol>
        <symbol id="i-carro" viewBox="0 0 24 24"><path d="M5 16V11l2-5h10l2 5v5M3 16h18v3h-3v-1.5H6V19H3zM7.5 13.5h.01M16.5 13.5h.01" /></symbol>
        <symbol id="i-area" viewBox="0 0 24 24"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></symbol>
        <symbol id="i-banho" viewBox="0 0 24 24"><path d="M4 12h16v3a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5zM6 12V6a2 2 0 0 1 4 0M7 20l-1 2M17 20l1 2" /></symbol>
        <symbol id="i-suite" viewBox="0 0 24 24"><path d="M4 20V10l8-6 8 6v10M9 20v-6h6v6" /></symbol>
        <symbol id="i-pino" viewBox="0 0 24 24"><path d="M12 21s-6-5.3-6-11a6 6 0 0 1 12 0c0 5.7-6 11-6 11z" /><circle cx="12" cy="10" r="2.2" /></symbol>
        <symbol id="i-zap" viewBox="0 0 24 24"><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19z" /><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.6-1.8-.9-.9.9a4 4 0 0 1-2.2-2.2l.9-.9-.9-1.8z" /></symbol>
        <symbol id="i-mapa" viewBox="0 0 24 24"><path d="M9 4L3 6v14l6-2 6 2 6-2V4l-6 2zM9 4v14M15 6v14" /></symbol>
        <symbol id="i-ok" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></symbol>
        <symbol id="i-fotos" viewBox="0 0 24 24"><rect x="3" y="5" width="14" height="12" rx="2" /><path d="M7 21h12a2 2 0 0 0 2-2V9" /><path d="M3 14l4-4 4 4 2-2 4 4" /></symbol>
        <symbol id="i-sala" viewBox="0 0 24 24"><path d="M4 18v-5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v5M3 18h18M7 11V8a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v3" /></symbol>
        <symbol id="i-calc" viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M8 7h8M8 11h.01M12 11h.01M16 11h.01M8 15h.01M12 15h.01M16 15h.01M8 18h.01M12 18h4" /></symbol>
    </svg>

    <div class="previa-faixa">
        <div class="miolo">
            <span>
                <b>Pré-visualização do site</b> ·
                @if (Faixa is null) { <span>é assim que o site público mostra os imóveis divulgados.</span> } else { @Faixa }
            </span>
            <span>
                @if (FaixaLinks is not null) { @FaixaLinks <span> · </span> }
                <a href="imoveis">← Voltar ao sistema</a>
            </span>
        </div>
    </div>

    <header class="topo">
        <div class="miolo">
            <a class="marca" href="site" aria-label="Inovabens: página inicial">
                <img src="img/marca.svg" alt="" />
                <span class="marca-txt"><b>INOVA<span>BENS</span></b><small>GESTÃO PATRIMONIAL</small></span>
            </a>
            <nav class="nav" aria-label="Principal">
                <a href="site/imoveis?finalidade=venda" aria-current="@(Ativo == "venda" ? "page" : null)">Comprar</a>
                <a href="site/imoveis?finalidade=locacao" aria-current="@(Ativo == "locacao" ? "page" : null)">Alugar</a>
                <a href="site#anunciar">Anunciar</a>
                <a href="site#sobre">Sobre</a>
            </nav>
            <a class="btn btn-zap" href="@LinkWhatsapp" target="_blank" rel="noopener"><svg class="ico"><use href="#i-zap" /></svg> <span>WhatsApp</span></a>
        </div>
    </header>

    @ChildContent

    <footer class="rodape">
        <div class="miolo">
            <div class="rodape-col">
                <a class="marca marca-rodape" href="site" aria-label="Inovabens: página inicial">
                    <img src="img/marca.svg" alt="" />
                    <span class="marca-txt"><b>INOVA<span>BENS</span></b><small>GESTÃO PATRIMONIAL</small></span>
                </a>
                <span>Inova Bens Gestão Patrimonial · CRECI 50457-J</span>
            </div>
            <nav class="rodape-col" aria-label="Atalhos">
                <b>Imóveis</b>
                <a href="site/imoveis?finalidade=venda">Imóveis à venda</a>
                <a href="site/imoveis?finalidade=locacao">Imóveis para alugar</a>
                <a href="site#anunciar">Anunciar meu imóvel</a>
            </nav>
            <div class="rodape-col">
                <b>Fale com a gente</b>
                <a href="@LinkWhatsapp" target="_blank" rel="noopener">WhatsApp @TelefoneTexto</a>
                <span>Av. Pres. Juscelino K. de Oliveira, 391 · Jardim Panorama · São José do Rio Preto - SP</span>
            </div>
        </div>
    </footer>

    @Scripts
</body>
</html>

@code {
    /// <summary>WhatsApp e telefone do site atual da Inovabens.</summary>
    public const string Whatsapp = "5517981850171";
    public const string TelefoneTexto = "(17) 98185-0171";

    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    /// <summary>Item do menu em destaque: "venda" ou "locacao".</summary>
    [Parameter] public string? Ativo { get; set; }
    /// <summary>Texto da faixa de pré-visualização (avisos da página).</summary>
    [Parameter] public RenderFragment? Faixa { get; set; }
    [Parameter] public RenderFragment? FaixaLinks { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Scripts { get; set; }
    /// <summary>Mensagem pronta do WhatsApp (por exemplo, com o código do imóvel).</summary>
    [Parameter] public string MensagemWhatsapp { get; set; } = "Olá! Vim pelo site da Inovabens e gostaria de falar sobre imóveis.";

    private string LinkWhatsapp => $"https://wa.me/{Whatsapp}?text=" + Uri.EscapeDataString(MensagemWhatsapp);
}
