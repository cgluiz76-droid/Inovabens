@* Mapa de imóveis em tela cheia (menu Imóveis → Mapa), desenhado por wwwroot/mapa-imoveis.js (MapLibre GL).
   Recebe os imóveis já filtrados pela página; os filtros ficam na barra do topo; ✕ ou Esc fecha.
   Clicar num alfinete abre a página do imóvel no site. Sem filtro ativo, abre em Rio Preto (raio de 20 km). *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="mapa-tela-cheia" role="dialog" aria-modal="true" aria-label="Mapa de imóveis">
    <header class="mapa-topo">
        <div class="mapa-marca">
            <b>Mapa de imóveis</b>
            <span>
                @ComLocal @(ComLocal == 1 ? "imóvel" : "imóveis") no mapa
                @if (naArea is { } n && n != ComLocal)
                {
                    <text> · @n nesta área</text>
                }
            </span>
        </div>
        <div class="mapa-filtros">@Filtros</div>
        <div class="mapa-bases" role="group" aria-label="Tipo de mapa">
            <button class="@(baseAtual == "satelite" ? "ativa" : "")" @onclick='() => TrocarBase("satelite")'>Satélite</button>
            <button class="@(baseAtual == "ruas" ? "ativa" : "")" @onclick='() => TrocarBase("ruas")'>Ruas</button>
        </div>
        <button class="mapa-fechar" title="Fechar o mapa (Esc)" aria-label="Fechar o mapa" @onclick="AoFechar"><Icone Nome="x" /></button>
    </header>

    <div class="mapa-area" @ref="elemento"></div>

    <div class="mapa-legenda">
        <span><i class="cor-disponivel"></i>Disponível</span>
        <span><i class="cor-preparo"></i>Em preparo</span>
        <span><i class="cor-encerrado"></i>Vendido / locado</span>
    </div>

    @if (SemLocal.Count > 0)
    {
        <details class="mapa-sem-local">
            <summary>⚠ @SemLocal.Count sem localização</summary>
            <ul>
                @foreach (var i in SemLocal)
                {
                    <li><a href="imoveis/@i.Id">@(i.Referencia ?? i.Codigo)</a> <span>@i.Titulo</span></li>
                }
            </ul>
        </details>
    }
    @if (erro is not null)
    {
        <div class="mapa-erro"><MensagemErro Texto="@erro" /></div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ImovelMapaItem> Itens { get; set; } = [];
    /// <summary>Algum filtro diferente do padrão: enquadra os resultados; senão, Rio Preto com raio de 20 km.</summary>
    [Parameter] public bool FiltroAtivo { get; set; }
    [Parameter] public RenderFragment? Filtros { get; set; }
    [Parameter] public EventCallback AoFechar { get; set; }

    private ElementReference elemento;
    private IJSObjectReference? modulo;
    private DotNetObjectReference<MapaImoveis>? referencia;
    private IReadOnlyList<ImovelMapaItem>? desenhados;
    private int? naArea;
    private string baseAtual = "satelite";
    private string? erro;

    private int ComLocal => Itens.Count(TemLocal);
    private List<ImovelMapaItem> SemLocal => [.. Itens.Where(i => !TemLocal(i))];
    private static bool TemLocal(ImovelMapaItem i) => i.Latitude is not null && i.Longitude is not null;

    protected override async Task OnAfterRenderAsync(bool primeira)
    {
        try
        {
            if (primeira)
            {
                modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./mapa-imoveis.js");
                referencia = DotNetObjectReference.Create(this);
                await modulo.InvokeVoidAsync("iniciar", elemento, referencia);
            }
            if (modulo is not null && !ReferenceEquals(desenhados, Itens))
            {
                desenhados = Itens;
                await modulo.InvokeVoidAsync("desenhar", elemento, Itens.Where(TemLocal).Select(Alfinete), !FiltroAtivo);
            }
        }
        catch (JSDisconnectedException) { }
        catch (JSException ex)
        {
            erro = ex.Message;
            StateHasChanged();
        }
    }

    private static object Alfinete(ImovelMapaItem i)
    {
        var preco = i.PrecoVenda ?? i.PrecoLocacao;
        return new
        {
            id = i.Id,
            rotulo = i.Referencia ?? i.Codigo,
            titulo = i.Titulo,
            lat = i.Latitude,
            lng = i.Longitude,
            preco,
            precoCheio = preco is null ? "Sob consulta" : Texto.Moeda(preco),
            situacao = Texto.Rotulo(i.Situacao),
            cor = i.Situacao switch
            {
                SituacaoImovel.DISPONIVEL => "disponivel",
                SituacaoImovel.VENDIDO or SituacaoImovel.LOCADO or SituacaoImovel.ARQUIVADO => "encerrado",
                _ => "preparo",
            },
            local = Local(i),
            capa = i.CapaUrl,
            site = $"imoveis/{i.Id}/site",
        };
    }

    [JSInvokable]
    public Task AreaMudou(int quantos)
    {
        naArea = quantos;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task Fechar() => InvokeAsync(() => AoFechar.InvokeAsync());

    private async Task TrocarBase(string nome)
    {
        baseAtual = nome;
        if (modulo is null) return;
        try { await modulo.InvokeVoidAsync("base", elemento, nome); } catch (JSDisconnectedException) { }
    }

    private static string Local(ImovelMapaItem i)
    {
        var cidade = i.Cidade is null ? null : i.Cidade + (i.Uf is null ? "" : "/" + i.Uf);
        var partes = new[] { i.Bairro, cidade }.Where(x => !string.IsNullOrEmpty(x));
        return partes.Any() ? string.Join(" · ", partes) : "—";
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (modulo is not null)
            {
                await modulo.InvokeVoidAsync("destruir", elemento);
                await modulo.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        referencia?.Dispose();
    }
}
