@inherits ComponenteBase
@implements IDisposable
@inject ImoveisService Servico
@inject MelhoriaFotosService Melhoria
@inject IJSRuntime JS

<section class="card">
    <h2>Fotos e documentos <span class="pequeno mudo">· @Fotos de @RegrasImovel.MaximoFotos fotos</span></h2>
    <MensagemErro Texto="@Erro" />

    @if (!Servico.ArmazenamentoHabilitado)
    {
        <p class="pequeno mudo">Envio de arquivos desligado: Google Drive não configurado (GOOGLE_DRIVE_ID e GOOGLE_DRIVE_CREDENCIAIS).</p>
    }
    else if (Detalhe.LinkDrive is { } linkDrive)
    {
        <p class="pequeno">
            <a href="@linkDrive" target="_blank" rel="noreferrer">📁 Abrir pasta "@Detalhe.Dados.NomeDrive" no Google Drive ↗</a>
        </p>
    }
    else if (Editar)
    {
        <p class="pequeno mudo">
            A pasta deste imóvel ainda não existe no Google Drive.
            <button class="btn-ghost mini" disabled="@Ocupado" @onclick="CriarPastas">Criar pastas no Drive</button>
        </p>
    }

    <div class="midias">
        @foreach (var m in midias)
        {
            <div class="midia">
                @if (m.Url is not null && m.Midia.Tipo == TipoMidia.FOTO)
                {
                    <img src="@m.Url" alt="@(m.Midia.Legenda ?? "")" />
                }
                else
                {
                    <a class="midia-arquivo" href="@(m.Url ?? "#")" target="_blank" rel="noreferrer">@Texto.Rotulo(m.Midia.Tipo)</a>
                }
                <p class="pequeno truncar" title="@m.Midia.NomeOriginal">@(m.Midia.Legenda ?? m.Midia.NomeOriginal)@(m.Midia.Capa ? " · capa" : "")</p>
                @if (m.NomeSubpasta is { } sub)
                {
                    <p class="pequeno mudo truncar">📁 @sub</p>
                }
                @switch (m.Midia.MelhoriaStatus)
                {
                    case StatusMelhoria.PENDENTE or StatusMelhoria.PROCESSANDO:
                        <p class="pequeno melhoria">✨ Melhorando no Magnific…</p>
                        break;
                    case StatusMelhoria.CONCLUIDA:
                        <p class="pequeno melhoria">✨ Melhorada pelo Magnific</p>
                        break;
                    case StatusMelhoria.FALHA:
                        <p class="pequeno texto-erro" title="@m.Midia.MelhoriaErro">Melhoria falhou</p>
                        break;
                }
                @if (m.Midia.Tipo == TipoMidia.FOTO)
                {
                    @switch (m.Publicacao)
                    {
                        case SituacaoPublicacao.Privada:
                            <p class="pequeno mudo">🔒 Só no Drive</p>
                            break;
                        case SituacaoPublicacao.Pendente:
                            <p class="pequeno publicacao">🌐 @(Servico.PublicacaoHabilitada ? "Publicando no site…" : "Pública (aguardando R2)")</p>
                            break;
                        case SituacaoPublicacao.Publicada when m.UrlPublica is { } urlPublica:
                            <p class="pequeno publicacao"><a href="@urlPublica" target="_blank" rel="noreferrer">🌐 No site ↗</a></p>
                            break;
                        case SituacaoPublicacao.Publicada:
                            <p class="pequeno publicacao">🌐 No site</p>
                            break;
                        case SituacaoPublicacao.Falha:
                            <p class="pequeno texto-erro" title="@m.Midia.PublicacaoErro">Não publicada: @m.Midia.PublicacaoErro</p>
                            break;
                    }
                }
                @if (Editar)
                {
                    <div class="acoes-midia">
                        @if (m.Midia.Tipo == TipoMidia.FOTO && !m.Midia.Capa)
                        {
                            <button class="btn-ghost mini" disabled="@Ocupado" @onclick="() => DefinirCapa(m.Midia.Id)">Capa</button>
                        }
                        @if (m.Midia.Tipo == TipoMidia.FOTO)
                        {
                            <button class="btn-ghost mini" disabled="@Ocupado"
                                    title="@(m.Midia.Publica ? "Retira a foto do site (continua no Drive)" : "Publica a foto no site e nos portais")"
                                    @onclick="() => AlternarPublica(m.Midia)">@(m.Midia.Publica ? "Tornar privada" : "Tornar pública")</button>
                        }
                        @if (m.Midia.ArquivoOriginalChave is not null)
                        {
                            <button class="btn-ghost mini" disabled="@Ocupado" title="Volta a exibir a foto como foi enviada"
                                    @onclick="() => RestaurarOriginal(m.Midia.Id)">Original</button>
                        }
                        else if (Melhoria.Habilitada && m.Midia.Tipo == TipoMidia.FOTO && m.Midia.MelhoriaStatus is null or StatusMelhoria.FALHA)
                        {
                            <button class="btn-ghost mini" disabled="@Ocupado" title="Melhorar esta foto com o Magnific (consome créditos)"
                                    @onclick="() => Melhorar(m.Midia.Id)">✨ Melhorar</button>
                        }
                        <button class="btn-ghost mini" disabled="@Ocupado" @onclick="() => Remover(m.Midia.Id)">Excluir</button>
                    </div>
                }
            </div>
        }
    </div>
    @if (midias.Count == 0)
    {
        <p class="pequeno mudo">Nenhum arquivo enviado.</p>
    }

    @if (Editar && Servico.ArmazenamentoHabilitado)
    {
        <div class="envio-midias">
            <label class="campo">
                <span>Pasta de destino no Drive</span>
                <select class="input" @bind="subpasta" disabled="@Ocupado">
                    @foreach (var (numero, nome) in SubpastasDrive.Todas)
                    {
                        <option value="@numero">@nome</option>
                    }
                </select>
            </label>
            @if (subpasta == SubpastasDrive.FotosVideos)
            {
                <label class="checkbox-publica">
                    <input type="checkbox" @bind="publica" disabled="@Ocupado" />
                    <span>Fotos públicas (vão para o site e os portais)</span>
                </label>
            }
            <label class="btn-ghost enviar">
                @(Ocupado ? progresso ?? "Enviando…" : "⤒ Enviar arquivos para esta pasta")
                <InputFile OnChange="Enviar" class="oculto" disabled="@Ocupado" multiple />
            </label>
        </div>
        <p class="pequeno mudo">
            Fotos e vídeos enviados para "04 - Fotos e Vídeos" entram na galeria do imóvel; nas demais pastas, tudo é guardado como documento.
            Só as fotos marcadas como públicas ganham cópia no site; as demais ficam apenas no Google Drive.
            Até @RegrasImovel.MaximoFotos fotos por imóvel (JPG, PNG, WebP...), 25 MB por arquivo. Selecione vários de uma vez.
            @if (Melhoria.Habilitada)
            {
                <span>As fotos novas são melhoradas automaticamente pelo Magnific em alguns minutos.</span>
            }
        </p>
    }
</section>

@code {
    [Parameter, EditorRequired] public ImovelDetalhe Detalhe { get; set; } = default!;
    [Parameter] public bool Editar { get; set; }
    [Parameter] public Func<Task>? AoSalvar { get; set; }

    private const int MaximoPorEnvio = 30;

    private string? progresso;
    private int subpasta = SubpastasDrive.FotosVideos;
    private bool publica;

    private IReadOnlyList<MidiaDetalhe> midias = [];
    private CancellationTokenSource? acompanhamento;

    private int Fotos => midias.Count(m => m.Midia.Tipo == TipoMidia.FOTO);

    /// <summary>Algo muda sozinho em segundo plano: melhoria no Magnific ou publicação no R2.</summary>
    private bool EmMelhoria => midias.Any(m => m.Midia.MelhoriaStatus is StatusMelhoria.PENDENTE or StatusMelhoria.PROCESSANDO
        || Servico.PublicacaoHabilitada && (m.Midia.Tipo == TipoMidia.FOTO && m.Publicacao == SituacaoPublicacao.Pendente
                                            || m.Midia.PublicaChave is not null && !m.Midia.Publica));

    protected override void OnParametersSet()
    {
        midias = Detalhe.Midias;
        Acompanhar();
    }

    /// <summary>Enquanto houver foto no Magnific, recarrega só as fotos a cada 15 s (sem mexer no resto da ficha).</summary>
    private void Acompanhar()
    {
        if (!EmMelhoria || acompanhamento is not null) return;
        acompanhamento = new CancellationTokenSource();
        var ct = acompanhamento.Token;
        _ = InvokeAsync(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
            try
            {
                while (EmMelhoria && await timer.WaitForNextTickAsync(ct))
                {
                    midias = await Servico.MidiasAsync(Usuario, Detalhe.Dados.Id);
                    StateHasChanged();
                }
            }
            catch (OperationCanceledException) { }
            catch (Exception) { /* a tela segue; o usuário pode recarregar */ }
            finally { acompanhamento = null; }
        });
    }

    private async Task Melhorar(Guid midiaId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Melhorar esta foto com o Magnific? Consome créditos da conta Magnific.")) return;
        if (!await Executar(() => Melhoria.SolicitarAsync(Usuario, midiaId))) return;
        midias = await Servico.MidiasAsync(Usuario, Detalhe.Dados.Id);
        Acompanhar();
    }

    private async Task RestaurarOriginal(Guid midiaId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Voltar para a foto original? A versão melhorada será apagada.")) return;
        if (await Executar(() => Melhoria.RestaurarOriginalAsync(Usuario, midiaId))) await Atualizar();
    }

    public void Dispose() => acompanhamento?.Cancel();

    /// <summary>Envia os arquivos um a um; para no primeiro erro (ex.: limite de fotos) e mostra o que já foi.</summary>
    private async Task Enviar(InputFileChangeEventArgs e)
    {
        if (e.FileCount > MaximoPorEnvio)
        {
            Erro = $"Selecione no máximo {MaximoPorEnvio} arquivos por vez.";
            return;
        }
        var arquivos = e.GetMultipleFiles(MaximoPorEnvio);
        var grandes = arquivos.Where(f => f.Size > ImoveisService.TamanhoMaximoArquivo).Select(f => f.Name).ToList();
        if (grandes.Count > 0)
        {
            Erro = "Arquivo maior que 25 MB: " + string.Join(", ", grandes);
            return;
        }
        var fotosNovas = arquivos.Count(f => SubpastasDrive.TipoNaPasta(subpasta, RegrasImovel.ArquivoSeguro(f.Name, f.ContentType).Tipo) == TipoMidia.FOTO);
        if (Fotos + fotosNovas > RegrasImovel.MaximoFotos)
        {
            Erro = $"O imóvel já tem {Fotos} foto(s); o limite é {RegrasImovel.MaximoFotos}. Selecione no máximo {Math.Max(0, RegrasImovel.MaximoFotos - Fotos)}.";
            return;
        }

        var enviados = 0;
        await Executar(async () =>
        {
            foreach (var f in arquivos)
            {
                progresso = $"Enviando {enviados + 1} de {arquivos.Count}…";
                StateHasChanged();
                await using var origem = f.OpenReadStream(ImoveisService.TamanhoMaximoArquivo);
                using var buffer = new MemoryStream();
                await origem.CopyToAsync(buffer);
                buffer.Position = 0;
                await Servico.EnviarMidiaAsync(Usuario, Detalhe.Dados.Id, buffer, f.Name,
                    string.IsNullOrEmpty(f.ContentType) ? "application/octet-stream" : f.ContentType, subpasta,
                    publica && subpasta == SubpastasDrive.FotosVideos);
                enviados++;
            }
        });
        progresso = null;
        if (enviados > 0) await Atualizar();
    }

    private async Task CriarPastas()
    {
        if (await Executar(() => Servico.CriarPastasDriveAsync(Usuario, Detalhe.Dados.Id))) await Atualizar();
    }

    private async Task DefinirCapa(Guid midiaId)
    {
        if (await Executar(() => Servico.AtualizarMidiaAsync(Usuario, midiaId, new MidiaAlteracao { Capa = true }))) await Atualizar();
    }

    private async Task AlternarPublica(ImovelMidia m)
    {
        if (!await Executar(() => Servico.AtualizarMidiaAsync(Usuario, m.Id, new MidiaAlteracao { Publica = !m.Publica }))) return;
        midias = await Servico.MidiasAsync(Usuario, Detalhe.Dados.Id);
        Acompanhar();
    }

    private async Task Remover(Guid midiaId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Excluir arquivo?")) return;
        if (await Executar(() => Servico.RemoverMidiaAsync(Usuario, midiaId))) await Atualizar();
    }

    private async Task Atualizar()
    {
        if (AoSalvar is not null) await AoSalvar();
    }
}
