        {
            filtro.Projetado = value == "projetado";
            // aberto, em atraso e previsto não existem no saldo real
            if (!filtro.Projetado && filtro.SituacaoExigeProjetado) filtro.Situacao = FiltroSituacao.TODAS;
        }
    }
    private IReadOnlyList<ContaOrcamentaria> contas = [];
    private IReadOnlyDictionary<Guid, int> contagem = new Dictionary<Guid, int>();

    private LancamentoForm? form;
    private Guid? editandoId;
    private string? numeroEditando;
    private bool deRecorrencia;
    private TituloPendente? confirmando;
    private bool liquidando;
    private ConfirmacaoPrevistoForm confirmacao = new();
    private ConfirmarExclusao confirmar = default!;

    private bool PodeEditar => Usuario.Pode(Permissoes.FinanceiroEditar);
    private bool ModalAberto => form is not null || confirmando is not null;
    private string? ErroModal => ModalAberto ? Erro : null;
    private string? ErroTela => ModalAberto ? null : Erro;

    private string TituloForm => (editandoId is null ? "Nova " : "Editar ") + (form!.Tipo == TipoConta.RECEITA ? "receita" : "despesa");

    private static string Sinal(decimal v) => v < 0 ? "−" + Texto.Moeda(-v) : Texto.Moeda(v);

    private static string ClasseSituacao(SituacaoLancamento s, DateOnly data) => s switch
    {
        SituacaoLancamento.LIQUIDADO => "badge-ok",
        _ when data < DatasBR.Hoje() => "status-NAO_PAGO",
        _ => "badge-neutro",
    };

    private string ContaFiltro
    {
        get => filtro.ContaId?.ToString() ?? "";
        set => filtro.ContaId = Guid.TryParse(value, out var g) ? g : null;
    }

    private bool novaPessoa, novaConta;

    private async Task PessoaCriada(Opcao p)
    {
        pessoas = (await Opcoes.PessoasAsync(Usuario)).Select(x => x.Nome).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        if (form is not null) form.Pessoa = p.Nome;
        novaPessoa = false;
    }

    /// <summary>A conta nova é do mesmo tipo (receita/despesa) do lançamento e já fica selecionada.</summary>
    private async Task CriarConta(string nome)
    {
        var c = await Servico.CriarContaAsync(Usuario, new ContaForm { Nome = nome, Tipo = form!.Tipo });
        contas = await Servico.ContasAsync(incluirInativas: true);
        form.ContaId = c.Id;
        novaConta = false;
    }

    private string ContaForm
    {
        get => form?.ContaId?.ToString() ?? "";
        set { if (form is not null) form.ContaId = Guid.TryParse(value, out var g) ? g : null; }
    }

    /// <summary>Os mesmos filtros da tela, para o PDF e o Excel.</summary>
    /// <summary>Aberto, em atraso e previsto não entram no saldo real: a tela passa para o saldo projetado.</summary>
    private Task AoMudarSituacao()
    {
        if (filtro.SituacaoExigeProjetado) filtro.Projetado = true;
        return Carregar();
    }

    private string Consulta
    {
        get
        {
            var partes = new List<string>();
            if (filtro.De is { } de) partes.Add($"de={de:yyyy-MM-dd}");
            if (filtro.Ate is { } ate) partes.Add($"ate={ate:yyyy-MM-dd}");
            if (filtro.Tipo != TipoExtrato.TODOS) partes.Add($"tipo={filtro.Tipo}");
            if (filtro.ContaId is { } c) partes.Add($"conta={c}");
            if (Texto.Limpo(filtro.Busca) is { } b) partes.Add($"busca={Uri.EscapeDataString(b)}");
            if (filtro.Projetado) partes.Add("projetado=true");
            if (filtro.Situacao != FiltroSituacao.TODAS) partes.Add($"situacao={filtro.Situacao}");
            if (filtro.NaoEnviadosBpo) partes.Add("naoEnviadosBpo=true");
            return partes.Count == 0 ? "" : "?" + string.Join("&", partes);
        }
    }

    private string Periodo() => (filtro.De, filtro.Ate) switch
    {
        (null, null) => "Todo o período.",
        ({ } de, null) => $"A partir de {Texto.Data(de)}.",
        (null, { } ate) => $"Até {Texto.Data(ate)}.",
        ({ } de, { } ate) => $"De {Texto.Data(de)} a {Texto.Data(ate)}.",
    };

    protected override async Task OnInitializedAsync()
    {
        await Executar(async () =>
        {
            contas = await Servico.ContasAsync(incluirInativas: true);
            pessoas = (await Opcoes.PessoasAsync(Usuario)).Select(p => p.Nome).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        });
        await Carregar();
    }

    private Task Carregar() => Executar(async () =>
    {
        ex = await Servico.ExtratoAsync(Usuario, ImovelId, filtro);
        contagem = await Comprovantes.ContagemAsync(Usuario, ImovelId);
        temBpo = await Bpo.TemResponsavelAsync(Usuario, ImovelId);
    });

    /// <summary>O imóvel tem responsável financeiro (BPO): mostra o botão do cartão e o filtro "Não enviados".</summary>
    private bool temBpo;

    private async Task CarregarContagem() => await Executar(async () => contagem = await Comprovantes.ContagemAsync(Usuario, ImovelId));

    private Task Mes(int deslocamento)
    {
        var hoje = DatasBR.Hoje();
        var inicio = new DateOnly(hoje.Year, hoje.Month, 1).AddMonths(deslocamento);
        filtro.De = inicio;
        filtro.Ate = inicio.AddMonths(1).AddDays(-1);
        return Carregar();
    }

    private Task EsteAno()
    {
        var ano = DatasBR.Hoje().Year;
        filtro.De = new DateOnly(ano, 1, 1);
        filtro.Ate = new DateOnly(ano, 12, 31);
        return Carregar();
    }

    private Task Tudo()
    {
        filtro.De = null;
        filtro.Ate = null;
        return Carregar();
    }

    private void Novo(TipoConta tipo)
    {
        Erro = null;
        editandoId = null;
        numeroEditando = null;
        deRecorrencia = false;
        anexos.Clear();
        form = LancamentoForm.Novo(tipo);
    }

    private async Task Editar(Guid id)
    {
        LancamentoDetalhe? d = null;
        if (!await Executar(async () => d = await Servico.ObterAsync(Usuario, id))) return;
        editandoId = id;
        numeroEditando = d!.Numero;
        deRecorrencia = d.Dados.OrigemId is not null;
        anexos.Clear();
        form = LancamentoForm.De(d.Dados);
    }

    private async Task Salvar()
    {
        var id = editandoId ?? Guid.Empty;
        var ok = editandoId is not null
            ? await Executar(() => Servico.AtualizarAsync(Usuario, id, form!))
            : await Executar(async () => id = await Servico.CriarAsync(Usuario, ImovelId, form!));
        if (!ok) return;
        var msg = editandoId is null
            ? (form!.Tipo == TipoConta.RECEITA ? "Receita lançada" : "Despesa lançada") + (form.Liquidado ? " (liquidada)" : " (em aberto)")
            : "Título atualizado";
        form = null;
        var enviados = 0;
        var envioOk = anexos.Count == 0 || await Executar(async () =>
        {
            foreach (var a in anexos.ToList())
            {
                using var dados = new MemoryStream(a.Dados);
                await Comprovantes.EnviarAsync(Usuario, id, dados, a.Nome, a.Tipo, a.Dados.Length);
                anexos.Remove(a);
                enviados++;
            }
        });
        anexos.Clear();
        await Carregar();
        if (!envioOk)
        {
            Erro = $"{msg}, mas o anexo falhou: {Erro} Anexe de novo pelo botão 📎 do título.";
            return;
        }
        Sucesso = msg + (enviados > 0 ? $", com {enviados} anexo(s)." : ".");
    }

    private void AbrirConfirmacao(TituloPendente p)
    {
        Erro = null;
        liquidando = false;
        confirmando = p;
        confirmacao = new ConfirmacaoPrevistoForm { Data = p.Vencimento, Valor = Math.Abs(p.Valor), DataLiquidacao = DatasBR.Hoje() };
    }

    private void AbrirLiquidacao(TituloPendente a)
    {
        Erro = null;
        liquidando = true;
        confirmando = a;
        confirmacao = new ConfirmacaoPrevistoForm { Data = a.Vencimento, Valor = Math.Abs(a.Valor), Liquidado = true, DataLiquidacao = DatasBR.Hoje() };
    }

    private async Task ConfirmarOuLiquidar()
    {
        var c = confirmando!;
        var ok = liquidando
            ? await Executar(() =>
            {
                if (confirmacao.DataLiquidacao is null) throw new RegraNegocioException("DataLiquidacao", "Informe a data.");
                return Servico.LiquidarAsync(Usuario, c.Id, confirmacao.DataLiquidacao.Value, confirmacao.Valor!.Value);
            })
            : await Executar(() => Servico.ConfirmarAsync(Usuario, c.Id, confirmacao));
        if (!ok) return;
        var msg = liquidando ? $"Título {c.Numero} liquidado." : confirmacao.Liquidado ? "Previsto confirmado e liquidado." : "Previsto confirmado: título em aberto.";
        confirmando = null;
        await Carregar();
        Sucesso = msg;
    }

    private async Task Ignorar(TituloPendente p)
    {
        if (!await Executar(() => Servico.IgnorarAsync(Usuario, p.Id))) return;
        await Carregar();
        Sucesso = $"Previsto de {Texto.Data(p.Vencimento)} ignorado.";
    }

    private async Task Excluir(Guid id, string numero, string descricao, decimal valor, DateOnly vencimento, bool recorrente)
    {
        var detalhe = recorrente ? "Os lançamentos previstos desta recorrência que ainda não foram confirmados também saem." : null;
        if (!await confirmar.PerguntarAsync($"Título {numero} – {descricao} ({Sinal(valor)}, vencimento {Texto.Data(vencimento)})", detalhe)) return;
        if (!await Executar(() => Servico.ExcluirAsync(Usuario, id))) return;
        await Carregar();
        Sucesso = $"Título {numero} excluído (registrado na Auditoria).";
    }

    /// <summary>Arquivo escolhido no formulário: guardado em memória e enviado ao Drive só depois de salvar.</summary>
    private sealed record AnexoPendente(string Nome, string Tipo, byte[] Dados);

    private readonly List<AnexoPendente> anexos = [];
    private IReadOnlyList<string> pessoas = [];

    private Task EscolherAnexos(InputFileChangeEventArgs e) => Executar(async () =>
    {
        var arquivos = EnvioComprovantes.Selecionar(e);
        if (anexos.Count + arquivos.Count > ComprovantesService.MaximoPorEnvio)
            throw new RegraNegocioException("arquivo", $"No máximo {ComprovantesService.MaximoPorEnvio} arquivos por lançamento.");
        foreach (var f in arquivos)
        {
            await using var origem = f.OpenReadStream(ComprovantesService.TamanhoMaximo);
            using var buffer = new MemoryStream();
            await origem.CopyToAsync(buffer);
            anexos.Add(new AnexoPendente(f.Name, string.IsNullOrEmpty(f.ContentType) ? "application/octet-stream" : f.ContentType, buffer.ToArray()));
        }
    });

    private static string Tamanho(long b) => b >= 1024 * 1024 ? $"{b / 1024d / 1024:0.#} MB" : $"{Math.Max(1, b / 1024)} KB";

    private void Fechar()
    {
        anexos.Clear();
        form = null;
        confirmando = null;
        Erro = null;
    }
}
