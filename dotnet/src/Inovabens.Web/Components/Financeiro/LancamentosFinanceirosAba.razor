@inherits ComponenteBase
@inject LancamentosFinanceirosService Servico
@inject ComprovantesService Comprovantes
@inject BpoService Bpo
@inject OpcoesService Opcoes

@* Aba "Lançamentos Financeiros" do imóvel: títulos a receber (+) e a pagar (−) correntes. Situação: previsto (recorrência)
   → aberto → liquidado. O extrato mostra o saldo REAL (só liquidados, padrão) ou PROJETADO (também abertos e previstos).
   Filtros começam no mês corrente; PDF e Excel saem com os mesmos filtros. *@

<section class="card">
    <div class="titulo-secao">
        <h2>Lançamentos Financeiros</h2>
        <div class="acoes-topo">
            @if (PodeEditar)
            {
                <button class="btn-primary" disabled="@Ocupado" @onclick="() => Novo(TipoConta.RECEITA)">+ Nova receita</button>
                <button class="btn-primary btn-despesa" disabled="@Ocupado" @onclick="() => Novo(TipoConta.DESPESA)">+ Nova despesa</button>
            }
            @if (Usuario.Pode(Permissoes.FinanceiroExportar))
            {
                <a class="btn-ghost" href="@($"imoveis/{ImovelId}/extrato.pdf{Consulta}")" download>Extrato PDF</a>
                <a class="btn-ghost" href="@($"imoveis/{ImovelId}/extrato.xlsx{Consulta}")" download>Extrato Excel</a>
            }
        </div>
    </div>

    <form class="linha-form extrato-filtros" @onsubmit="Carregar" @onsubmit:preventDefault>
        <label class="campo-inline"><span>De</span><input type="date" class="input w-data" @bind="filtro.De" /></label>
        <label class="campo-inline"><span>Até</span><input type="date" class="input w-data" @bind="filtro.Ate" /></label>
        <label class="campo-inline">
            <span>Saldo</span>
            <select class="input" @bind="ModoSaldo" @bind:after="Carregar">
                <option value="real">Real (só liquidados)</option>
                <option value="projetado">Projetado (com abertos e previstos)</option>
            </select>
        </label>
        <label class="campo-inline">
            <span>Mostrar</span>
            <select class="input" @bind="filtro.Tipo">
                <option value="@TipoExtrato.TODOS">Receitas e despesas</option>
                <option value="@TipoExtrato.RECEITAS">Só receitas</option>
                <option value="@TipoExtrato.DESPESAS">Só despesas</option>
            </select>
        </label>
        <label class="campo-inline">
            <span>Situação</span>
            <select class="input" @bind="filtro.Situacao" @bind:after="AoMudarSituacao">
                <option value="@FiltroSituacao.TODAS">Todas</option>
                <option value="@FiltroSituacao.LIQUIDADO">Liquidado</option>
                <option value="@FiltroSituacao.ABERTO">Aberto</option>
                <option value="@FiltroSituacao.EM_ATRASO">Em atraso</option>
                <option value="@FiltroSituacao.PREVISTO">Previsto</option>
            </select>
        </label>
        <label class="campo-inline">
            <span>Conta</span>
            <select class="input" @bind="ContaFiltro">
                <option value="">Todas</option>
                @foreach (var c in contas)
                {
                    <option value="@c.Id">@c.Nome@(c.Ativo ? "" : " (inativa)")</option>
                }
            </select>
        </label>
        @if (temBpo)
        {
            <label class="check campo-inline" title="Só os lançamentos que ainda não foram mandados ao responsável financeiro">
                <input type="checkbox" @bind="filtro.NaoEnviadosBpo" @bind:after="Carregar" /> Não enviados ao BPO
            </label>
        }
        <label class="campo-inline"><span>Buscar</span><input class="input" placeholder="nº, descrição, conta ou observação" @bind="filtro.Busca" /></label>
        <button type="submit" class="btn-primary" disabled="@Ocupado">Filtrar</button>
        <span class="atalhos-periodo">
            <button type="button" class="btn-ghost mini" @onclick="() => Mes(-1)">Mês anterior</button>
            <button type="button" class="btn-ghost mini" @onclick="() => Mes(0)">Mês atual</button>
            <button type="button" class="btn-ghost mini" @onclick="EsteAno">Este ano</button>
            <button type="button" class="btn-ghost mini" @onclick="Tudo">Tudo</button>
        </span>
    </form>
    <p class="pequeno mudo">@Periodo() @(filtro.Projetado
        ? "Saldo projetado: liquidados na data da liquidação; abertos e previstos na data de vencimento."
        : "Saldo real: só títulos liquidados (pagos/recebidos), na data da liquidação.")</p>
    <MensagemErro Texto="@ErroTela" />
    <MensagemErro Texto="@Sucesso" Sucesso />

    @if (ex is null)
    {
        @if (Erro is null)
        {
            <p class="carregando">Carregando…</p>
        }
    }
    else
    {
        <div class="kpis espaco-topo">
            <div class="kpi"><p class="rotulo-kpi">Entradas no período</p><p class="valor-kpi texto-ok">@Texto.Moeda(ex.Entradas)</p></div>
            <div class="kpi"><p class="rotulo-kpi">Saídas no período</p><p class="valor-kpi texto-erro">@Sinal(-ex.Saidas)</p></div>
            <div class="kpi">
                <p class="rotulo-kpi">Saldo @(filtro.Projetado ? "projetado" : "real") no fim do período</p>
                <p class="valor-kpi @(ex.SaldoFinal < 0 ? "texto-erro" : "")">@Sinal(ex.SaldoFinal)</p>
                <p class="pequeno mudo">saldo anterior @Sinal(ex.SaldoAnterior)</p>
            </div>
            <div class="kpi">
                <p class="rotulo-kpi">Em aberto</p>
                <p class="valor-kpi @(ex.Abertos.Any(a => a.Atrasado) ? "texto-erro" : "")">@ex.Abertos.Count</p>
                <p class="pequeno mudo">@(ex.Abertos.Count == 0 ? "nenhum título" : $"{Sinal(ex.TotalAberto)} · {ex.Abertos.Count(a => a.Atrasado)} em atraso")</p>
            </div>
        </div>
        <p class="pequeno mudo">Saldo real do imóvel (todo o histórico): <b class="@(ex.SaldoAtual < 0 ? "texto-erro" : "")">@Sinal(ex.SaldoAtual)</b></p>

        <div class="tabela-container">
            <table class="tabela extrato">
                <thead>
                    <tr>
                        <th>Nº</th><th>@(filtro.Projetado ? "Data" : "Liquidação")</th>@if (filtro.Projetado) { <th>Situação</th> }
                        <th>Descrição</th><th>Conta</th><th class="num">Valor</th><th class="num">Saldo</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (filtro.De is not null)
                    {
                        <tr class="saldo-anterior">
                            <td></td><td>@Texto.Data(filtro.De)</td><td colspan="@(filtro.Projetado ? 4 : 3)"><b>Saldo anterior</b></td>
                            <td class="num"><b>@Sinal(ex.SaldoAnterior)</b></td><td></td>
                        </tr>
                    }
                    @if (ex.Linhas.Count == 0)
                    {
                        <tr><td colspan="8" class="vazio">@(filtro.Projetado ? "Nenhum título no período." : "Nenhum título liquidado no período.")</td></tr>
                    }
                    @foreach (var l in ex.Linhas)
                    {
                        <tr class="@(l.Situacao == SituacaoLancamento.LIQUIDADO ? "" : "linha-projetada")">
                            <td class="nowrap mudo">@l.Numero</td>
                            <td>@Texto.Data(l.Data)</td>
                            @if (filtro.Projetado)
                            {
                                <td><span class="badge @ClasseSituacao(l.Situacao, l.Data)">@LancamentosFinanceirosService.NomeSituacao(l.Situacao)</span></td>
                            }
                            <td>
                                <b>@l.Descricao</b>
                                @if (l.Recorrente) { <span class="badge badge-neutro" title="Repete todo mês">↻ recorrente</span> }
                                @if (l.DeRecorrencia) { <span class="pequeno mudo" title="Veio de uma recorrência"> ↻</span> }
                                @if (l.Situacao == SituacaoLancamento.LIQUIDADO && l.Vencimento != l.Data) { <p class="pequeno mudo">vencimento @Texto.Data(l.Vencimento)</p> }
                                @if (l.Pessoa is not null) { <p class="pequeno">👤 @l.Pessoa</p> }
                                @if (l.Observacao is not null) { <p class="pequeno mudo">@l.Observacao</p> }
                                <SeloBpo EnviadoEm="l.BpoEnviadoEm" />
                            </td>
                            <td>@l.Conta</td>
                            <td class="num @(l.Valor < 0 ? "texto-erro" : "texto-ok")">@Sinal(l.Valor)</td>
                            <td class="num @(l.Saldo < 0 ? "texto-erro" : "")"><b>@Sinal(l.Saldo)</b></td>
                            <td class="acoes-linha">
                                @if (l.Situacao != SituacaoLancamento.PREVISTO)
                                {
                                    <ComprovantesAnexos LancamentoId="l.Id" Quantidade="@contagem.GetValueOrDefault(l.Id)"
                                                        Titulo="@($"{l.Numero} {l.Descricao}")" AoAlterar="CarregarContagem" />
                                    @if (temBpo) { <CartaoBpoBotao LancamentoId="l.Id" Enviado="l.BpoEnviadoEm is not null" AoAlterar="Carregar" /> }
                                    @if (PodeEditar)
                                    {
                                        <button class="btn-ghost mini" title="Editar" aria-label="Editar" disabled="@Ocupado" @onclick="() => Editar(l.Id)"><Icone Nome="lapis" /></button>
                                        <button class="btn-perigo mini" title="Excluir" aria-label="Excluir" disabled="@Ocupado"
                                                @onclick="() => Excluir(l.Id, l.Numero, l.Descricao, l.Valor, l.Vencimento, l.Recorrente)"><Icone Nome="lixeira" /></button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="@(filtro.Projetado ? 5 : 4)"><b>Totais do período</b> · entradas @Texto.Moeda(ex.Entradas) · saídas @Sinal(-ex.Saidas)</td>
                        <td class="num"><b>@Sinal(ex.Entradas - ex.Saidas)</b></td>
                        <td class="num"><b>@Sinal(ex.SaldoFinal)</b></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <h3 class="espaco-topo">Em aberto <span class="pequeno mudo">(a pagar e a receber · fora do saldo real)</span></h3>
        @if (ex.Abertos.Count == 0)
        {
            <p class="pequeno mudo">Nenhum título em aberto no período.</p>
        }
        else
        {
            <div class="tabela-container">
                <table class="tabela">
                    <thead><tr><th>Nº</th><th>Vencimento</th><th>Descrição</th><th>Conta</th><th>Situação</th><th class="num">Valor</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var a in ex.Abertos)
                        {
                            <tr>
                                <td class="nowrap mudo">@a.Numero</td>
                                <td>@Texto.Data(a.Vencimento)</td>
                                <td><b>@a.Descricao</b>@if (a.Recorrente) { <span class="badge badge-neutro">↻ recorrente</span> }@if (a.Pessoa is not null) { <p class="pequeno">👤 @a.Pessoa</p> }<SeloBpo EnviadoEm="a.BpoEnviadoEm" /></td>
                                <td>@a.Conta</td>
                                <td>
                                    @if (a.Atrasado) { <span class="badge status-NAO_PAGO">Em atraso · @a.DiasAtraso dia(s)</span> }
                                    else { <span class="mudo">a vencer</span> }
                                </td>
                                <td class="num @(a.Valor < 0 ? "texto-erro" : "texto-ok")">@Sinal(a.Valor)</td>
                                <td class="acoes-linha">
                                    <ComprovantesAnexos LancamentoId="a.Id" Quantidade="@contagem.GetValueOrDefault(a.Id)"
                                                        Titulo="@($"{a.Numero} {a.Descricao}")" AoAlterar="CarregarContagem" />
                                    @if (temBpo && a.Situacao != SituacaoLancamento.PREVISTO) { <CartaoBpoBotao LancamentoId="a.Id" Enviado="a.BpoEnviadoEm is not null" AoAlterar="Carregar" /> }
                                    @if (PodeEditar)
                                    {
                                        <button class="btn-primary mini" disabled="@Ocupado" @onclick="() => AbrirLiquidacao(a)">@(a.Valor < 0 ? "Pagar" : "Receber")</button>
                                        <button class="btn-ghost mini" title="Editar" aria-label="Editar" disabled="@Ocupado" @onclick="() => Editar(a.Id)"><Icone Nome="lapis" /></button>
                                        <button class="btn-perigo mini" title="Excluir" aria-label="Excluir" disabled="@Ocupado"
                                                @onclick="() => Excluir(a.Id, a.Numero, a.Descricao, a.Valor, a.Vencimento, a.Recorrente)"><Icone Nome="lixeira" /></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <h3 class="espaco-topo">Previstos <span class="pequeno mudo">(gerados pelas recorrências · confirme para virar título)</span></h3>
        @if (ex.Previstos.Count == 0)
        {
            <p class="pequeno mudo">Nenhum lançamento previsto no período.</p>
        }
        else
        {
            <div class="tabela-container">
                <table class="tabela">
                    <thead><tr><th>Vencimento</th><th>Descrição</th><th>Conta</th><th>Situação</th><th class="num">Valor estimado</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in ex.Previstos)
                        {
                            <tr>
                                <td>@Texto.Data(p.Vencimento)</td>
                                <td><b>@p.Descricao</b></td>
                                <td>@p.Conta</td>
                                <td>
                                    @if (p.Atrasado) { <span class="badge status-NAO_PAGO">Em atraso · @p.DiasAtraso dia(s)</span> }
                                    else { <span class="mudo">previsto</span> }
                                </td>
                                <td class="num @(p.Valor < 0 ? "texto-erro" : "texto-ok")">@Sinal(p.Valor)</td>
                                <td class="acoes-linha">
                                    @if (PodeEditar)
                                    {
                                        <button class="btn-primary mini" disabled="@Ocupado" @onclick="() => AbrirConfirmacao(p)">Confirmar</button>
                                        <button class="btn-ghost mini" disabled="@Ocupado" title="Não aconteceu neste mês" @onclick="() => Ignorar(p)">Ignorar</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

@if (form is not null)
{
    <Modal Titulo="@TituloForm" AoFechar="Fechar">
        <EditForm Model="form" OnValidSubmit="Salvar" class="formulario">
            <DataAnnotationsValidator />
            <MensagemErro Texto="@ErroModal" />
            @if (numeroEditando is not null)
            {
                <p class="pequeno mudo">Título <b>@numeroEditando</b></p>
            }
            <div class="grade-2">
                <label class="campo">
                    <span>Vencimento</span>
                    <InputDate class="input" @bind-Value="form.Data" />
                    <ValidationMessage For="() => form.Data" />
                </label>
                <label class="campo">
                    <span>Valor (R$) @(form.Tipo == TipoConta.RECEITA ? "— entra como positivo" : "— entra como negativo")</span>
                    <InputNumber class="input" step="0.01" min="0.01" @bind-Value="form.Valor" />
                    <ValidationMessage For="() => form.Valor" />
                </label>
                <label class="campo col-2">
                    <span>Descrição</span>
                    <InputText class="input" maxlength="200" @bind-Value="form.Descricao" />
                    <ValidationMessage For="() => form.Descricao" />
                </label>
                <label class="campo col-2">
                    <span>@(form.Tipo == TipoConta.RECEITA ? "Pessoa (quem pagou)" : "Pessoa (a quem foi pago)")</span>
                    <div class="com-novo">
                        <InputText class="input" list="pessoas-lancamento" maxlength="200" placeholder="Digite o nome ou escolha uma pessoa cadastrada"
                                   @bind-Value="form.Pessoa" />
                        @if (Usuario.Pode(Permissoes.PessoasCriar))
                        {
                            <button type="button" class="btn-ghost mini" title="Cadastrar uma pessoa que não está na lista" @onclick="() => novaPessoa = true">+ Nova</button>
                        }
                    </div>
                    <datalist id="pessoas-lancamento">
                        @foreach (var nome in pessoas)
                        {
                            <option value="@nome" />
                        }
                    </datalist>
                    <ValidationMessage For="() => form.Pessoa" />
                </label>
                <label class="campo col-2">
                    <span>Conta orçamentária</span>
                    <div class="com-novo">
                        <select class="input" @bind="ContaForm">
                            <option value="">Selecione…</option>
                            @foreach (var c in contas.Where(c => c.Tipo == form.Tipo && (c.Ativo || c.Id == form.ContaId)))
                            {
                                <option value="@c.Id">@c.Nome</option>
                            }
                        </select>
                        <button type="button" class="btn-ghost mini" title="Cadastrar uma conta que não está na lista" @onclick="() => novaConta = true">+ Nova</button>
                    </div>
                    <ValidationMessage For="() => form.ContaId" />
                </label>
                <label class="check col-2">
                    <InputCheckbox @bind-Value="form.Liquidado" /> @(form.Tipo == TipoConta.RECEITA ? "Já recebido (liquidado)" : "Já pago (liquidado)")
                </label>
                @if (form.Liquidado)
                {
                    <label class="campo">
                        <span>Data do @(form.Tipo == TipoConta.RECEITA ? "recebimento" : "pagamento")</span>
                        <InputDate class="input" @bind-Value="form.DataLiquidacao" />
                        <ValidationMessage For="() => form.DataLiquidacao" />
                    </label>
                    <p class="pequeno mudo">Entra no saldo nesta data.</p>
                }
                else
                {
                    <p class="pequeno mudo col-2">Fica <b>em aberto</b> (fora do saldo real) até ser @(form.Tipo == TipoConta.RECEITA ? "recebido" : "pago"); depois do vencimento aparece como em atraso.</p>
                }
                <label class="campo col-2">
                    <span>Observação</span>
                    <InputTextArea class="input" rows="2" @bind-Value="form.Observacao" />
                </label>
                <div class="campo col-2">
                    <span>Documento / recibo</span>
                    @if (!Comprovantes.Habilitado)
                    {
                        <p class="pequeno texto-erro">Google Drive não configurado: configure em Administração → Configurações para anexar.</p>
                    }
                    else
                    {
                        <div>
                            <label class="btn-ghost mini" style="display:inline-block">
                                📎 Anexar documento…
                                <InputFile OnChange="EscolherAnexos" class="oculto" disabled="@Ocupado" multiple />
                            </label>
                            @if (editandoId is { } eid && contagem.GetValueOrDefault(eid) > 0)
                            {
                                <span class="pequeno mudo"> já anexado(s): @contagem.GetValueOrDefault(eid)</span>
                            }
                        </div>
                        @if (anexos.Count > 0)
                        {
                            <ul class="lista-comprovantes">
                                @foreach (var a in anexos)
                                {
                                    <li>
                                        @a.Nome <span class="pequeno mudo">@Tamanho(a.Dados.Length)</span>
                                        <button type="button" class="btn-ghost mini" title="Tirar" aria-label="@($"Tirar {a.Nome}")" @onclick="() => anexos.Remove(a)"><Icone Nome="x" /></button>
                                    </li>
                                }
                            </ul>
                        }
                        <p class="pequeno mudo">Enviado ao salvar. Fica no Drive em “07 - Financeiro/&lt;ano&gt;” da pasta do imóvel.</p>
                    }
                </div>
                @if (!deRecorrencia)
                {
                    <label class="check col-2">
                        <InputCheckbox @bind-Value="form.Recorrente" @bind-Value:after="AoMarcarRecorrencia" /> Repete todo mês (recorrência)
                    </label>
                    @if (form.Recorrente)
                    {
                        <label class="campo">
                            <span>Dia da recorrência</span>
                            <InputNumber class="input" min="1" max="31" @bind-Value="form.DiaRecorrencia" />
                            <ValidationMessage For="() => form.DiaRecorrencia" />
                        </label>
                        <label class="campo">
                            <span>Valor estimado (R$)</span>
                            <InputNumber class="input" step="0.01" min="0.01" @bind-Value="form.ValorEstimado" />
                            <ValidationMessage For="() => form.ValorEstimado" />
                        </label>
                        <p class="pequeno mudo col-2">A partir do mês seguinte, todo mês nasce um lançamento <b>previsto</b> nesse dia, com o valor estimado.
                            Confirmado, ele vira título em aberto (ou já liquidado); também pode ser ignorado.</p>
                    }
                }
                else
                {
                    <p class="pequeno mudo col-2">↻ Título confirmado a partir de uma recorrência: altere a recorrência no lançamento de origem.</p>
                }
            </div>
            <div class="acoes direita">
                <button type="button" class="btn-ghost" @onclick="Fechar">Cancelar</button>
                <button type="submit" class="btn-primary" disabled="@Ocupado">Salvar</button>
            </div>
        </EditForm>
    </Modal>
}

@* pop-ups do "+ Nova" por cima do formulário do lançamento *@
@if (novaPessoa)
{
    <NovaPessoa AoCriar="PessoaCriada" AoFechar="() => novaPessoa = false" />
}
@if (novaConta && form is not null)
{
    <CadastroRapido Titulo="@($"Nova conta de {(form.Tipo == TipoConta.RECEITA ? "receita" : "despesa")}")" Placeholder="Ex.: Jardinagem"
                    Criar="CriarConta" AoFechar="() => novaConta = false" />
}

@if (confirmando is not null)
{
    <Modal Titulo="@((liquidando ? (confirmando.Valor < 0 ? "Pagar" : "Receber") : "Confirmar previsto") + $" — {confirmando.Descricao}")" AoFechar="Fechar">
        <EditForm Model="confirmacao" OnValidSubmit="ConfirmarOuLiquidar" class="formulario">
            <DataAnnotationsValidator />
            <MensagemErro Texto="@ErroModal" />
            <p class="pequeno mudo">
                @confirmando.Conta · @(liquidando ? $"título {confirmando.Numero}, vencimento {Texto.Data(confirmando.Vencimento)}" : $"estimado {Sinal(confirmando.Valor)}")
            </p>
            <div class="grade-2">
                @if (!liquidando)
                {
                    <label class="campo">
                        <span>Vencimento</span>
                        <InputDate class="input" @bind-Value="confirmacao.Data" />
                        <ValidationMessage For="() => confirmacao.Data" />
                    </label>
                }
                <label class="campo">
                    <span>Valor (R$)</span>
                    <InputNumber class="input" step="0.01" min="0.01" @bind-Value="confirmacao.Valor" />
                    <ValidationMessage For="() => confirmacao.Valor" />
                </label>
                @if (!liquidando)
                {
                    <label class="check col-2"><InputCheckbox @bind-Value="confirmacao.Liquidado" /> Já @(confirmando.Valor < 0 ? "pago" : "recebido") (liquidado)</label>
                }
                @if (liquidando || confirmacao.Liquidado)
                {
                    <label class="campo">
                        <span>Data do @(confirmando.Valor < 0 ? "pagamento" : "recebimento")</span>
                        <InputDate class="input" @bind-Value="confirmacao.DataLiquidacao" />
                        <ValidationMessage For="() => confirmacao.DataLiquidacao" />
                    </label>
                }
            </div>
            <p class="pequeno mudo">@(liquidando || confirmacao.Liquidado ? "O título passa a liquidado e entra no saldo." : "O previsto vira título em aberto, com o próximo nº do imóvel.")</p>
            <div class="acoes direita">
                <button type="button" class="btn-ghost" @onclick="Fechar">Cancelar</button>
                <button type="submit" class="btn-primary" disabled="@Ocupado">Confirmar</button>
            </div>
        </EditForm>
    </Modal>
}

