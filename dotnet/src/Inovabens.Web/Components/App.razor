<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="img/marca.svg" />
    <meta name="theme-color" content="#03075f" />
    <link rel="preload" href="fontes/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Inovabens.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="ModoPagina" />
</head>

<body>
    <Routes @rendermode="ModoPagina" IpCliente="@IpCliente" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["mascaras.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Páginas marcadas com [ExcludeFromInteractiveRouting] (login) rodam estáticas, pois precisam gravar o cookie.
    private IComponentRenderMode? ModoPagina => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

    private string? IpCliente => HttpContext.Connection.RemoteIpAddress?.ToString();
}
