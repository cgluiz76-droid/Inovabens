<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="img/marca.svg" />
    <meta name="theme-color" content="#f4f6fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0f1f" media="(prefers-color-scheme: dark)" />
    @* tema escolhido pelo usuário aplicado antes da primeira pintura (sem piscar claro → escuro) *@
    <script>try { var h = document.documentElement, t = localStorage.getItem("tema"), m = localStorage.getItem("menu"); if (t === "claro" || t === "escuro") h.setAttribute("data-tema", t); if (m === "recolhido" || m === "aberto") h.setAttribute("data-menu", m); } catch (e) { }</script>
    @* só a Inter fica no caminho crítico; a Montserrat aparece apenas no nome da marca *@
    <link rel="preload" href="fontes/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Inovabens.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="ModoPagina" />
</head>

<body>
    <Routes @rendermode="ModoPagina" IpCliente="@IpCliente" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    @* máscaras e arraste do kanban só nas páginas do sistema (o login é estático e não usa) *@
    @if (ModoPagina is not null)
    {
        <script src="@Assets["mascaras.js"]" defer></script>
        <script src="@Assets["kanban.js"]" defer></script>
    }
    <script src="@Assets["interface.js"]" defer></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Páginas marcadas com [ExcludeFromInteractiveRouting] (login) rodam estáticas, pois precisam gravar o cookie.
    private IComponentRenderMode? ModoPagina => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

    private string? IpCliente => HttpContext.Connection.RemoteIpAddress?.ToString();
}
