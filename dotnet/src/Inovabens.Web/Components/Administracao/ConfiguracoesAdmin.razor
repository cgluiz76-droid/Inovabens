@inherits ComponenteBase
@inject LancamentosFinanceirosService Lancamentos
@inject IndicesService Indices
@inject CrmService Crm
@inject IJSRuntime JS

<MensagemErro Texto="@Erro" />
<MensagemErro Texto="@Sucesso" Sucesso />

<div class="grade-2">
    <section class="card">
        <h2>Contas orçamentárias</h2>
        <p class="pequeno mudo">Usadas nos Lançamentos Financeiros dos imóveis. Receita entra com valor positivo; despesa, negativo.</p>
        @if (categorias is not null)
        {
            <table class="tabela">
                <tbody>
                    @foreach (var c in categorias)
                    {
                        <tr>
                            <td><input class="input" value="@c.Nome" @onchange="e => RenomearCategoria(c, e.Value?.ToString())" /></td>
                            <td><span class="badge @(c.Tipo == TipoConta.RECEITA ? "status-PAGO" : "status-NAO_PAGO")">@Texto.Rotulo(c.Tipo)</span></td>
                            <td class="acoes-linha">
                                <label class="check">
                                    <input type="checkbox" checked="@c.Ativo" @onchange="e => SalvarCategoria(c, c.Nome, (bool)e.Value!)" /> Ativa
                                </label>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <div class="linha-form">
            <input class="input w-desc" placeholder="Nova conta" @bind="novaCategoria" />
            <select class="input" @bind="novoTipo">
                <option value="@TipoConta.DESPESA">Despesa</option>
                <option value="@TipoConta.RECEITA">Receita</option>
            </select>
            <button class="btn-primary" disabled="@Ocupado" @onclick="CriarCategoria">Adicionar</button>
        </div>
    </section>

    <section class="card">
        <h2>Índices de correção</h2>
        <p class="pequeno mudo">
            IPCA, INCC, IGP-M e Selic vêm do Banco Central (SGS). A busca automática roda todo dia 12 às 06:00;
            use o botão para buscar agora.
        </p>
        <div class="acoes">
            <button class="btn-primary" disabled="@Ocupado" @onclick="SincronizarIndices">Buscar índices no BCB</button>
        </div>
    </section>
</div>

<section class="card espaco-topo">
    <div class="titulo-secao">
        <h2>Estágios do funil</h2>
        <select class="input filtro" aria-label="Funil" @bind="funil" @bind:after="CarregarEstagios">
            @foreach (var f in Enum.GetValues<Funil>())
            {
                <option value="@f">@Funis.Nome(f)@(Funis.EhProcesso(f) ? " (processos do imóvel)" : "")</option>
            }
        </select>
    </div>
    @if (estagios is not null)
    {
        <div class="tabela-container">
            <table class="tabela">
                <thead><tr><th>Ordem</th><th>Nome</th><th>Cor</th><th>Tipo</th><th title="Dias máximos na etapa; passou disso, o responsável recebe um alerta">Prazo (dias)</th>@if (!Funis.EhProcesso(funil)) {<th title="Próximo passo já preenchido quando o lead entra na etapa">Próximo passo sugerido</th>}<th>Ativo</th><th></th></tr></thead>
                <tbody>
                    @for (var i = 0; i < estagios.Count; i++)
                    {
                        var idx = i;
                        var e = estagios[i];
                        <tr>
                            <td class="sem-quebra">
                                <button class="btn-ghost mini" disabled="@(idx == 0 || Ocupado)" @onclick="() => Trocar(idx, idx - 1)">↑</button>
                                <button class="btn-ghost mini" disabled="@(idx == estagios.Count - 1 || Ocupado)" @onclick="() => Trocar(idx, idx + 1)">↓</button>
                            </td>
                            <td><input class="input" value="@e.Nome" @onchange="v => SalvarEstagio(e, f => f.Nome = v.Value?.ToString() ?? string.Empty)" /></td>
                            <td><input type="color" value="@(e.Cor ?? "#64748b")" @onchange="v => SalvarEstagio(e, f => f.Cor = v.Value?.ToString() ?? f.Cor)" /></td>
                            <td>
                                <select class="input" value="@e.Tipo" @onchange="v => SalvarEstagio(e, f => f.Tipo = TipoDe(v))">
                                    @foreach (var t in Enum.GetValues<TipoEstagio>())
                                    {
                                        <option value="@t">@Texto.Rotulo(t)</option>
                                    }
                                </select>
                            </td>
                            <td>
                                @if (e.Tipo == TipoEstagio.ABERTO)
                                {
                                    <input class="input w-num" type="number" min="1" max="365" value="@e.PrazoDias" placeholder="—" aria-label="Prazo em dias"
                                           @onchange="v => SalvarEstagio(e, f => f.PrazoDias = Numero(v))" />
                                }
                            </td>
                            @if (!Funis.EhProcesso(funil))
                            {
                                <td>
                                    @if (e.Tipo != TipoEstagio.PERDIDO)
                                    {
                                        <div class="sugestao-etapa">
                                            <select class="input" value="@(e.SugestaoTipo ?? TipoCompromisso.LIGACAO)" aria-label="Tipo do próximo passo"
                                                    @onchange="v => SalvarEstagio(e, f => f.SugestaoTipo = Enum.Parse<TipoCompromisso>(v.Value!.ToString()!))">
                                                @foreach (var t in Enum.GetValues<TipoCompromisso>())
                                                {
                                                    <option value="@t">@Texto.Rotulo(t)</option>
                                                }
                                            </select>
                                            <input class="input" value="@e.SugestaoTitulo" placeholder="Sem sugestão" aria-label="Título do próximo passo"
                                                   @onchange="v => SalvarEstagio(e, f => f.SugestaoTitulo = v.Value?.ToString())" />
                                            <label class="pequeno mudo sem-quebra">em
                                                <input class="input w-num" type="number" min="0" max="365" value="@e.SugestaoDias" aria-label="Em quantos dias"
                                                       @onchange="v => SalvarEstagio(e, f => f.SugestaoDias = Numero(v))" /> dia(s)</label>
                                        </div>
                                    }
                                </td>
                            }
                            <td><input type="checkbox" checked="@e.Ativo" @onchange="v => SalvarEstagio(e, f => f.Ativo = (bool)v.Value!)" /></td>
                            <td class="acoes-linha">
                                <button class="btn-ghost mini texto-erro" disabled="@Ocupado" @onclick="() => ExcluirEstagio(e)">Excluir</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <div class="linha-form">
        <input class="input w-desc" placeholder="Novo estágio" @bind="novoEstagio.Nome" />
        <input type="color" @bind="novoEstagio.Cor" />
        <select class="input w-tipo" @bind="novoEstagio.Tipo">
            @foreach (var t in Enum.GetValues<TipoEstagio>())
            {
                <option value="@t">@Texto.Rotulo(t)</option>
            }
        </select>
        <button class="btn-primary" disabled="@Ocupado" @onclick="CriarEstagio">Adicionar</button>
    </div>
    <p class="pequeno mudo">Ganho/Perdido encerram o lead. Estágio com leads ou histórico não pode ser excluído: desative-o.
        Prazo: todo dia às 7 h, quem está parado na etapa além do prazo gera um alerta para o responsável.
        Próximo passo sugerido: já vem preenchido quando o lead muda para a etapa (0 dia = hoje).</p>
</section>

<IntegracoesConfig />

@code {
    private IReadOnlyList<ContaOrcamentaria>? categorias;
    private TipoConta novoTipo = TipoConta.DESPESA;
    private string novaCategoria = "";
    private Funil funil = Funil.VENDA;
    private List<FunilEstagio>? estagios;
    private EstagioForm novoEstagio = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarCategorias();
        await CarregarEstagios();
    }

    private Task CarregarCategorias() => Executar(async () => categorias = await Lancamentos.ContasAsync(incluirInativas: true));

    private Task CarregarEstagios() => Executar(async () => estagios = [.. await Crm.EstagiosAsync(funil)]);

    private Task RenomearCategoria(ContaOrcamentaria c, string? nome) => SalvarCategoria(c, nome ?? "", c.Ativo);

    private async Task SalvarCategoria(ContaOrcamentaria c, string nome, bool ativo)
    {
        await Executar(() => Lancamentos.AtualizarContaAsync(Usuario, c.Id, new ContaForm { Nome = nome, Tipo = c.Tipo, Ativo = ativo }));
        await CarregarCategorias();
    }

    private async Task CriarCategoria()
    {
        if (!await Executar(() => Lancamentos.CriarContaAsync(Usuario, new ContaForm { Nome = novaCategoria, Tipo = novoTipo }))) return;
        novaCategoria = "";
        await CarregarCategorias();
    }

    private async Task SincronizarIndices()
    {
        IReadOnlyDictionary<CodigoIndice, int>? r = null;
        if (await Executar(async () => r = await Indices.SincronizarAsync(Usuario)))
            Sucesso = "Índices atualizados: " + string.Join(", ", r!.Select(x => $"{x.Key} ({x.Value} mês(es))"));
    }

    private static TipoEstagio TipoDe(ChangeEventArgs v) => Enum.Parse<TipoEstagio>(v.Value?.ToString() ?? nameof(TipoEstagio.ABERTO));

    private static EstagioForm FormDe(FunilEstagio e) => EstagioForm.De(e);

    private static int? Numero(ChangeEventArgs v) => int.TryParse(v.Value?.ToString(), out var n) ? n : null;

    private async Task SalvarEstagio(FunilEstagio e, Action<EstagioForm> alterar)
    {
        var f = FormDe(e);
        alterar(f);
        await Executar(() => Crm.AtualizarEstagioAsync(Usuario, e.Id, f));
        await CarregarEstagios();
    }

    /// <summary>Troca a posição de dois estágios e grava a ordem 1..N de todos.</summary>
    private async Task Trocar(int a, int b)
    {
        (estagios![a], estagios[b]) = (estagios[b], estagios[a]);
        await Executar(() => Crm.ReordenarAsync(Usuario, [.. estagios.Select((e, i) => (e.Id, i + 1))]));
        await CarregarEstagios();
    }

    private async Task CriarEstagio()
    {
        novoEstagio.Funil = funil;
        novoEstagio.Ordem = (estagios?.Count > 0 ? estagios.Max(e => e.Ordem) : 0) + 1;
        if (!await Executar(() => Crm.CriarEstagioAsync(Usuario, novoEstagio))) return;
        novoEstagio = new EstagioForm();
        await CarregarEstagios();
    }

    private async Task ExcluirEstagio(FunilEstagio e)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Excluir o estágio {e.Nome}?")) return;
        if (await Executar(() => Crm.ExcluirEstagioAsync(Usuario, e.Id))) await CarregarEstagios();
    }
}
