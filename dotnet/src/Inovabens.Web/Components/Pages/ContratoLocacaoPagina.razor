@page "/locacao/{Id:guid}"
@attribute [Authorize(Policy = Permissoes.LocacaoVer)]
@inherits ComponenteBase
@inject LocacaoService Servico
@inject LocacaoDocumentosService Documentos
@inject ManutencaoService Manutencao
@inject VistoriaService Vistorias
@inject NavigationManager Nav

@* Ficha do contrato: dados, partes, faturas mês a mês (receber, ajustar, recibo), repasses aos locadores e, na fase 3,
   reajuste, renovação/aditivo, preferência na venda, rescisão com acerto e o histórico do contrato. *@

<PageTitle>@(d?.Codigo ?? "Contrato") · Locação · Inovabens</PageTitle>

<p class="pequeno"><a href="locacao">← Locação</a></p>
<MensagemErro Texto="@(ModalAberto ? null : Erro)" />
@if (Sucesso is not null) { <p class="aviso-vinculo" role="status">@Sucesso</p> }

@if (d is null)
{
    @if (Erro is null) { <p class="carregando">Carregando…</p> }
}
else
{
    var c = d.Contrato;
    <div class="titulo">
        <h1>@d.Codigo <span class="badge">@Texto.Rotulo(c.Status)</span></h1>
        <div class="acoes-topo">
            @if (PodeEditar && c.Status is StatusContratoLocacao.RASCUNHO or StatusContratoLocacao.ATIVO)
            {
                <button class="btn-ghost" @onclick="Editar">Editar</button>
            }
            @if (PodeEditar && c.Status == StatusContratoLocacao.RASCUNHO)
            {
                <button class="btn-ghost" @onclick="CancelarRascunho">Descartar rascunho</button>
                <button class="btn-primary" disabled="@Ocupado" @onclick="Ativar"
                        title="Confere as partes, marca o imóvel como locado e gera as primeiras faturas">Ativar contrato</button>
            }
            @if (PodeEditar && c.Status == StatusContratoLocacao.ATIVO)
            {
                <button class="btn-ghost" @onclick="AbrirAditivo" title="Mais prazo ou novo valor, com registro no histórico">Renovar / aditivo</button>
                <button class="btn-ghost" @onclick="AbrirPreferencia" title="Venda do imóvel locado: notificar o locatário (art. 27)">Preferência na venda</button>
                <button class="btn-ghost" @onclick="AbrirRescisao">Rescindir / encerrar</button>
            }
            @if (PodeReceber && c.Status == StatusContratoLocacao.ATIVO)
            {
                <button class="btn-ghost" disabled="@Ocupado" @onclick="GerarProxima" title="Gera já a fatura do próximo mês">Gerar próxima fatura</button>
            }
            @if (c.Status == StatusContratoLocacao.ENCERRADO && d.Historico.Any(h => h.Tipo == TipoHistoricoLocacao.RESCISAO))
            {
                <a class="btn-ghost" href="@($"locacao/{Id}/termo-rescisao.pdf")" download>Termo de rescisão</a>
            }
        </div>
    </div>

    <section class="card">
        <div class="titulo-secao"><h2>@d.ImovelCodigo · @d.ImovelTitulo</h2><a class="btn-ghost mini" href="@($"imoveis/{c.ImovelId}")">Ver imóvel</a></div>
        @if (d.ImovelEndereco is not null) { <p class="pequeno mudo">@d.ImovelEndereco</p> }
        <dl class="locacao-dados">
            <div><dt>Modalidade</dt><dd>@(c.Modalidade == ModalidadeLocacao.PROPRIO ? "Imóvel próprio / sócios" : "Administração de terceiros")</dd></div>
            <div><dt>Tipo</dt><dd>@Texto.Rotulo(c.Tipo)</dd></div>
            <div><dt>Vigência</dt><dd>@Texto.Data(c.Inicio) a @Texto.Data(c.Fim) (@c.PrazoMeses meses)</dd></div>
            <div><dt>Vencimento</dt><dd>dia @c.DiaVencimento @(c.PagamentoAntecipado ? "do próprio mês" : "do mês seguinte")</dd></div>
            <div><dt>Aluguel</dt><dd><b>@Texto.Moeda(c.ValorAluguel)</b></dd></div>
            <div><dt>Encargos mensais</dt><dd>Cond. @Texto.Moeda(c.ValorCondominio) · IPTU @Texto.Moeda(c.ValorIptu) · Seguro @Texto.Moeda(c.ValorSeguroIncendio)</dd></div>
            <div><dt>Reajuste</dt><dd>@(c.IndiceReajuste == CodigoIndice.IGPM ? "IGP-M" : c.IndiceReajuste.ToString()) a cada 12 meses</dd></div>
            <div><dt>Garantia</dt><dd>@PropostasService.Rotulo(c.Garantia)@(c.GarantiaValor is { } gv ? $" · {Texto.Moeda(gv)}" : "")@(c.GarantiaDetalhe is { } gd ? $" · {gd}" : "")@(c.GarantiaVence is { } gve ? $" · vence {Texto.Data(gve)}" : "")</dd></div>
            @if (c.SeguroIncendioVence is { } sv) { <div><dt>Seguro incêndio</dt><dd>vence @Texto.Data(sv)</dd></div> }
            @if (c.Modalidade == ModalidadeLocacao.ADMINISTRACAO)
            {
                <div><dt>Taxa de administração</dt><dd>@c.TaxaAdministracaoPct.ToString("0.##")%</dd></div>
                <div><dt>Intermediação</dt><dd>@Texto.Moeda(c.IntermediacaoValor) (retido @Texto.Moeda(d.IntermediacaoRetida))</dd></div>
                <div><dt>Repasse</dt><dd>@c.DiasRepasse dia(s) após receber</dd></div>
                <div><dt>Manutenção pré-aprovada</dt><dd>@(c.LimiteManutencao > 0 ? $"até {Texto.Moeda(c.LimiteManutencao)}" : "sempre pedir ao proprietário")</dd></div>
            }
            <div><dt>Atraso</dt><dd>multa @c.MultaAtrasoPct.ToString("0.##")% + juros @c.JurosMesPct.ToString("0.##")% a.m.</dd></div>
            <div><dt>Multa rescisória</dt><dd>@c.MultaRescisoriaAlugueis.ToString("0.#") aluguel(éis), proporcional</dd></div>
            <div><dt>Em caso de venda</dt><dd>@(c.ClausulaVigencia ? "cláusula de vigência" : "sem cláusula de vigência")@(c.Averbado ? " · averbado" : " · não averbado")</dd></div>
            @if (c.EncerradoEm is { } enc) { <div><dt>Encerrado em</dt><dd>@Texto.Data(enc)@(c.IniciativaRescisao is { } ini ? $" · {Texto.Rotulo(ini)}" : "") @c.MotivoEncerramento</dd></div> }
        </dl>
        @if (c.Observacoes is not null) { <p class="pequeno">@c.Observacoes</p> }
    </section>

    @if (c.Status == StatusContratoLocacao.ATIVO)
    {
        var hoje = DatasBR.Hoje();
        <section class="card">
            <div class="titulo-secao">
                <h2>Reajuste e vencimentos</h2>
                <button class="btn-ghost mini" disabled="@Ocupado" @onclick="CarregarPrevia">Ver prévia do reajuste</button>
            </div>
            <dl class="locacao-dados">
                <div><dt>Próximo reajuste</dt><dd class="@(c.ProximoReajuste <= hoje ? "texto-erro" : "")">@Texto.Data(c.ProximoReajuste)@(c.UltimoReajuste is { } ur ? $" (último em {Texto.Data(ur)})" : "")</dd></div>
                <div><dt>Fim do prazo</dt><dd class="@(c.Fim < hoje ? "texto-erro" : "")">@Texto.Data(c.Fim)@(c.Fim < hoje ? " · prorrogado por prazo indeterminado" : "")</dd></div>
                @if (c.PreferenciaNotificadaEm is { } pn)
                {
                    <div><dt>Preferência na venda</dt>
                        <dd>notificado em @Texto.Data(pn) · @Texto.Moeda(c.PreferenciaValor ?? 0) · prazo até @Texto.Data(c.PreferenciaPrazo!.Value)
                            · @(c.PreferenciaResposta is { } pr ? Texto.Rotulo(pr) : "aguardando resposta")
                            <a class="btn-ghost mini" href="@($"locacao/{Id}/preferencia.pdf")" download>Notificação</a>
                            @if (PodeEditar && c.PreferenciaResposta is null)
                            {
                                <button class="btn-ghost mini" disabled="@Ocupado" @onclick="() => Responder(RespostaPreferencia.ACEITA)">Aceitou</button>
                                <button class="btn-ghost mini" disabled="@Ocupado" @onclick="() => Responder(RespostaPreferencia.RECUSADA)">Recusou</button>
                                @if (hoje > c.PreferenciaPrazo)
                                {
                                    <button class="btn-ghost mini" disabled="@Ocupado" @onclick="() => Responder(RespostaPreferencia.SEM_RESPOSTA)">Sem resposta</button>
                                }
                            }
                        </dd>
                    </div>
                }
            </dl>
            @if (previa is not null)
            {
                <div class="previa-reajuste">
                    @if (previa.Percentual is { } pct)
                    {
                        <p>@Texto.Rotulo(previa.Indice) acumulado de @previa.De.ToString("MM/yyyy") a @previa.Ate.ToString("MM/yyyy"):
                            <b>@pct.ToString("0.####")%</b> · aluguel @Texto.Moeda(previa.ValorAtual) → <b>@Texto.Moeda(previa.ValorNovo)</b>
                            @if (previa.Negativo) { <span class="pequeno"> (índice negativo: o valor é mantido)</span> }</p>
                        <a class="btn-ghost mini" href="@($"locacao/{Id}/carta-reajuste.pdf")" download>Carta ao locatário</a>
                    }
                    else
                    {
                        <p class="texto-erro">Faltam índices de @string.Join(", ", previa.Faltando.Select(m => m.ToString("MM/yyyy"))):
                            sincronize os índices ou lance o mês à mão em Financeiro. Também dá para aplicar informando o valor combinado.</p>
                    }
                    @if (PodeEditar)
                    {
                        <button class="btn-primary mini" disabled="@Ocupado" @onclick="() => { reajustando = true; valorManual = null; Erro = null; }">Aplicar reajuste</button>
                    }
                </div>
            }
        </section>
    }

    <section class="card">
        <div class="titulo-secao"><h2>Partes</h2></div>
        <div class="tabela-container">
            <table class="tabela">
                <thead><tr><th>Papel</th><th>Nome</th><th>CPF/CNPJ</th><th>Contato</th><th class="num">% repasse</th><th></th></tr></thead>
                <tbody>
                    @foreach (var p in d.Partes)
                    {
                        <tr>
                            <td>@Texto.Rotulo(p.Papel)</td>
                            <td><a href="@($"pessoas?id={p.PessoaId}")">@p.Nome</a></td>
                            <td>@(p.CpfCnpj is null ? "—" : Formatos.Documento(p.CpfCnpj))</td>
                            <td>@(p.Contato ?? "—")</td>
                            <td class="num">@(p.Percentual?.ToString("0.##") ?? "")</td>
                            <td>
                                @if (p.Papel == PapelContratoLocacao.LOCADOR)
                                {
                                    <a class="btn-ghost mini" href="@($"locacao/extrato.pdf?pessoa={p.PessoaId}&mes={DatasBR.Hoje():yyyy-MM-01}")" download
                                       title="Extrato do proprietário no mês atual">Extrato do mês</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="card">
        <div class="titulo-secao">
            <h2>Documentos</h2>
            @if (Documentos.LinkPasta(c) is { } pasta)
            {
                <a class="btn-ghost mini" href="@pasta" target="_blank" rel="noopener">Abrir pasta no Drive</a>
            }
            else if (PodeEditar && Documentos.DriveHabilitado && c.Status != StatusContratoLocacao.RASCUNHO)
            {
                <button class="btn-ghost mini" disabled="@Ocupado" @onclick="CriarPasta" title="Cria a subpasta do contrato em 08 - Locação">Criar pasta no Drive</button>
            }
        </div>
        <p class="pequeno mudo">
            Contrato preenchido com os dados acima a partir de um modelo Word. Modelos próprios: Administração → Modelos.
            @(Documentos.DriveHabilitado ? "A pasta do contrato fica em \"08 - Locação\" no Drive do imóvel; renovações e aditivos usam a mesma." : "")
        </p>
        <div class="acoes-topo">
            <select class="input" @bind="modeloContrato" aria-label="Modelo do contrato">
                @foreach (var m in modelosContrato)
                {
                    <option value="@m.Id">@m.Nome</option>
                }
            </select>
            @if (modeloContrato is { } mc)
            {
                <a class="btn-ghost" href="@($"locacao/{Id}/documento?modelo={mc}")" download>Baixar contrato</a>
                @if (PodeEditar && Documentos.DriveHabilitado)
                {
                    <button class="btn-ghost" disabled="@Ocupado" @onclick="() => SalvarNoDrive(mc, null)">Salvar no Drive</button>
                }
            }
            @if (PodeEditar && Documentos.DriveHabilitado && c.Status != StatusContratoLocacao.RASCUNHO)
            {
                <label class="btn-ghost" title="Contrato assinado, laudo de vistoria, comprovantes…">
                    @(Ocupado ? "Enviando…" : "Enviar arquivo à pasta")
                    <InputFile OnChange="EnviarArquivo" class="oculto" disabled="@Ocupado" />
                </label>
            }
            @if (PodeEditar && d.Faturas.Any(x => x.Saldo > 0 && x.Vencimento < DatasBR.Hoje()))
            {
                <button class="btn-ghost" @onclick="AbrirAcordo" title="Parcelamento dos aluguéis em atraso, com termo de acordo">Acordo de atraso</button>
            }
        </div>
        <div class="acoes-topo">
            @if (d.Faturas.Any(x => x.Saldo > 0 && x.Atrasada(DatasBR.Hoje())))
            {
                <a class="btn-ghost" href="@($"locacao/{Id}/cobranca.pdf")" download title="Aviso amigável com as faturas vencidas atualizadas">Carta de cobrança</a>
                <a class="btn-ghost" href="@($"locacao/{Id}/cobranca.pdf?notificacao=true")" download
                   title="Notificação formal com prazo de 10 dias (arts. 9º, III, e 62 da Lei do Inquilinato); fiadores cientificados">Notificação de atraso</a>
            }
            @if (AnosComFatura.Count > 0)
            {
                <select class="input" @bind="anoQuitacao" aria-label="Ano da declaração">
                    @foreach (var a in AnosComFatura) { <option value="@a">@a</option> }
                </select>
                <a class="btn-ghost" href="@($"locacao/{Id}/quitacao.pdf?ano={anoQuitacao}")" download
                   title="Pagamentos do ano para o IR do inquilino e declaração de quitação">Declaração de quitação</a>
            }
        </div>
    </section>

    <section class="card">
        <div class="titulo-secao"><h2>Faturas</h2></div>
        @if (d.Faturas.Count == 0)
        {
            <p class="vazio">@(c.Status == StatusContratoLocacao.RASCUNHO ? "As faturas são geradas ao ativar o contrato." : "Nenhuma fatura ainda.")</p>
        }
        else
        {
            <div class="tabela-container">
                <table class="tabela">
                    <thead><tr><th>Ref.</th><th>Vencimento</th><th>Itens</th><th class="num">Total</th><th class="num">Recebido</th><th>Situação</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var f in d.Faturas)
                        {
                            <tr class="@(f.Status == StatusFaturaLocacao.CANCELADA ? "mudo" : "")">
                                <td>@f.Competencia.ToString("MM/yyyy")@if (f.Rescisao) { <div class="pequeno"><b>Acerto da rescisão</b></div> }</td>
                                <td class="nowrap @(f.Atrasada(DatasBR.Hoje()) ? "texto-erro" : "")">@Texto.Data(f.Vencimento)</td>
                                <td>
                                    @foreach (var i in f.Itens)
                                    {
                                        <div class="pequeno">
                                            @i.Descricao: @Texto.Moeda(i.Valor)
                                            @if (PodeReceber && f.Status == StatusFaturaLocacao.ABERTA && i.Tipo is not (TipoItemFatura.ALUGUEL or TipoItemFatura.CAUCAO))
                                            {
                                                <button class="btn-ghost mini" title="Remover item" @onclick="() => RemoverItem(f, i)"><Icone Nome="x" /></button>
                                            }
                                        </div>
                                    }
                                    @foreach (var p in f.Pagamentos)
                                    {
                                        <div class="pequeno @(p.Estornado ? "mudo" : "texto-ok")">
                                            Recibo @p.Recibo · @Texto.Data(p.Data) · @Texto.Moeda(p.Total)
                                            @if (p.Multa + p.Juros > 0) { <span>(multa/juros @Texto.Moeda(p.Multa + p.Juros))</span> }
                                            @if (p.Estornado) { <span> · estornado</span> }
                                            else
                                            {
                                                <a class="btn-ghost mini" href="@($"locacao/recibo/{p.Id}.pdf")" download>Recibo</a>
                                                @if (PodeReceber && !p.RepassePago)
                                                {
                                                    <button class="btn-ghost mini" @onclick="() => Estornar(p)">Estornar</button>
                                                }
                                            }
                                        </div>
                                    }
                                    @if (f.Observacao is not null) { <p class="pequeno mudo">@f.Observacao</p> }
                                </td>
                                <td class="num">@Texto.Moeda(f.Total)</td>
                                <td class="num">@Texto.Moeda(f.Pago)</td>
                                <td>
                                    <span class="badge @(f.Status == StatusFaturaLocacao.PAGA ? "badge-ok" : f.Atrasada(DatasBR.Hoje()) ? "badge-exclusao" : "")">
                                        @(f.Atrasada(DatasBR.Hoje()) ? "Em atraso" : Texto.Rotulo(f.Status))
                                    </span>
                                </td>
                                <td class="nowrap">
                                    @if (f.Status == StatusFaturaLocacao.ABERTA)
                                    {
                                        <a class="btn-ghost mini" href="@($"locacao/fatura/{f.Id}/segunda-via.pdf")" download
                                           title="Fatura em PDF; vencida, sai com multa e juros até hoje">2ª via</a>
                                    }
                                    @if (PodeReceber && f.Status == StatusFaturaLocacao.ABERTA)
                                    {
                                        <button class="btn-primary mini" @onclick="() => AbrirRecebimento(f)">Receber</button>
                                        <button class="btn-ghost mini" @onclick="() => AbrirItem(f)">+ Item</button>
                                        @if (f.Pago == 0)
                                        {
                                            <button class="btn-ghost mini" @onclick="() => { cancelando = f; motivo = null; Erro = null; }">Cancelar</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="pequeno mudo">Em aberto: @Texto.Moeda(d.Faturas.Sum(f => f.Saldo)) · recebido no contrato: @Texto.Moeda(d.Faturas.Sum(f => f.Pago))</p>
        }
    </section>

    <section class="card">
        <div class="titulo-secao">
            <h2>Vistorias</h2>
            <a class="btn-ghost mini" href="locacao?aba=vistorias">Todas</a>
        </div>
        @if (vistorias.Count == 0) { <p class="vazio">Nenhuma vistoria neste contrato.</p> }
        else
        {
            <ul class="lista-simples">
                @foreach (var x in vistorias)
                {
                    <li><a href="@($"locacao/vistoria/{x.Id}")"><b>@x.Codigo</b></a> @Texto.Rotulo(x.Tipo) <span class="badge">@Texto.Rotulo(x.Status)</span>
                        <span class="pequeno mudo">@(x.RealizadaEm is { } xr ? Texto.Data(xr) : x.AgendadaPara is { } xa ? "agendada " + Texto.DataHora(xa) : "sem data")@(x.Empresa is null ? "" : " · " + x.Empresa)@(x.TemLaudo ? " · laudo" : "")@(x.PendenciasAbertas > 0 ? $" · {x.PendenciasAbertas} pendência(s)" : "")</span></li>
                }
            </ul>
        }
        @if (PodeEditar && c.Status is StatusContratoLocacao.RASCUNHO or StatusContratoLocacao.ATIVO or StatusContratoLocacao.ENCERRADO)
        {
            <div class="acoes-topo"><button class="btn-ghost" @onclick="NovaVistoria">+ Vistoria</button></div>
        }
    </section>

    <section class="card">
        <div class="titulo-secao">
            <h2>Manutenção</h2>
            <a class="btn-ghost mini" href="manutencao">Todos os chamados</a>
        </div>
        @if (chamados.Count == 0) { <p class="vazio">Nenhum chamado neste contrato.</p> }
        else
        {
            <ul class="lista-simples">
                @foreach (var m in chamados)
                {
                    <li><a href="@($"manutencao/{m.Id}")"><b>@m.Codigo</b></a> @m.Titulo <span class="badge">@Texto.Rotulo(m.Status)</span>
                        <span class="pequeno mudo">@Texto.DataHora(m.CriadoEm)@(m.Valor is { } mv ? " · " + Texto.Moeda(mv) : "")</span></li>
                }
            </ul>
        }
        @if (PodeEditar && c.Status == StatusContratoLocacao.ATIVO)
        {
            <div class="acoes-topo">
                <button class="btn-ghost" @onclick="NovoChamado">+ Chamado</button>
                <button class="btn-ghost" disabled="@Ocupado" @onclick="LinkInquilino"
                        title="Link fixo deste contrato para o inquilino pedir reparos (com fotos), sem login">Link do inquilino</button>
            </div>
            @if (linkInquilino is not null)
            {
                <p class="pequeno">Link para o inquilino: <a href="@linkInquilino.Link" target="_blank" rel="noopener">@linkInquilino.Link</a>
                    @if (linkInquilino.LinkWhatsapp is { } lw) { <a class="btn-ghost mini" href="@lw" target="_blank" rel="noopener">Enviar pelo WhatsApp</a> }</p>
            }
        }
    </section>

    @if (c.Modalidade == ModalidadeLocacao.ADMINISTRACAO && d.Repasses.Count > 0)
    {
        <section class="card">
            <div class="titulo-secao"><h2>Repasses</h2><a class="btn-ghost mini" href="locacao?aba=repasses">A pagar</a></div>
            <div class="tabela-container">
                <table class="tabela">
                    <thead><tr><th>Ref.</th><th>Recibo</th><th>Locador</th><th class="num">Recebido</th><th class="num">Taxa</th><th class="num">Interm.</th><th class="num">Líquido</th><th>Repasse</th></tr></thead>
                    <tbody>
                        @foreach (var r in d.Repasses)
                        {
                            <tr class="@(r.Estornado ? "mudo" : "")">
                                <td>@r.Competencia.ToString("MM/yyyy")</td>
                                <td>@r.ReciboNumero.ToString("000000")</td>
                                <td>@r.Pessoa</td>
                                <td class="num">@Texto.Moeda(r.Bruto)</td>
                                <td class="num">@Texto.Moeda(r.Taxa)</td>
                                <td class="num">@Texto.Moeda(r.Intermediacao)</td>
                                <td class="num"><b>@Texto.Moeda(r.Liquido)</b></td>
                                <td class="nowrap">@(r.Estornado ? "estornado" : r.PagoEm is { } pg ? $"pago {Texto.Data(pg)}" : $"previsto {Texto.Data(r.PrevistoPara)}")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (d.Historico.Count > 0)
    {
        <section class="card">
            <div class="titulo-secao"><h2>Histórico do contrato</h2></div>
            <div class="tabela-container">
                <table class="tabela">
                    <thead><tr><th>Data</th><th>Tipo</th><th>Descrição</th><th class="num">Aluguel</th><th class="num">Prazo</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var h in d.Historico)
                        {
                            var mudaValor = h.Tipo is TipoHistoricoLocacao.REAJUSTE or TipoHistoricoLocacao.ADITIVO or TipoHistoricoLocacao.RENOVACAO;
                            <tr>
                                <td class="nowrap">@Texto.Data(h.Data)</td>
                                <td>@Texto.Rotulo(h.Tipo)</td>
                                <td class="pre-linha">@h.Descricao</td>
                                <td class="num nowrap">@(mudaValor && h.ValorNovo is { } vn ? $"{Texto.Moeda(h.ValorAnterior ?? 0)} → {Texto.Moeda(vn)}" : "")</td>
                                <td class="num nowrap">@(h.PrazoNovo is { } pz && pz != h.PrazoAnterior ? $"{h.PrazoAnterior} → {pz} meses" : "")</td>
                                <td>
                                    @if (h.Tipo == TipoHistoricoLocacao.REAJUSTE)
                                    {
                                        <a class="btn-ghost mini" href="@($"locacao/{Id}/carta-reajuste.pdf?historico={h.Id}")" download>Carta</a>
                                    }
                                    else if (h.Tipo == TipoHistoricoLocacao.ACORDO && modelosAcordo.Count > 0)
                                    {
                                        <a class="btn-ghost mini" href="@($"locacao/{Id}/documento?modelo={modelosAcordo[0].Id}&acordo={h.Id}")" download
                                           title="@($"Termo pelo modelo {modelosAcordo[0].Nome}")">Termo</a>
                                        @if (PodeEditar && Documentos.DriveHabilitado)
                                        {
                                            <button class="btn-ghost mini" disabled="@Ocupado" @onclick="() => SalvarNoDrive(modelosAcordo[0].Id, h.Id)">Drive</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}

