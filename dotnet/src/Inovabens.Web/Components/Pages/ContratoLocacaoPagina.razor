    private async Task AbrirRescisao()
    {
        Erro = null;
        rescisao = new RescisaoForm { EntregaChaves = DatasBR.Hoje() };
        // pendências do inquilino na vistoria de saída (com valor) entram como débito sugerido; pode ajustar
        await Executar(async () => debitosVistoria = await Vistorias.DebitosSaidaAsync(Usuario, Id));
        if (debitosVistoria is { Total: > 0 } dv) (rescisao.DebitosVistoria, rescisao.DescricaoVistoria) = (dv.Total, dv.Descricao);
        rescindindo = true;
        await SimularRescisao();
    }

    private async Task SimularRescisao()
    {
        if (rescisao.EntregaChaves is null) { acerto = null; return; }
        try { acerto = await Servico.SimularRescisaoAsync(Usuario, Id, rescisao); }
        catch (Exception) { acerto = null; } // valores incompletos: a validação aparece ao salvar
    }

    private async Task Rescindir()
    {
        if (await Executar(async () =>
            {
                await Servico.RescindirAsync(Usuario, Id, rescisao);
                // débito usado no acerto: as pendências da vistoria ficam como cobradas
                if (debitosVistoria is { Total: > 0 } dv && rescisao.DebitosVistoria > 0) await Vistorias.MarcarCobradasAsync(Usuario, dv.Pendencias);
            }))
        {
            rescindindo = false;
            await Carregar();
            Sucesso = "Contrato encerrado. O termo de rescisão está no topo da página.";
        }
    }
