@code {
    [Parameter] public Guid Id { get; set; }
    private IReadOnlyList<ModeloResumo> modelosContrato = [], modelosAcordo = [];
    private Guid? modeloContrato;
    private bool acordando;
    private AcordoForm acordo = new();
    private AcordoCalculo? calculoAcordo;

    private ContratoDetalhe? d;
    private IReadOnlyList<ChamadoLinha> chamados = [];
    private ChamadoForm? novoChamado;
    private IReadOnlyList<VistoriaLinha> vistorias = [];
    private VistoriaForm? novaVistoria;
    private DebitosVistoria? debitosVistoria;
    private LinkInquilino? linkInquilino;
    private ContratoForm? editando;
    private FaturaDetalhe? recebendo, itemFatura, cancelando;
    private RecebimentoLocacaoForm receb = new();
    private ItemAvulsoForm item = new();
    private IReadOnlyList<Opcao> contas = [];
    private decimal saldo;
    private int diasAtraso;
    private string? motivo;
    private ReajustePrevia? previa;
    private bool reajustando, aditivando, notificando, rescindindo;
    private decimal? valorManual;
    private AditivoForm aditivo = new();
    private PreferenciaForm preferencia = new();
    private RescisaoForm rescisao = new();
    private int anoQuitacao = DatasBR.Hoje().Month <= 2 ? DatasBR.Hoje().Year - 1 : DatasBR.Hoje().Year;
    private IReadOnlyList<int> AnosComFatura => d is null ? [] : [.. d.Faturas.Select(f => f.Competencia.Year)
        .Concat(d.Faturas.SelectMany(f => f.Pagamentos).Select(p => p.Data.Year)).Distinct().OrderDescending()];
    private RescisaoCalculo? acerto;

    private bool PodeEditar => Usuario.Pode(Permissoes.LocacaoEditar);
    private bool PodeReceber => Usuario.Pode(Permissoes.LocacaoReceber);
    private bool ModalAberto => editando is not null || recebendo is not null || itemFatura is not null || cancelando is not null
        || reajustando || aditivando || notificando || rescindindo || acordando;

    protected override Task OnParametersSetAsync() => Carregar();

    private async Task Carregar() => await Executar(async () =>
    {
        d = await Servico.ObterAsync(Usuario, Id);
        chamados = await Manutencao.ListarAsync(Usuario, new FiltroChamados(SoAbertos: false, ContratoId: Id));
        vistorias = await Vistorias.ListarAsync(Usuario, Id);
        if (modelosContrato.Count == 0)
        {
            modelosContrato = await Documentos.ModelosAsync(Usuario, TipoModeloDocumento.CONTRATO_LOCACAO);
            modelosAcordo = await Documentos.ModelosAsync(Usuario, TipoModeloDocumento.ACORDO_LOCACAO);
            modeloContrato = modelosContrato.FirstOrDefault()?.Id;
        }
    });

    /* ---------- manutenção ---------- */

    private void NovoChamado()
    {
        Erro = null;
        novoChamado = new ChamadoForm { ImovelId = d!.Contrato.ImovelId, ContratoId = Id, SolicitanteNome = d.Partes.FirstOrDefault(p => p.Papel == PapelContratoLocacao.LOCATARIO)?.Nome };
    }

    /// <summary>Sugere o tipo: entrada no início; saída se já houver entrada realizada.</summary>
    private void NovaVistoria()
    {
        Erro = null;
        var temEntrada = vistorias.Any(x => x.Tipo == TipoVistoria.ENTRADA && x.Status != StatusVistoria.CANCELADA);
        novaVistoria = new VistoriaForm { ContratoId = Id, Tipo = temEntrada ? TipoVistoria.SAIDA : TipoVistoria.ENTRADA };
    }

    private async Task LinkInquilino() => await Executar(async () => linkInquilino = await Manutencao.LinkInquilinoAsync(Usuario, Id));

    /* ---------- documentos e Drive ---------- */

    private async Task CriarPasta()
    {
        if (await Executar(() => Documentos.GarantirPastaAsync(Usuario, Id)))
        {
            await Carregar();
            Sucesso = "Pasta do contrato criada no Drive.";
        }
    }

    private async Task SalvarNoDrive(Guid modelo, Guid? acordoId)
    {
        DocumentoSalvo? r = null;
        if (await Executar(async () => r = await Documentos.SalvarNoDriveAsync(Usuario, Id, modelo, acordoId)))
        {
            await Carregar();
            Sucesso = $"{r!.Nome} guardado na pasta do contrato no Drive.";
        }
    }

    private async Task EnviarArquivo(InputFileChangeEventArgs e)
    {
        DocumentoSalvo? r = null;
        var ok = await Executar(async () =>
        {
            if (e.File.Size > ImoveisService.TamanhoMaximoArquivo) throw new RegraNegocioException("arquivo", "Arquivo acima de 25 MB.");
            await using var s = e.File.OpenReadStream(ImoveisService.TamanhoMaximoArquivo);
            using var ms = new MemoryStream();
            await s.CopyToAsync(ms);
            r = await Documentos.EnviarArquivoAsync(Usuario, Id, e.File.Name, ms.ToArray(),
                string.IsNullOrEmpty(e.File.ContentType) ? "application/octet-stream" : e.File.ContentType);
        });
        if (ok)
        {
            await Carregar();
            Sucesso = $"{r!.Nome} enviado para a pasta do contrato.";
        }
    }

