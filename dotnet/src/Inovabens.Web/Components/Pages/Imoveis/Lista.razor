@page "/imoveis"
@attribute [Authorize(Policy = Permissoes.ImoveisVer)]
@inherits ComponenteBase
@using Microsoft.AspNetCore.WebUtilities
@implements IDisposable
@inject ImoveisService Servico
@inject OpcoesService Opcoes
@inject CadastrosService Cadastros
@inject NavigationManager Nav

<PageTitle>Imóveis · Inovabens</PageTitle>

<div class="titulo">
    <h1>Imóveis</h1>
    <div class="abas abas-visao">
        <button class="aba @(Mapa ? "" : "ativa")" @onclick="() => TrocarVisao(false)">☰ Lista</button>
        <button class="aba @(Mapa ? "ativa" : "")" @onclick="() => TrocarVisao(true)">🗺️ Mapa</button>
    </div>
    @if (Usuario.Pode(Permissoes.ImoveisExportarLista))
    {
        @* planilha com as informações da lista (sem fotos), nos filtros atuais e com todas as páginas *@
        <a class="btn-ghost" href="@LinkExcel" download title="Baixar a lista filtrada em Excel">⬇ Exportar Excel</a>
    }
    @if (Usuario.Pode(Permissoes.ImoveisCriar))
    {
        <a class="btn-primary" href="imoveis/novo">+ Novo imóvel</a>
    }
</div>

@if (!Mapa)
{
    @BarraFiltros
}

<MensagemErro Texto="@Erro" />

@if (Mapa)
{
    @if (pontos is null)
    {
        <p class="carregando">Carregando…</p>
    }
    else
    {
        <MapaImoveis Itens="pontos" FiltroAtivo="FiltroAtivo" Filtros="BarraFiltros" AoFechar="() => TrocarVisao(false)" />
    }
}
else if (resultado is null)
{
    <p class="carregando">Carregando…</p>
}
else if (resultado.Itens.Count == 0)
{
    <p class="vazio">Nenhum imóvel encontrado.</p>
}
else
{
    <div class="tabela-container">
        <table class="tabela">
            <thead>
                <tr><th class="col-capa"><span class="sr-only">Foto</span></th><th>Código</th><th>Imóvel</th><th>Local</th><th>Situação</th><th>Preço</th><th>Corretor</th><th>Site</th></tr>
            </thead>
            <tbody>
                @foreach (var i in resultado.Itens)
                {
                    <tr>
                        <td class="col-capa">
                            <a href="imoveis/@i.Id" tabindex="-1" aria-hidden="true">
                                @if (i.CapaUrl is { } capa)
                                {
                                    @* no computador a miniatura tem 64 px: o navegador escolhe a versão de 160 px; no celular (cartão largo), a de 400 *@
                                    <img class="miniatura-imovel" src="@capa" srcset="@SrcsetCapa(capa)" sizes="@(SrcsetCapa(capa) is null ? null : "(max-width: 640px) 100vw, 64px")" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <img class="miniatura-imovel" src="img/sem-foto.svg" alt="" />
                                }
                            </a>
                        </td>
                        <td class="codigo"><a href="imoveis/@i.Id">@i.Codigo</a></td>
                        <td>
                            <a class="forte" href="imoveis/@i.Id">@i.Titulo</a>
                            <p class="pequeno mudo">@Texto.Rotulo(i.Tipo) · @Texto.Rotulo(i.Finalidade)</p>
                        </td>
                        <td>@Local(i)</td>
                        <td><span class="badge">@Texto.Rotulo(i.Situacao)</span></td>
                        <td>@Texto.Moeda(i.PrecoVenda ?? i.PrecoLocacao)</td>
                        <td>@(i.CorretorNome ?? "—")</td>
                        <td><a class="btn-ghost mini" href="imoveis/@i.Id/site" target="_blank" rel="noopener"
                               title="Ver como aparece no site público">🌐 Site</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@if (!Mapa && resultado is not null)
{
    <Paginacao Pagina="pagina" Total="resultado.Total" TamanhoPagina="resultado.TamanhoPagina" AoMudar="IrPara" />
}

@code {
    // só a foto entregue pelo sistema (?l=400) tem a versão de 160 px; a publicada no R2 tem 400/1200/1920
    private static readonly string SufixoMiniatura = $"?l={ImoveisService.LarguraMiniatura}";
    private static string? SrcsetCapa(string capa) => capa.EndsWith(SufixoMiniatura, StringComparison.Ordinal)
        ? $"{capa[..^SufixoMiniatura.Length]}?l={ImoveisService.LarguraIcone} {ImoveisService.LarguraIcone}w, {capa} {ImoveisService.LarguraMiniatura}w"
        : null;

    /// <summary>?visao=mapa abre direto no mapa (dá para mandar o link).</summary>
    [SupplyParameterFromQuery(Name = "visao")] public string? Visao { get; set; }

    private bool Mapa => string.Equals(Visao, "mapa", StringComparison.OrdinalIgnoreCase);

    /// <summary>Barra de filtros: na lista fica no topo da página; no mapa, na barra do mapa em tela cheia.</summary>
    private RenderFragment BarraFiltros => __builder =>
    {
        <div class="filtros">
            <input class="input busca" aria-label="Buscar imóveis" placeholder="Buscar por código, título, endereço…"
                   @bind="termo" @bind:event="oninput" @bind:after="AoDigitar" />
            <select class="input filtro" aria-label="Situação" @bind="situacao" @bind:after="Filtrar">
                <option value="">Todas as situações</option>
                @foreach (var s in Enum.GetValues<SituacaoImovel>())
                {
                    <option value="@s">@Texto.Rotulo(s)</option>
                }
            </select>
            <select class="input filtro" aria-label="Tipo" @bind="tipo" @bind:after="Filtrar">
                <option value="">Todos os tipos</option>
                @foreach (var t in tipos)
                {
                    <option value="@t">@Texto.Rotulo(t)</option>
                }
            </select>
            <select class="input filtro" aria-label="Cidade" @bind="cidade" @bind:after="Filtrar">
                <option value="">Todas as cidades</option>
                @* a cidade já escolhida continua na lista mesmo sem imóvel disponível (veio de um link, por exemplo) *@
                @foreach (var c in cidade != "" && !cidades.Contains(cidade) ? cidades.Append(cidade).Order().ToList() : cidades)
                {
                    <option value="@c">@c</option>
                }
            </select>
            @if (!Usuario.EscopoProprio)
            {
                <select class="input filtro" aria-label="Corretor" @bind="corretor" @bind:after="Filtrar">
                    <option value="">Todos os corretores</option>
                    @foreach (var c in corretores)
                    {
                        <option value="@c.Id">@c.Nome</option>
                    }
                </select>
            }
        </div>
    };

    /// <summary>Algum filtro além do padrão (só disponíveis)? Sem filtro, o mapa abre em Rio Preto (raio de 20 km).</summary>
    private bool FiltroAtivo => !string.IsNullOrWhiteSpace(termo) || tipo != "" || cidade != "" || corretor != ""
        || situacao != nameof(SituacaoImovel.DISPONIVEL);

    private Paginado<ImovelListaItem>? resultado;
    private IReadOnlyList<ImovelMapaItem>? pontos;
    private IReadOnlyList<string> tipos = [];
    private IReadOnlyList<string> cidades = [];
    private IReadOnlyList<Opcao> corretores = [];
    private string tipo = "";
    private string cidade = "";
    private string corretor = "";
    private bool? mapaCarregado;
    private string termo = "";
    /// <summary>Começa mostrando só os disponíveis; "Todas as situações" continua no filtro.</summary>
    private string situacao = nameof(SituacaoImovel.DISPONIVEL);
    private int pagina = 1;
    private CancellationTokenSource? espera;

    protected override Task OnInitializedAsync() => Executar(async () =>
    {
        tipos = [.. (await Cadastros.TiposImovelAsync(incluirInativos: true)).Select(t => t.Nome)];
        cidades = await Servico.CidadesAsync(Usuario);
        if (!Usuario.EscopoProprio) corretores = await Opcoes.CorretoresAsync();
    });

    /// <summary>Carrega a visão atual quando ela muda (inclusive pelo link com ?visao=mapa).</summary>
    protected override Task OnParametersSetAsync() => mapaCarregado == Mapa ? Task.CompletedTask : Carregar();

    private FiltroImoveis Filtro => new()
    {
        Termo = termo,
        Situacao = Enum.TryParse<SituacaoImovel>(situacao, out var s) ? s : null,
        Tipo = tipo,
        Cidade = cidade,
        CorretorId = Guid.TryParse(corretor, out var c) ? c : null,
        Pagina = pagina,
        TamanhoPagina = 25,
    };

    /// <summary>Download com os filtros atuais (os vazios ficam de fora; QueryHelpers ignora valor nulo).</summary>
    private string LinkExcel => QueryHelpers.AddQueryString("imoveis/lista.xlsx", new Dictionary<string, string?>
    {
        ["termo"] = Texto.Limpo(termo), ["situacao"] = Texto.Limpo(situacao), ["tipo"] = Texto.Limpo(tipo),
        ["cidade"] = Texto.Limpo(cidade), ["corretor"] = Usuario.EscopoProprio ? null : Texto.Limpo(corretor),
    });

    private Task Carregar() => Executar(async () =>
    {
        mapaCarregado = Mapa;
        if (Mapa) pontos = await Servico.ListarParaMapaAsync(Usuario, Filtro);
        else resultado = await Servico.ListarAsync(Usuario, Filtro);
    });

    private void TrocarVisao(bool mapa) =>
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("visao", mapa ? "mapa" : null), replace: true);

    /// <summary>Espera o usuário parar de digitar (300 ms) antes de consultar.</summary>
    private async Task AoDigitar()
    {
        espera?.Cancel();
        espera = new CancellationTokenSource();
        try { await Task.Delay(300, espera.Token); }
        catch (TaskCanceledException) { return; }
        await Filtrar();
    }

    private Task Filtrar()
    {
        pagina = 1;
        return Carregar();
    }

    private Task IrPara(int p)
    {
        pagina = p;
        return Carregar();
    }

    private static string Local(ImovelListaItem i)
    {
        var cidade = i.Cidade is null ? null : i.Cidade + (i.Uf is null ? "" : "/" + i.Uf);
        var partes = new[] { i.Bairro, cidade }.Where(x => !string.IsNullOrEmpty(x));
        return partes.Any() ? string.Join(" · ", partes) : "—";
    }

    public void Dispose() => espera?.Cancel();
}
