@page "/imoveis/{Id:guid}"
@attribute [Authorize(Policy = Permissoes.ImoveisVer)]
@inherits ComponenteBase
@inject ImoveisService Servico
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(detalhe?.Dados.Codigo ?? "Imóvel") · Inovabens</PageTitle>

<nav class="trilha" aria-label="Trilha"><a href="imoveis">Imóveis</a><span class="sep" aria-hidden="true">›</span><span aria-current="page">@(detalhe?.Dados.Codigo ?? "Imóvel")</span></nav>

@if (detalhe is null)
{
    if (Erro is null)
    {
        <p class="carregando">Carregando…</p>
    }
    else
    {
        <MensagemErro Texto="@Erro" />
    }
}
else
{
    <div class="cabecalho-imovel">
        <div>
            <p class="codigo">@detalhe.Dados.Codigo</p>
            <h1>@detalhe.Dados.Titulo</h1>
            <span class="badge">@Texto.Rotulo(detalhe.Dados.Situacao)</span>
            @if (LinkMapa is { } mapa)
            {
                <a class="pequeno" href="@mapa" target="_blank" rel="noreferrer">📍 Ver no Google Maps</a>
            }
        </div>
        <div class="acoes-topo">
            <a class="btn-ghost" href="imoveis/@Id/site" target="_blank" rel="noopener"
               title="Abre o imóvel como ele aparece no site público da Inovabens">🌐 Ver no site</a>
            @if (Usuario.Pode(Permissoes.ImoveisExportar))
            {
                <a class="btn-ghost" href="imoveis/@Id/ficha.pdf" download>Ficha PDF</a>
                <a class="btn-ghost" href="imoveis/@Id/ficha.xlsx" download>Ficha Excel</a>
            }
            @if (Usuario.EhAdministrador && Usuario.Pode(Permissoes.ImoveisExcluir))
            {
                <button class="btn-perigo" disabled="@Ocupado" @onclick="Excluir">Excluir imóvel</button>
            }
        </div>
    </div>
    <MensagemErro Texto="@Erro" />

    <div class="abas">
        <button class="aba @(aba == Aba.Ficha ? "ativa" : "")" @onclick="() => aba = Aba.Ficha">Ficha</button>
        @if (Usuario.Pode(Permissoes.FinanceiroVer))
        {
            <button class="aba @(aba == Aba.Financeiro ? "ativa" : "")" @onclick="() => aba = Aba.Financeiro">Financeiro</button>
        }
        @if (Usuario.Pode(Permissoes.FinanceiroInvestimento))
        {
            <button class="aba @(aba == Aba.Investimento ? "ativa" : "")" @onclick="() => aba = Aba.Investimento">Investimento</button>
        }
        <button class="aba @(aba == Aba.Regularizacao ? "ativa" : "")" @onclick="() => aba = Aba.Regularizacao">Regularização</button>
        @if (Usuario.Pode(Permissoes.MemorandosVer))
        {
            <button class="aba @(aba == Aba.Memorandos ? "ativa" : "")" @onclick="() => aba = Aba.Memorandos">Memorandos</button>
        }
        @if (Usuario.Pode(Permissoes.AgendaVer))
        {
            <button class="aba @(aba == Aba.Agenda ? "ativa" : "")" @onclick="() => aba = Aba.Agenda">Agenda</button>
        }
        @if (Usuario.Pode(Permissoes.CrmVer))
        {
            <button class="aba @(aba == Aba.Interessados ? "ativa" : "")" @onclick="() => aba = Aba.Interessados">Interessados</button>
        }
        @if (Usuario.Pode(Permissoes.ChavesVer))
        {
            <button class="aba @(aba == Aba.Chaves ? "ativa" : "")" @onclick="() => aba = Aba.Chaves">Chaves</button>
        }
        <button class="aba @(aba == Aba.Redes ? "ativa" : "")" @onclick="() => aba = Aba.Redes">Redes sociais</button>
    </div>

    @if (aba == Aba.Ficha)
    {
        <section class="card">
            <h2>Dados do imóvel</h2>
            @if (Editar)
            {
                <ImovelFormulario Form="form" AoSalvar="Salvar" />
            }
            else
            {
                <p class="mudo">Você não tem permissão para editar este imóvel.</p>
            }
        </section>
        <ProprietariosEditor Detalhe="detalhe" Editar="Editar" AoSalvar="Recarregar" />
        <EnvolvidosCard Detalhe="detalhe" />
        <CaracteristicasEditor Detalhe="detalhe" Editar="Editar" AoSalvar="Recarregar" />
        <MidiasEditor Detalhe="detalhe" Editar="Editar" AoSalvar="Recarregar" />
    }
    else if (aba == Aba.Financeiro)
    {
        <LancamentosFinanceirosAba ImovelId="Id" />
    }
    else if (aba == Aba.Investimento && Usuario.Pode(Permissoes.FinanceiroInvestimento))
    {
        <InvestimentoAba ImovelId="Id" AoAlterarImovel="Recarregar" />
    }
    else if (aba == Aba.Memorandos)
    {
        <MemorandosAba ImovelId="Id" />
        <EnvioDrive ImovelId="Id" AoEnviar="Recarregar" />
    }
    else if (aba == Aba.Agenda)
    {
        <AgendaImovelAba ImovelId="Id" />
        <EnvioDrive ImovelId="Id" AoEnviar="Recarregar" />
    }
    else if (aba == Aba.Interessados)
    {
        <InteressadosAba ImovelId="Id" />
    }
    else if (aba == Aba.Chaves && Usuario.Pode(Permissoes.ChavesVer))
    {
        <ChavesAba ImovelId="Id" />
    }
    else if (aba == Aba.Redes)
    {
        <RedesSociaisAba Detalhe="detalhe" />
    }
    else
    {
        <RegularizacoesAba ImovelId="Id" Editar="Editar" />
        <EnvioDrive ImovelId="Id" PastaPadrao="SubpastasDrive.Protocolos" AoEnviar="Recarregar" />
    }
}

@if (previaExclusao is { } previa)
{
    <ExcluirComSenha Titulo="Excluir imóvel" Nome="imóvel" Previa="previa" Confirmar="ConfirmarExclusao" AoFechar="() => previaExclusao = null" />
}

@code {
    private enum Aba { Ficha, Financeiro, Investimento, Regularizacao, Memorandos, Agenda, Interessados, Chaves, Redes }

    [Parameter] public Guid Id { get; set; }
    /// <summary>?aba=lancamentos abre direto nos Lançamentos Financeiros (link da tela de títulos em atraso).</summary>
    [SupplyParameterFromQuery(Name = "aba")] public string? AbaInicial { get; set; }

    private ImovelDetalhe? detalhe;
    private ImovelForm form = new();
    private Aba aba = Aba.Ficha;

    private bool Editar => Usuario.Pode(Permissoes.ImoveisEditar);

    private string? LinkMapa => detalhe?.Dados is { } d
        ? RegrasImovel.LinkGoogleMaps(d.Latitude, d.Longitude, RegrasImovel.EnderecoParaMapa(d.Logradouro, d.Numero, d.Bairro, d.Cidade, d.Uf, d.Cep))
        : null;

    protected override void OnInitialized()
    {
        if (AbaInicial == "lancamentos" && Usuario.Pode(Permissoes.FinanceiroVer)) aba = Aba.Financeiro;
        if (AbaInicial == "chaves" && Usuario.Pode(Permissoes.ChavesVer)) aba = Aba.Chaves;
    }

    protected override Task OnParametersSetAsync() => Recarregar();

    private Task Recarregar() => Executar(async () =>
    {
        detalhe = await Servico.DetalheAsync(Usuario, Id);
        form = ImovelForm.De(detalhe.Dados);
    });

    private async Task Salvar(ImovelForm f)
    {
        await Servico.AtualizarAsync(Usuario, Id, f);
        await Recarregar();
    }

    /// <summary>Exclusão com confirmação reforçada: lista o que vai junto, "Concordo" e senha (regra do sistema).</summary>
    private PreviaExclusao? previaExclusao;

    private async Task Excluir() => await Executar(async () => previaExclusao = await Servico.PreviaExclusaoAsync(Usuario, Id));

    private async Task ConfirmarExclusao(string senha)
    {
        await Servico.ExcluirAsync(Usuario, Id, senha);
        previaExclusao = null;
        Nav.NavigateTo("imoveis");
    }
}
