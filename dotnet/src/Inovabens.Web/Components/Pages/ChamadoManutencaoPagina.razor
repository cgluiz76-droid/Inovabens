    /* ---------- agenda ---------- */

    private async Task AbrirAgenda()
    {
        Erro = null;
        await Executar(async () =>
        {
            if (equipe.Count == 0) equipe = await Opcoes.CorretoresAsync();
            // chaves: só com permissão de movimentar; sem ela o agendamento segue sem a entrega
            chaves = Usuario.Pode(Permissoes.ChavesMovimentar)
                ? [.. (await Chaves.DoImovelAsync(Usuario, d!.Chamado.ImovelId)).Chaves.Where(k => k.Fora is null)]
                : [];
            var amanha = DatasBR.Hoje().AddDays(1).ToDateTime(new TimeOnly(9, 0));
            agendando = new AgendamentoForm { Inicio = amanha };
        });
    }

    private async Task Agendar()
    {
        if (agendando is null) return;
        if (await Executar(async () => avisos = await Servico.AgendarAsync(Usuario, Id, agendando)))
        {
            agendando = null;
            await Carregar();
            Sucesso = "Serviço agendado.";
        }
    }

    /* ---------- conclusão ---------- */

    private void AbrirConclusao()
    {
        Erro = null;
        var c = d!.Chamado;
        concluindo = new ConclusaoForm
        {
            Data = DatasBR.Hoje(), ValorFinal = c.Valor, Cobranca = ManutencaoService.CobrancaSugerida(c.Responsavel, d.Modalidade),
            VencimentoPrestador = DatasBR.Hoje().AddDays(7),
        };
    }

    private async Task Concluir()
    {
        if (concluindo is null) return;
        if (await Executar(() => Servico.ConcluirAsync(Usuario, Id, concluindo)))
        {
            concluindo = null;
            await Carregar();
            Sucesso = "Serviço concluído e custo lançado.";
        }
    }

    private static string RotuloCobranca(CobrancaManutencao c) => c switch
