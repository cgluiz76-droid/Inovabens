    {
        CobrancaManutencao.REPASSE => "A imobiliária paga o prestador (conta a pagar no Financeiro) e o valor sai dos próximos repasses do proprietário.",
        CobrancaManutencao.FATURA => "A imobiliária paga o prestador e o valor entra como item na próxima fatura aberta do inquilino, sem ir para o repasse.",
        CobrancaManutencao.IMOVEL => "Conta a pagar no financeiro do próprio imóvel (imóveis próprios ou de sócios).",
        CobrancaManutencao.IMOBILIARIA => "Despesa da Inova Bens, na categoria \"Manutenção de imóveis\".",
        CobrancaManutencao.DIRETO => "Proprietário ou inquilino pagou o prestador; o sistema só registra.",
        _ => "",
    };

    /* ---------- arquivos ---------- */

    private async Task EnviarArquivo(InputFileChangeEventArgs e)
    {
        var ok = await Executar(async () =>
        {
            if (e.File.Size > ImoveisService.TamanhoMaximoArquivo) throw new RegraNegocioException("arquivo", "Arquivo acima de 25 MB.");
            await using var s = e.File.OpenReadStream(ImoveisService.TamanhoMaximoArquivo);
            using var ms = new MemoryStream();
            await s.CopyToAsync(ms);
            await Servico.EnviarArquivoAsync(Usuario, Id, e.File.Name, ms.ToArray(),
                string.IsNullOrEmpty(e.File.ContentType) ? "application/octet-stream" : e.File.ContentType, tipoArquivo);
        });
        if (ok)
        {
            await Carregar();
            Sucesso = $"{e.File.Name} enviado para a pasta do chamado.";
        }
    }
}
