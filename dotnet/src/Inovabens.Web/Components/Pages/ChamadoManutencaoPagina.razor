        CobrancaManutencao.FATURA => "Cobrar do inquilino na próxima fatura",
        CobrancaManutencao.IMOVEL => "Conta do imóvel (financeiro do imóvel)",
        CobrancaManutencao.IMOBILIARIA => "Despesa da imobiliária",
        _ => "Pago direto ao prestador (sem lançamento)",
    };

