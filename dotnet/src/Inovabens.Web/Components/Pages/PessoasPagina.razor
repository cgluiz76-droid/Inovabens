@page "/pessoas"
@attribute [Authorize(Policy = Permissoes.PessoasVer)]
@inherits ComponenteBase
@using Microsoft.AspNetCore.WebUtilities
@implements IDisposable
@inject PessoasService Servico
@inject CadastrosService Cadastros
@inject OpcoesService Opcoes
@inject IJSRuntime JS

<PageTitle>Pessoas · Inovabens</PageTitle>

<div class="titulo">
    <h1>Pessoas</h1>
    <div class="acoes-topo">
        @if (Usuario.Pode(Permissoes.PessoasExportarLista))
        {
            @* planilha com as informações da lista, nos filtros atuais e com todas as páginas *@
            <a class="btn-ghost" href="@LinkExcel" download title="Baixar a lista filtrada em Excel">⬇ Exportar Excel</a>
        }
        @if (Usuario.Pode(Permissoes.PessoasCriar))
        {
            <button class="btn-primary" @onclick="Nova">+ Nova pessoa</button>
        }
    </div>
</div>

<div class="filtros">
    <input class="input busca" placeholder="Buscar por nome, CPF/CNPJ, e-mail ou telefone…"
           @bind="termo" @bind:event="oninput" @bind:after="AoDigitar" />
    <select @key="perfis" class="input filtro" aria-label="Papel" @bind="papel" @bind:after="Filtrar">
        <option value="">Todos os perfis</option>
        @foreach (var p in perfis)
        {
            <option value="@p.Codigo">@p.Nome</option>
        }
    </select>
</div>

<MensagemErro Texto="@Erro" />

@if (resultado is null)
{
    <p class="carregando">Carregando…</p>
}
else if (resultado.Itens.Count == 0)
{
    <p class="vazio">Nenhuma pessoa encontrada.</p>
}
else
{
    <div class="tabela-container">
        <table class="tabela">
            <thead>
                <tr><th>Nome / Razão social</th><th>CPF/CNPJ</th><th>Contato</th><th>Perfis</th><th>Imóveis</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var p in resultado.Itens)
                {
                    <tr>
                        <td>
                            @* clique no nome: ficha só de leitura, sem precisar abrir a edição *@
                            <button type="button" class="link-atividade forte" title="Ver os dados da pessoa" @onclick="() => Ver(p)">@p.NomeRazao</button>
                            <p class="pequeno mudo">@(p.Tipo == TipoPessoa.PF ? "Pessoa física" : "Pessoa jurídica")@(p.Cidade is null ? "" : $" · {p.Cidade}/{p.Uf}")</p>
                        </td>
                        <td>@Formatos.Documento(p.CpfCnpj)</td>
                        <td>
                            @(p.Telefone ?? p.Whatsapp ?? "—")
                            @if (p.Email is not null)
                            {
                                <p class="pequeno mudo">@p.Email</p>
                            }
                        </td>
                        <td>
                            @foreach (var x in p.Papeis)
                            {
                                <span class="badge" title="@x.Especialidade">@NomePerfil(x.Papel)</span>
                            }
                            @if (p.Papeis.Select(x => x.Especialidade).FirstOrDefault(e => e is not null) is { } esp)
                            {
                                <p class="pequeno mudo">@esp</p>
                            }
                        </td>
                        <td class="pequeno">@(codigosImoveis.TryGetValue(p.Id, out var cods) ? string.Join(", ", cods) : "—")</td>
                        <td class="acoes-linha">
                            <button class="btn-ghost mini" @onclick="() => Editar(p)">@(PodeEditar ? "Editar" : "Ver")</button>
                            @if (Usuario.Pode(Permissoes.PessoasExcluir))
                            {
                                <button class="btn-ghost mini texto-erro" disabled="@Ocupado" @onclick="() => Excluir(p)">Excluir</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Paginacao Pagina="pagina" Total="resultado.Total" TamanhoPagina="resultado.TamanhoPagina" AoMudar="IrPara" />
}

@if (ficha is { } f)
{
    var x = f.Pessoa;
    <Modal Titulo="@x.NomeRazao" Largo AoFechar="() => ficha = null">
        <div class="ficha-pessoa">
            <section>
                <h3>Dados e contato</h3>
                <dl>
                    <dt>Tipo</dt><dd>@(x.Tipo == TipoPessoa.PF ? "Pessoa física" : "Pessoa jurídica")</dd>
                    <dt>@(x.Tipo == TipoPessoa.PF ? "CPF" : "CNPJ")</dt><dd>@(Formatos.Documento(x.CpfCnpj) ?? "—")</dd>
                    @if (x.Tipo == TipoPessoa.PF)
                    {
                        <dt>RG</dt><dd>@(x.Rg ?? "—")</dd>
                    }
                    <dt>E-mail</dt>
                    <dd>@if (x.Email is not null) { <a href="mailto:@x.Email">@x.Email</a> } else { <text>—</text> }</dd>
                    <dt>Telefone</dt>
                    <dd>@if (x.Telefone is not null) { <a href="tel:+55@(Formatos.TelefoneDigitos(x.Telefone))">@x.Telefone</a> } else { <text>—</text> }</dd>
                    <dt>WhatsApp</dt>
                    <dd>@if (x.Whatsapp is not null) { <a href="https://wa.me/55@(Formatos.TelefoneDigitos(x.Whatsapp))" target="_blank" rel="noopener">@x.Whatsapp</a> } else { <text>—</text> }</dd>
                </dl>
            </section>
            <section>
                <h3>Endereço</h3>
                <p>@(Endereco(x) ?? "—")</p>
            </section>
            <section>
                <h3>Perfis</h3>
                @if (x.Papeis.Count == 0)
                {
                    <p class="mudo">—</p>
                }
                @foreach (var papelX in x.Papeis)
                {
                    <span class="badge">@NomePerfil(papelX.Papel)@(papelX.Especialidade is null ? "" : $" · {papelX.Especialidade}")</span>
                }
            </section>
            <section>
                <h3>Imóveis vinculados (@f.Imoveis.Count)</h3>
                @if (f.Imoveis.Count == 0)
                {
                    <p class="mudo">Nenhum.</p>
                }
                else
                {
                    <ul>
                        @foreach (var im in f.Imoveis)
                        {
                            <li><a href="imoveis/@im.Id">@im.NomeComSituacao</a></li>
                        }
                    </ul>
                }
            </section>
            @if (Texto.Limpo(x.Observacoes) is { } obs)
            {
                <section>
                    <h3>Observações</h3>
                    <p class="texto-livre">@obs</p>
                </section>
            }
            <p class="pequeno mudo">
                Consentimento LGPD: @(x.LgpdConsentimentoEm is { } l ? Texto.DataHora(l) : "não registrado")
                · Cadastrada em @Texto.DataHora(x.CriadoEm) · Atualizada em @Texto.DataHora(x.AtualizadoEm)
            </p>
        </div>
        <div class="acoes">
            @if (PodeEditar)
            {
                <button type="button" class="btn-primary" @onclick="() => EditarDaFicha(x)">Editar</button>
            }
            <button type="button" class="btn-ghost" @onclick="() => ficha = null">Fechar</button>
        </div>
    </Modal>
}

@if (form is not null)
{
    <Modal Titulo="@(editandoId is null ? "Nova pessoa" : "Pessoa")" Largo AoFechar="() => form = null">
        <EditForm Model="form" OnValidSubmit="Salvar" class="formulario">
            <DataAnnotationsValidator />
            <fieldset class="secao-form">
            <legend>Dados e contato</legend>
            <div class="grade-4">
                <label class="campo">
                    <span>Tipo</span>
                    <InputSelect class="input" @bind-Value="form.Tipo">
                        <option value="@TipoPessoa.PF">Pessoa física</option>
                        <option value="@TipoPessoa.PJ">Pessoa jurídica</option>
                    </InputSelect>
                </label>
                <label class="campo col-2">
                    <span>@(form.Tipo == TipoPessoa.PF ? "Nome completo" : "Razão social") *</span>
                    <InputText class="input" @bind-Value="form.NomeRazao" />
                    <ValidationMessage For="() => form.NomeRazao" />
                </label>
                <label class="campo">
                    <span>@(form.Tipo == TipoPessoa.PF ? "CPF" : "CNPJ")</span>
                    @if (form.Tipo == TipoPessoa.PF)
                    {
                        <InputText class="input" @bind-Value="form.CpfCnpj" data-mascara="cpf" inputmode="numeric" maxlength="14" placeholder="000.000.000-00" />
                    }
                    else
                    {
                        <InputText class="input" @bind-Value="form.CpfCnpj" data-mascara="cnpj" maxlength="18" placeholder="00.000.000/0000-00" />
                    }
                    <ValidationMessage For="() => form.CpfCnpj" />
                </label>
                @if (form.Tipo == TipoPessoa.PF)
                {
                    <label class="campo">
                        <span>RG</span>
                        <InputText class="input" @bind-Value="form.Rg" />
                    </label>
                }
                <label class="campo">
                    <span>E-mail</span>
                    <InputText class="input" type="email" @bind-Value="form.Email" placeholder="nome@empresa.com.br" />
                    <ValidationMessage For="() => form.Email" />
                </label>
                <label class="campo">
                    <span>Telefone</span>
                    <InputText class="input" type="tel" @bind-Value="form.Telefone" data-mascara="telefone" maxlength="15" placeholder="(11) 3456-7890" />
                    <ValidationMessage For="() => form.Telefone" />
                </label>
                <label class="campo">
                    <span>WhatsApp</span>
                    <InputText class="input" type="tel" @bind-Value="form.Whatsapp" data-mascara="telefone" maxlength="15" placeholder="(11) 98765-4321" />
                    <ValidationMessage For="() => form.Whatsapp" />
                </label>
            </div>
            </fieldset>

            <fieldset class="secao-form">
            <legend>Endereço</legend>
            <div class="grade-4">
                <CampoCep @bind-Valor="form.Cep" AoEncontrar="PreencherEndereco" />
                <label class="campo col-2">
                    <span>Logradouro</span>
                    <InputText class="input" @bind-Value="form.Logradouro" />
                </label>
                <label class="campo">
                    <span>Número</span>
                    <InputText class="input" @bind-Value="form.Numero" />
                </label>
                <label class="campo">
                    <span>Complemento</span>
                    <InputText class="input" @bind-Value="form.Complemento" />
                </label>
                <label class="campo">
                    <span>Bairro</span>
                    <InputText class="input" @bind-Value="form.Bairro" />
                </label>
                <label class="campo">
                    <span>Cidade</span>
                    <InputText class="input" @bind-Value="form.Cidade" />
                </label>
                <label class="campo">
                    <span>UF</span>
                    <InputSelect class="input" @bind-Value="form.Uf">
                        <option value="">—</option>
                        @foreach (var (sigla, nome) in Formatos.Ufs)
                        {
                            <option value="@sigla" title="@nome">@sigla · @nome</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => form.Uf" />
                </label>
            </div>

            </fieldset>

            <fieldset class="secao-form">
                <legend>Perfis</legend>
                <div class="checks">
                    @foreach (var p in perfis.Where(p => p.Ativo || TemPapel(p.Codigo)))
                    {
                        <label>
                            <input type="checkbox" checked="@TemPapel(p.Codigo)" @onchange="e => AlternarPapel(p.Codigo, (bool)e.Value!)" />
                            @p.Nome
                        </label>
                    }
                    <button type="button" class="btn-ghost mini" title="Cadastrar um perfil que não está na lista" @onclick="() => novoPerfil = true">+ Novo perfil</button>
                </div>
            @foreach (var papelForm in form.Papeis)
            {
                <label class="campo">
                    <span>Atributo profissional · @NomePerfil(papelForm.Papel)</span>
                    <InputText class="input" placeholder="Ex.: topógrafo, construtor, cartório, engenheiro" @bind-Value="papelForm.Especialidade" />
                </label>
            }
            </fieldset>

            <fieldset class="secao-form">
                <legend>Imóveis vinculados (@(form.Imoveis?.Count ?? 0))</legend>
                @if (imoveis.Count == 0)
                {
                    <p class="pequeno mudo">Nenhum imóvel disponível.</p>
                }
                else
                {
                    <input class="input" placeholder="Filtrar por código ou título…" @bind="filtroImovel" @bind:event="oninput" />
                    <label class="check">
                        <input type="checkbox" @bind="mostrarInativos" />
                        Mostrar também vendidos e arquivados (@imoveis.Count(i => !i.Ativo))
                    </label>
                    <div class="lista-selecao">
                        @foreach (var im in imoveis.Where(i => VisivelNoFiltro(i)))
                        {
                            <label class="check">
                                <input type="checkbox" checked="@(form.Imoveis?.Contains(im.Id) == true)"
                                       @onchange="e => AlternarImovel(im.Id, (bool)e.Value!)" />
                                @im.NomeComSituacao
                            </label>
                        }
                    </div>
                }
            </fieldset>

            <label class="campo">
                <span>Observações</span>
                <InputTextArea class="input" rows="3" @bind-Value="form.Observacoes" />
            </label>
            <label class="check">
                <input type="checkbox" checked="@(form.LgpdConsentimentoEm is not null)"
                       @onchange="e => form.LgpdConsentimentoEm = (bool)e.Value! ? (form.LgpdConsentimentoEm ?? DateTime.UtcNow) : null" />
                Consentimento LGPD registrado
                @if (form.LgpdConsentimentoEm is { } l)
                {
                    <span class="pequeno mudo">(@Texto.DataHora(l))</span>
                }
            </label>

            <MensagemErro Texto="@erroForm" />
            @if (PodeEditar || editandoId is null)
            {
                <div class="acoes">
                    <button type="submit" class="btn-primary" disabled="@Ocupado">Salvar</button>
                    <button type="button" class="btn-ghost" @onclick="() => form = null">Cancelar</button>
                </div>
            }
        </EditForm>
    </Modal>
}

@if (novoPerfil)
{
    <CadastroRapido Titulo="Novo perfil de pessoa" Placeholder="Ex.: Síndico" Maximo="60" Criar="CriarPerfil" AoFechar="() => novoPerfil = false" />
}

@if (exclusao is { } ex)
{
    <ExcluirComSenha Titulo="Excluir pessoa" Nome="pessoa" Previa="ex.Previa" Confirmar="ConfirmarExclusao" AoFechar="() => exclusao = null" />
}

@code {
    private Paginado<Pessoa>? resultado;
    private IReadOnlyList<PerfilPessoa> perfis = [];
    private IReadOnlyList<OpcaoImovel> imoveis = [];
    private Dictionary<Guid, List<string>> codigosImoveis = [];
    private string filtroImovel = "";
    private string termo = "";
    private string papel = "";
    private int pagina = 1;
    private CancellationTokenSource? espera;

    private PessoaForm? form;
    private Guid? editandoId;
    private string? erroForm;

    private bool PodeEditar => Usuario.Pode(Permissoes.PessoasEditar);

    private string LinkExcel => QueryHelpers.AddQueryString("pessoas/lista.xlsx", new Dictionary<string, string?>
        { ["termo"] = Texto.Limpo(termo), ["papel"] = Texto.Limpo(papel) });

    /// <summary>pessoas?id=&lt;id&gt; (busca global): abre o cadastro da pessoa.</summary>
    [SupplyParameterFromQuery(Name = "id")] public Guid? AbrirId { get; set; }
    private Guid? abertaPelaUrl;

    protected override async Task OnParametersSetAsync()
    {
        if (AbrirId is not { } id || id == abertaPelaUrl) return;
        abertaPelaUrl = id;
        Pessoa? p = null;
        if (await Executar(async () => p = await Servico.ObterAsync(Usuario, id)) && p is not null) await Ver(p);
    }

    protected override async Task OnInitializedAsync()
    {
        perfis = await Cadastros.PerfisPessoaAsync(incluirInativos: true);
        imoveis = await Opcoes.ImoveisComSituacaoAsync(Usuario);
        await Carregar();
    }

    private string NomePerfil(string codigo) => perfis.FirstOrDefault(p => p.Codigo == codigo)?.Nome ?? Texto.Rotulo(codigo);

    private Task Carregar() => Executar(async () =>
    {
        resultado = await Servico.ListarAsync(Usuario, new FiltroPessoas(termo, Texto.Limpo(papel), pagina));
        codigosImoveis = await Servico.CodigosImoveisAsync(Usuario, [.. resultado.Itens.Select(p => p.Id)]);
    });

    private async Task AoDigitar()
    {
        espera?.Cancel();
        espera = new CancellationTokenSource();
        try { await Task.Delay(300, espera.Token); }
        catch (TaskCanceledException) { return; }
        await Filtrar();
    }

    private Task Filtrar()
    {
        pagina = 1;
        return Carregar();
    }

    private Task IrPara(int p)
    {
        pagina = p;
        return Carregar();
    }

    private void Nova()
    {
        erroForm = null;
        editandoId = null;
        filtroImovel = "";
        form = new PessoaForm { Imoveis = [] };
    }

    /// <summary>Ficha aberta pelo nome: os dados da pessoa e os imóveis vinculados, sem os campos de edição.</summary>
    private (Pessoa Pessoa, List<OpcaoImovel> Imoveis)? ficha;

    private async Task Ver(Pessoa p)
    {
        List<Guid> ids = [];
        if (!await Executar(async () => ids = await Servico.ImoveisDaPessoaAsync(Usuario, p.Id))) return;
        ficha = (p, [.. imoveis.Where(i => ids.Contains(i.Id))]);
    }

    private async Task EditarDaFicha(Pessoa p)
    {
        ficha = null;
        await Editar(p);
    }

    private static string? Endereco(Pessoa p)
    {
        var rua = string.Join(", ", new[] { p.Logradouro, p.Numero, p.Complemento }.Where(v => !string.IsNullOrWhiteSpace(v)));
        var cidade = p.Cidade is null ? null : p.Uf is null ? p.Cidade : $"{p.Cidade}/{p.Uf}";
        var partes = new[] { rua, p.Bairro, cidade, p.Cep is null ? null : "CEP " + p.Cep }.Where(v => !string.IsNullOrWhiteSpace(v)).ToList();
        return partes.Count == 0 ? null : string.Join(" · ", partes);
    }

    private async Task Editar(Pessoa p)
    {
        erroForm = null;
        filtroImovel = "";
        List<Guid> vinculados = [];
        if (!await Executar(async () => vinculados = await Servico.ImoveisDaPessoaAsync(Usuario, p.Id))) return;
        editandoId = p.Id;
        form = PessoaForm.De(p);
        form.Imoveis = vinculados;
    }

    /// <summary>Padrão: só imóveis ativos; os já vinculados aparecem sempre (mesmo vendidos/arquivados).</summary>
    private bool mostrarInativos;

    private bool VisivelNoFiltro(OpcaoImovel im) =>
        form!.Imoveis?.Contains(im.Id) == true
        || ((mostrarInativos || im.Ativo)
            && (Texto.Limpo(filtroImovel) is not { } f || Texto.Contem(im.Nome, f)));

    private void AlternarImovel(Guid id, bool marcado)
    {
        form!.Imoveis ??= [];
        form.Imoveis.Remove(id);
        if (marcado) form.Imoveis.Add(id);
    }

    // campos continuam editáveis; o que o CEP não trouxer (ex.: logradouro de CEP geral da cidade) fica como estava
    private void PreencherEndereco(EnderecoCep e)
    {
        form!.Cep = e.Cep;
        form.Logradouro = e.Logradouro ?? form.Logradouro;
        form.Bairro = e.Bairro ?? form.Bairro;
        form.Cidade = e.Cidade ?? form.Cidade;
        form.Uf = e.Uf ?? form.Uf;
    }

    private bool TemPapel(string p) => form!.Papeis.Any(x => x.Papel == p);

    private bool novoPerfil;

    /// <summary>"+ Novo perfil": cadastra, recarrega a lista e já marca o perfil na pessoa.</summary>
    private async Task CriarPerfil(string nome)
    {
        var criado = await Cadastros.CriarPerfilPessoaAsync(Usuario, new PerfilPessoaForm { Nome = nome });
        perfis = await Cadastros.PerfisPessoaAsync(incluirInativos: true);
        if (form is not null) AlternarPapel(criado.Codigo, true);
        novoPerfil = false;
    }

    private void AlternarPapel(string p, bool marcado)
    {
        form!.Papeis.RemoveAll(x => x.Papel == p);
        if (marcado) form.Papeis.Add(new PapelEntrada { Papel = p });
    }

    private async Task Salvar()
    {
        var ok = await Executar(async () =>
        {
            if (editandoId is { } id) await Servico.AtualizarAsync(Usuario, id, form!);
            else await Servico.CriarAsync(Usuario, form!);
        });
        if (!ok)
        {
            erroForm = Erro;
            Erro = null;
            return;
        }
        form = null;
        await Carregar();
    }

    /// <summary>Exclusão com confirmação reforçada: lista o que vai junto, "Concordo" e senha (regra do sistema).</summary>
    private (Guid Id, PreviaExclusao Previa)? exclusao;

    private async Task Excluir(Pessoa p) =>
        await Executar(async () => exclusao = (p.Id, await Servico.PreviaExclusaoAsync(Usuario, p.Id)));

    private async Task ConfirmarExclusao(string senha)
    {
        await Servico.ExcluirAsync(Usuario, exclusao!.Value.Id, senha);
        exclusao = null;
        await Carregar();
    }

    public void Dispose() => espera?.Cancel();
}
