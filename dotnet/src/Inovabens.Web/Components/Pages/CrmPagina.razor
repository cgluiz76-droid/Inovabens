@page "/crm"
@attribute [Authorize(Policy = Permissoes.CrmVer)]
@inherits ComponenteBase
@inject CrmService Servico
@inject OpcoesService Opcoes
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>CRM · Inovabens</PageTitle>

<div class="titulo">
    <h1>CRM</h1>
    <div class="acoes-topo">
        <a class="btn-ghost" href="crm/acompanhamento">📊 Acompanhamento</a>
        @if (Usuario.Pode(Permissoes.AgendaVer))
        {
            <a class="btn-ghost" href="atividades">📋 Minhas atividades</a>
        }
        @if (Usuario.Pode(Permissoes.CrmCriar))
        {
            <button class="btn-primary" @onclick="() => NovoLead()">+ Novo lead</button>
        }
    </div>
</div>

<div class="barra-crm">
    <div class="abas">
        @foreach (var f in Funis.DeLeads)
        {
            <button class="aba @(funil == f ? "ativa" : "")" @onclick="() => TrocarFunil(f)">@Funis.Nome(f)</button>
        }
        @if (Usuario.Pode(Permissoes.ProcessosVer))
        {
            @foreach (var f in Funis.DeProcessos)
            {
                <a class="aba aba-link" href="processos?funil=@f" title="Processos do imóvel">@Funis.Nome(f) ↗</a>
            }
        }
    </div>
    <div class="filtros-crm">
        <label class="filtro-imovel">
            <span class="pequeno mudo">Responsável</span>
            <select class="input" aria-label="Filtrar por responsável" value="@responsavelFiltro" @onchange="FiltrarResponsavel">
                <option value="">@(Usuario.EscopoProprio ? "Meus leads e fila aberta" : "Todos")</option>
                <option value="@FiltroEu">Só os meus</option>
                <option value="@FiltroFila">Fila aberta (sem responsável)</option>
                @foreach (var r in responsaveis ?? [])
                {
                    if (r.Id != Usuario.Id)
                    {
                        <option value="@r.Id">@r.Nome</option>
                    }
                }
            </select>
        </label>
        <label class="filtro-imovel">
            <span class="pequeno mudo">Imóvel</span>
            <select class="input" aria-label="Filtrar por imóvel" value="@(imovelFiltro?.ToString() ?? "")" @onchange="FiltrarImovel">
                <option value="">Todos os imóveis</option>
                @foreach (var i in OpcoesFiltro)
                {
                    <option value="@i.Id">@i.Nome</option>
                }
            </select>
        </label>
        @if (!Usuario.EscopoProprio)
        {
            <label class="check filtro-raias">
                <input type="checkbox" checked="@raias" @onchange="e => raias = e.Value is true" /> Raias por responsável
            </label>
        }
    </div>
</div>

@if (imovelFiltro is { } fi)
{
    <p class="filtro-ativo">
        Mostrando só os leads do imóvel <a href="imoveis/@fi">@(OpcoesFiltro.FirstOrDefault(o => o.Id == fi)?.Nome ?? "selecionado")</a>
        <button class="btn-ghost mini" @onclick="() => AplicarFiltro(null)">✕ Limpar filtro</button>
    </p>
}

<MensagemErro Texto="@Erro" />
@if (aviso is not null)
{
    <p class="aviso-passivo">@aviso</p>
}

@if (colunas is null)
{
    <p class="carregando">Carregando…</p>
}
else
{
    <div class="resumo-funil" role="group" aria-label="Filtrar por situação do próximo passo">
        <button class="chip-situacao @(situacaoFiltro is null ? "ativo" : "")" @onclick="() => situacaoFiltro = null">
            Todos <b>@Contar(null)</b>
        </button>
        @foreach (var s in new[] { SituacaoProximoPasso.Atrasado, SituacaoProximoPasso.Hoje, SituacaoProximoPasso.Nenhum })
        {
            <button class="chip-situacao situacao-@s.ToString().ToLowerInvariant() @(situacaoFiltro == s ? "ativo" : "")"
                    @onclick="() => situacaoFiltro = situacaoFiltro == s ? null : s">
                @RotuloSituacao(s) <b>@Contar(s)</b>
            </button>
        }
        @if (Fila > 0 || responsavelFiltro == FiltroFila)
        {
            <button class="chip-situacao chip-fila @(responsavelFiltro == FiltroFila ? "ativo" : "")"
                    @onclick="AlternarFila">
                🙋 Fila aberta <b>@Fila</b>
            </button>
        }
    </div>

    @if (raias && !Usuario.EscopoProprio)
    {
        var lista = Raias().ToList();
        @foreach (var raia in lista)
        {
            <section class="raia">
                <h2 class="raia-topo">
                    <span>@(raia.Id is null ? "🙋 Fila aberta (sem responsável)" : $"👤 {raia.Nome}")</span>
                    <span class="pequeno mudo">
                        @raia.Total lead(s)
                        @if (raia.Atrasados > 0)
                        {
                            <span class="texto-erro"> · @raia.Atrasados atrasado(s)</span>
                        }
                        @if (raia.SemPasso > 0)
                        {
                            <span> · @raia.SemPasso sem próximo passo</span>
                        }
                    </span>
                </h2>
                @Quadro(ColunasVisiveis(raia.Id, raia.Id is null))
            </section>
        }
        @if (lista.Count == 0)
        {
            <p class="pequeno mudo">Nenhum lead com estes filtros.</p>
        }
    }
    else
    {
        @Quadro(ColunasVisiveis())
    }
}

@if (perda is not null)
{
    <Modal Titulo="Motivo da perda" AoFechar="() => perda = null">
        <p class="pequeno mudo">@perda.Value.Lead.PessoaNome → @perda.Value.Estagio.Nome</p>
        <label class="campo">
            <span>Por que o negócio foi perdido? *</span>
            <textarea class="input" rows="3" @bind="motivo"></textarea>
        </label>
        <p class="pequeno mudo">As atividades pendentes deste lead serão canceladas na agenda.</p>
        <MensagemErro Texto="@erroModal" />
        <div class="acoes">
            <button class="btn-primary" disabled="@Ocupado" @onclick="ConfirmarPerda">Confirmar</button>
            <button class="btn-ghost" @onclick="() => perda = null">Cancelar</button>
        </div>
    </Modal>
}

@if (movimento is not null)
{
    <Modal Titulo="@($"Mover para {movimento.Destino.Nome}")" AoFechar="() => movimento = null">
        <p class="pequeno mudo">@movimento.Lead.PessoaNome · qual é o próximo passo?</p>
        @if (movimento.Lead.ProximoTitulo is { } atual && movimento.Lead.ProximaAcaoEm is { } quando)
        {
            <div class="checks">
                <label><input type="radio" name="manter" checked="@movimento.Manter" @onchange="() => movimento.Manter = true" /> Manter o já agendado: <b>@atual</b> · @Texto.DataHora(quando)</label>
                <label><input type="radio" name="manter" checked="@(!movimento.Manter)" @onchange="() => movimento.Manter = false" /> Definir outro passo</label>
            </div>
        }
        <EditForm Model="movimento.Proximo" OnSubmit="EnviarMovimento" class="formulario">
            <DataAnnotationsValidator />
            @if (!movimento.Manter)
            {
                <ProximoPassoCampos Form="movimento.Proximo" />
            }
            <MensagemErro Texto="@erroModal" />
            <div class="acoes">
                <button type="submit" class="btn-primary" disabled="@Ocupado">Mover</button>
                <button type="button" class="btn-ghost" @onclick="() => movimento = null">Cancelar</button>
            </div>
        </EditForm>
    </Modal>
}

@if (agendar is not null)
{
    <Modal Titulo="@($"Agendar atividade · {agendar.Value.Lead.PessoaNome}")" AoFechar="() => agendar = null">
        <EditForm Model="agendar.Value.Form" OnValidSubmit="ConfirmarAgendar" class="formulario">
            <DataAnnotationsValidator />
            <ProximoPassoCampos Form="agendar.Value.Form" PermitePular="false" />
            <MensagemErro Texto="@erroModal" />
            <div class="acoes">
                <button type="submit" class="btn-primary" disabled="@Ocupado">Agendar</button>
                <button type="button" class="btn-ghost" @onclick="() => agendar = null">Cancelar</button>
            </div>
        </EditForm>
    </Modal>
}

@if (novo is not null)
{
    <Modal Titulo="Novo lead" Largo AoFechar="() => novo = null">
        <EditForm Model="novo" OnValidSubmit="CriarLead" class="formulario">
            <DataAnnotationsValidator />
            <div class="checks">
                <label><input type="radio" name="contato" checked="@(!contatoNovo)" @onchange="() => contatoNovo = false" /> Pessoa já cadastrada</label>
                <label><input type="radio" name="contato" checked="@contatoNovo" @onchange="() => contatoNovo = true" /> Novo contato</label>
            </div>
            <div class="grade-4">
                @if (contatoNovo)
                {
                    <label class="campo col-2">
                        <span>Nome *</span>
                        <InputText class="input" @bind-Value="novo.NovoNome" />
                    </label>
                    <label class="campo">
                        <span>Telefone</span>
                        <InputText class="input" type="tel" @bind-Value="novo.NovoTelefone" />
                    </label>
                    <label class="campo">
                        <span>E-mail</span>
                        <InputText class="input" type="email" @bind-Value="novo.NovoEmail" />
                        <ValidationMessage For="() => novo.NovoEmail" />
                    </label>
                }
                else
                {
                    <label class="campo col-2">
                        <span>Pessoa *</span>
                        <InputSelect class="input" @bind-Value="novo.PessoaId">
                            <option value="">Selecione…</option>
                            @foreach (var p in pessoas)
                            {
                                <option value="@p.Id">@p.Nome</option>
                            }
                        </InputSelect>
                    </label>
                }
            </div>
            <CamposLead Form="novo" Responsaveis="responsaveis" Imoveis="imoveis" Finalidade />
            <MensagemErro Texto="@erroModal" />
            <div class="acoes">
                <button type="submit" class="btn-primary" disabled="@Ocupado">Criar lead</button>
                <button type="button" class="btn-ghost" @onclick="() => novo = null">Cancelar</button>
            </div>
        </EditForm>
    </Modal>
}

@if (leadAberto is { } aberto)
{
    <LeadPainel @ref="painel" LeadId="aberto" Estagios="EstagiosDoFunil" Imoveis="imoveis" Responsaveis="responsaveis"
                Anterior="Vizinho(aberto, -1)" Proximo="Vizinho(aberto, +1)" AoFechar="FecharPainel" AoAlterar="Carregar"
                AoMover="MoverPeloPainel" AoAgendar="AgendarPeloPainel" AoNavegar="Abrir" />
}

@code {
    /// <summary>Quadro do funil (colunas e cartões); nas raias, um por responsável.</summary>
    private RenderFragment Quadro(IReadOnlyList<ColunaFunil> cols) => @<div class="kanban @(leadAberto is null ? "" : "com-painel")">
        @foreach (var col in cols)
        {
            <div class="coluna @(arrastando is not null && colunaAlvo == col.Estagio.Id ? "alvo" : "")" style="border-top-color:@(col.Estagio.Cor ?? "#64748b")"
                 @ondragenter="() => colunaAlvo = col.Estagio.Id" @ondragover:preventDefault @ondrop="() => Soltar(col.Estagio, null)">
                <div class="coluna-topo">
                    <strong>@col.Estagio.Nome</strong>
                    <span class="badge">@col.Leads.Count</span>
                </div>
                @if (col.ValorTotal > 0)
                {
                    <p class="coluna-valor" title="Soma do valor das propostas (ou do anunciado, sem proposta)">@Texto.MoedaCompacta(col.ValorTotal)</p>
                }
                @foreach (var l in col.Leads)
                {
                    var perdido = col.Estagio.Tipo == TipoEstagio.PERDIDO;
                    var abre = PodeAbrir(l);
                    <div class="cartao-lead @(l.VincularImovel ? "vincular" : "") @(l.NaFila ? "na-fila" : "") @(!perdido && l.Situacao == SituacaoProximoPasso.Atrasado ? "atrasado" : "") @(arrastando?.Id == l.Id ? "arrastando" : "") @(leadAberto == l.Id ? "aberto" : "") @(destaque == l.Id ? "destaque" : "")" @key="(l.Id, versao)"
                         draggable="@(PodeMover && abre ? "true" : "false")" @ondragstart="() => arrastando = l" @ondragend="FimArraste"
                         @ondrop="() => Soltar(col.Estagio, l)" @ondrop:stopPropagation>
                        <div class="cartao-topo">
                            @if (!perdido)
                            {
                                <span class="situacao situacao-@l.Situacao.ToString().ToLowerInvariant()" title="@TituloSituacao(l)">@RotuloSituacao(l.Situacao)</span>
                            }
                            <span class="pequeno mudo" title="Dias neste estágio">⏳ @l.DiasNaFase d</span>
                        </div>
                        @if (abre)
                        {
                            <button class="link-cartao" @onclick="() => Abrir(l.Id)">
                                <span class="forte">@l.PessoaNome</span>
                                <span class="pequeno mudo">@(l.Telefone ?? l.Email ?? "")</span>
                            </button>
                        }
                        else
                        {
                            <span class="forte">@l.PessoaNome</span>
                        }
                        @if (l.ImovelCodigo is not null || l.Valor is not null)
                        {
                            <p class="pequeno">
                                @if (l.ImovelCodigo is { } cod)
                                {
                                    <span>🏠 @cod@(l.OutrosImoveis > 0 ? $" +{l.OutrosImoveis}" : "")</span>
                                }
                                @if (l.Valor is { } v)
                                {
                                    <span class="valor-lead"> · @Texto.MoedaCompacta(v)</span>
                                }
                            </p>
                        }
                        else if (l.OrcamentoMax is { } o)
                        {
                            <p class="pequeno">até @Texto.Moeda(o)</p>
                        }
                        @if (l.StatusProposta is { } sp && l.ValorProposta is { } vp)
                        {
                            <p class="pequeno proposta-cartao proposta-@sp.ToString().ToLowerInvariant()">
                                @(sp == StatusProposta.ACEITA ? "✔ Aceita" : "💰 Proposta") @Texto.MoedaCompacta(vp)@PropostasAba.Pct(l.DiferencaPct, " · ")
                            </p>
                        }
                        @if (l.VincularImovel)
                        {
                            <p class="pequeno aviso-vinculo">📲 Vincular imóvel@(l.ImovelSugerido is { } sug ? $" · sugerido {sug}" : "")</p>
                        }
                        @if (!perdido && l.ProximaAcaoEm is { } p)
                        {
                            <p class="pequeno proximo-cartao">➜ @(l.ProximoTitulo ?? "Próxima ação") · @Texto.DataHora(p)</p>
                        }
                        @if (l.NaFila && PodeMover)
                        {
                            <button class="btn-primary mini btn-pegar" disabled="@Ocupado" @onclick="() => Pegar(l)">🙋 Pegar atendimento</button>
                        }
                        <div class="cartao-rodape">
                            <span class="pequeno mudo">@(l.NaFila ? "🙋 Fila aberta" : $"👤 {l.ResponsavelNome}")@(l.Origem is null ? "" : $" · {l.Origem}")</span>
                            @if (PodeMover && abre)
                            {
                                <span class="cartao-botoes">
                                    @if (!perdido)
                                    {
                                        <button class="btn-icone" title="Agendar atividade" aria-label="Agendar atividade" @onclick="() => AbrirAgendar(l)">+</button>
                                    }
                                    <details class="menu-cartao">
                                        <summary class="btn-icone" title="Mais ações" aria-label="Mais ações">⋯</summary>
                                        <div class="menu-cartao-itens">
                                            <label class="pequeno">Mover para</label>
                                            <select class="input mini" value="@col.Estagio.Id" @onchange="e => Mover(l, e.Value?.ToString())" aria-label="Mover para">
                                                @foreach (var e in colunas!)
                                                {
                                                    <option value="@e.Estagio.Id">→ @e.Estagio.Nome</option>
                                                }
                                            </select>
                                        </div>
                                    </details>
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>;

    /* ---- filtros: responsável (no servidor); situação e raias (na tela) ---- */

    private const string FiltroEu = "eu", FiltroFila = "fila";
    private string responsavelFiltro = "";
    private SituacaoProximoPasso? situacaoFiltro;
    private bool raias;
    private Guid? destaque;
    private string? aviso;

    /// <summary>Lead da fila aberta: o Corretor só abre depois de pegar o atendimento (o gestor abre direto).</summary>
    private bool PodeAbrir(LeadCartao l) => !l.NaFila || !Usuario.EscopoProprio;

    private IEnumerable<LeadCartao> Ativos => colunas?.Where(c => c.Estagio.Tipo != TipoEstagio.PERDIDO).SelectMany(c => c.Leads) ?? [];

    private int Contar(SituacaoProximoPasso? s) => Ativos.Count(l => s is null || l.Situacao == s);

    private int Fila => colunas?.SelectMany(c => c.Leads).Count(l => l.NaFila) ?? 0;

    private bool PassaSituacao(LeadCartao l, FunilEstagio e) =>
        situacaoFiltro is not { } s || (e.Tipo != TipoEstagio.PERDIDO && l.Situacao == s);

    /// <param name="raia">Responsável da raia; null com <paramref name="fila"/> = a raia dos sem responsável.</param>
    private IReadOnlyList<ColunaFunil> ColunasVisiveis(Guid? raia = null, bool fila = false) =>
        [.. colunas!.Select(c => new ColunaFunil(c.Estagio, [.. c.Leads.Where(l => PassaSituacao(l, c.Estagio)
            && ((raia is null && !fila) || l.ResponsavelId == raia))]))];

    private sealed record Raia(Guid? Id, string? Nome, int Total, int Atrasados, int SemPasso);

    /// <summary>Uma raia por responsável com leads (fila aberta primeiro), com os contadores do próximo passo.</summary>
    private IEnumerable<Raia> Raias() => colunas!
        .SelectMany(c => c.Leads.Where(l => PassaSituacao(l, c.Estagio)).Select(l => (Lead: l, c.Estagio.Tipo)))
        .GroupBy(x => x.Lead.ResponsavelId)
        .Select(g =>
        {
            var ativos = g.Where(x => x.Tipo != TipoEstagio.PERDIDO).Select(x => x.Lead).ToList();
            return new Raia(g.Key, g.First().Lead.ResponsavelNome, g.Count(),
                ativos.Count(l => l.Situacao == SituacaoProximoPasso.Atrasado), ativos.Count(l => l.Situacao == SituacaoProximoPasso.Nenhum));
        })
        .OrderBy(r => r.Id is not null).ThenBy(r => r.Nome);

    private Task FiltrarResponsavel(ChangeEventArgs e) => DefinirResponsavel(e.Value?.ToString() ?? "");

    private Task AlternarFila() => DefinirResponsavel(responsavelFiltro == FiltroFila ? "" : FiltroFila);

    private Task DefinirResponsavel(string valor)
    {
        responsavelFiltro = valor;
        return Carregar();
    }

    private async Task Pegar(LeadCartao l)
    {
        aviso = null;
        if (!await Executar(() => Servico.PegarAsync(Usuario, l.Id)))
        {
            var erro = Erro;
            await Carregar(); // outro usuário pegou antes: o cartão sai da fila
            Erro = erro;
            return;
        }
        destaque = null;
        await Carregar();
        leadAberto = l.Id;
    }

    private Funil funil = Funil.VENDA;
    private IReadOnlyList<ColunaFunil>? colunas;
    private IReadOnlyList<Opcao> pessoas = [];
    private IReadOnlyList<Opcao> imoveis = [];
    private IReadOnlyList<Opcao> imoveisFiltro = [];
    private IReadOnlyList<Opcao>? responsaveis;
    private string? erroModal;
    private Guid? imovelFiltro;

    private (LeadCartao Lead, FunilEstagio Estagio)? perda;
    private string motivo = "";

    private sealed class Movimento(LeadCartao lead, FunilEstagio destino, int? ordem)
    {
        public LeadCartao Lead { get; } = lead;
        public FunilEstagio Destino { get; } = destino;
        public int? Ordem { get; } = ordem;
        public bool Manter { get; set; } = lead.ProximoTitulo is not null && lead.ProximaAcaoEm > DateTime.UtcNow;
        public ProximoPassoForm Proximo { get; } = Novo(destino.Tipo == TipoEstagio.GANHO ? TipoCompromisso.TAREFA : TipoCompromisso.LIGACAO);
    }
    private Movimento? movimento;

    private (LeadCartao Lead, ProximoPassoForm Form)? agendar;

    private LeadForm? novo;
    private bool contatoNovo = true;

    private Guid? leadAberto;
    private LeadPainel? painel;

    private IReadOnlyList<FunilEstagio> EstagiosDoFunil => colunas?.Select(c => c.Estagio).ToList() ?? [];

    /// <summary>Lead anterior/seguinte na mesma coluna (setas do painel).</summary>
    private Guid? Vizinho(Guid id, int passo)
    {
        var col = colunas?.FirstOrDefault(c => c.Leads.Any(l => l.Id == id));
        if (col is null) return null;
        var i = col.Leads.ToList().FindIndex(l => l.Id == id) + passo;
        return i >= 0 && i < col.Leads.Count ? col.Leads[i].Id : null;
    }

    /// <summary>O imóvel filtrado continua na lista mesmo se vendido/arquivado (veio da ficha dele).</summary>
    private IReadOnlyList<Opcao> OpcoesFiltro => imoveisFiltro;

    private static ProximoPassoForm Novo(TipoCompromisso tipo)
    {
        var f = new ProximoPassoForm();
        f.Limpar(tipo);
        return f;
    }

    protected override async Task OnInitializedAsync()
    {
        var consulta = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (consulta.TryGetValue("imovel", out var im) && Guid.TryParse(im, out var imovelId)) imovelFiltro = imovelId;
        if (consulta.TryGetValue("funil", out var fu) && Enum.TryParse<Funil>(fu, true, out var f))
        {
            if (Funis.EhProcesso(f)) { Nav.NavigateTo($"processos?funil={f}", replace: true); return; }
            funil = f;
        }
        await Executar(async () =>
        {
            pessoas = await Opcoes.PessoasAsync(Usuario);
            imoveis = await Opcoes.ImoveisParaInteresseAsync(Usuario);
            imoveisFiltro = imoveis;
            if (imovelFiltro is { } id && imoveis.All(o => o.Id != id))
                imoveisFiltro = [new Opcao(id, "Imóvel selecionado"), .. imoveis];
            if (!Usuario.EscopoProprio) responsaveis = await Opcoes.CorretoresAsync();
        });
        await Carregar();
        // vindo do alerta "novo lead" (crm?lead=<id>): abre o lead no funil dele
        if (consulta.TryGetValue("lead", out var lid) && Guid.TryParse(lid, out var leadId) && !await MostrarNaFila(leadId))
        {
            LeadDetalhe? d = null;
            await Executar(async () => d = await Servico.ObterAsync(Usuario, leadId));
            if (d is not null)
            {
                if (CrmService.FunilDa(d.Dados.Finalidade) != funil)
                {
                    funil = CrmService.FunilDa(d.Dados.Finalidade);
                    await Carregar();
                }
                leadAberto = leadId;
            }
        }
        // vindo da ficha do imóvel (crm?novo=1&imovel=<id>): novo lead já interessado no imóvel
        if (consulta.ContainsKey("novo") && Usuario.Pode(Permissoes.CrmCriar)) NovoLead(imovelFiltro);
    }

    /// <summary>
    /// Alerta de lead novo na fila aberta (crm?lead=): o Corretor ainda não abre o lead; o cartão fica em destaque
    /// com o botão "Pegar atendimento".
    /// </summary>
    private async Task<bool> MostrarNaFila(Guid leadId)
    {
        if (!Usuario.EscopoProprio) return false;
        var inicial = funil;
        foreach (var f in new[] { inicial }.Concat(Funis.DeLeads.Where(x => x != inicial)))
        {
            if (f != funil)
            {
                funil = f;
                await Carregar();
            }
            if (colunas?.SelectMany(c => c.Leads).FirstOrDefault(l => l.Id == leadId) is { } l)
            {
                if (!l.NaFila) return false;
                destaque = leadId;
                aviso = $"{l.PessoaNome} está na fila aberta. Clique em \"Pegar atendimento\" para assumir o lead.";
                return true;
            }
        }
        if (funil != inicial)
        {
            funil = inicial;
            await Carregar();
        }
        return false;
    }

    private Task FiltrarImovel(ChangeEventArgs e) => AplicarFiltro(Guid.TryParse(e.Value?.ToString(), out var id) ? id : null);

    private Task AplicarFiltro(Guid? id)
    {
        imovelFiltro = id;
        return Carregar();
    }

    /// <summary>Muda a cada recarga: recria os cartões para o select de estágio voltar ao valor real.</summary>
    private int versao;

    private Task Carregar() => Executar(async () =>
    {
        var (resp, fila) = responsavelFiltro switch
        {
            FiltroEu => ((Guid?)Usuario.Id, false),
            FiltroFila => (null, true),
            var v when Guid.TryParse(v, out var id) => (id, false),
            _ => (null, false),
        };
        colunas = await Servico.PipelineAsync(Usuario, funil, imovelFiltro, resp, fila);
        versao++;
    });

    private static string RotuloSituacao(SituacaoProximoPasso s) => s switch
    {
        SituacaoProximoPasso.Atrasado => "Atrasado",
        SituacaoProximoPasso.Hoje => "Hoje",
        SituacaoProximoPasso.Agendado => "Agendado",
        _ => "Sem próximo passo",
    };

    private static string TituloSituacao(LeadCartao l) => l.ProximaAcaoEm is { } p
        ? $"{l.ProximoTitulo ?? "Próxima ação"} · {Texto.DataHora(p)}"
        : "Nenhuma atividade agendada para este lead";

    /* ---- arrastar e soltar: o cartão vai para a coluna (ou para antes do cartão) onde for solto ---- */

    private bool PodeMover => Usuario.Pode(Permissoes.CrmEditar);
    private LeadCartao? arrastando;
    private Guid? colunaAlvo;

    private void FimArraste()
    {
        arrastando = null;
        colunaAlvo = null;
    }

    private async Task Soltar(FunilEstagio destino, LeadCartao? sobre)
    {
        var l = arrastando;
        FimArraste();
        if (l is null || !PodeMover || sobre?.Id == l.Id) return;
        var origem = colunas!.First(c => c.Leads.Any(x => x.Id == l.Id)).Estagio;
        if (origem.Id == destino.Id && sobre is null) return; // solto na própria coluna, fora de outro cartão
        await PedirMovimento(l, origem, destino, sobre?.Ordem);
    }

    /// <summary>Mesma coluna: só reordena. Perdido: pede o motivo. Demais: pede o próximo passo.</summary>
    private async Task PedirMovimento(LeadCartao l, FunilEstagio origem, FunilEstagio destino, int? ordem)
    {
        erroModal = null;
        if (origem.Id == destino.Id)
        {
            if (await Executar(() => Servico.MoverAsync(Usuario, l.Id, destino.Id, ordem: ordem))) await Carregar();
            await RecarregarPainel();
            return;
        }
        if (destino.Tipo == TipoEstagio.PERDIDO)
        {
            motivo = "";
            perda = (l, destino);
            return;
        }
        movimento = new Movimento(l, destino, ordem);
    }

    /// <summary>"Manter o já agendado" não valida os campos de novo passo (ficam ocultos).</summary>
    private async Task EnviarMovimento(EditContext ctx)
    {
        if (!movimento!.Manter && !ctx.Validate()) return;
        await ConfirmarMovimento();
    }

    private async Task ConfirmarMovimento()
    {
        var m = movimento!;
        await Executar(() => Servico.MoverAsync(Usuario, m.Lead.Id, m.Destino.Id, ordem: m.Ordem, proximo: m.Manter ? null : m.Proximo), noModal: true);
        if (erroModal is not null) return;
        movimento = null;
        await Carregar();
        await RecarregarPainel();
    }

    private void AbrirAgendar(LeadCartao l)
    {
        erroModal = null;
        agendar = (l, Novo(TipoCompromisso.LIGACAO));
    }

    private async Task ConfirmarAgendar()
    {
        var (l, f) = agendar!.Value;
        await Executar(() => Servico.AgendarAsync(Usuario, l.Id, f), noModal: true);
        if (erroModal is not null) return;
        agendar = null;
        await Carregar();
        await RecarregarPainel();
    }

    private Task TrocarFunil(Funil f)
    {
        funil = f;
        colunas = null;
        return Carregar();
    }

    private async Task Mover(LeadCartao l, string? estagioId)
    {
        if (!Guid.TryParse(estagioId, out var id)) return;
        var origem = colunas!.First(c => c.Leads.Any(x => x.Id == l.Id)).Estagio;
        var destino = colunas!.Select(c => c.Estagio).First(e => e.Id == id);
        await Carregar(); // volta o select para o estágio atual até confirmar
        await PedirMovimento(l, origem, destino, null);
    }

    private async Task ConfirmarPerda()
    {
        var (lead, estagio) = perda!.Value;
        if (!await Executar(() => Servico.MoverAsync(Usuario, lead.Id, estagio.Id, motivo)))
        {
            erroModal = Erro;
            Erro = null;
            return;
        }
        perda = null;
        await Carregar();
        await RecarregarPainel();
    }

    private void NovoLead(Guid? imovelId = null)
    {
        erroModal = null;
        contatoNovo = true;
        novo = new LeadForm
        {
            Finalidade = Funis.FinalidadeDo(funil),
            ImoveisInteresse = imovelId is { } i && imoveis.Any(o => o.Id == i) ? [i] : [],
        };
    }

    private async Task CriarLead()
    {
        if (contatoNovo) novo!.PessoaId = null;
        else novo!.NovoNome = novo.NovoTelefone = novo.NovoEmail = null;
        if (!await Executar(() => Servico.CriarAsync(Usuario, novo)))
        {
            erroModal = Erro;
            Erro = null;
            return;
        }
        var f = CrmService.FunilDa(novo.Finalidade);
        novo = null;
        if (f != funil) await TrocarFunil(f);
        else await Carregar();
        if (contatoNovo) pessoas = await Opcoes.PessoasAsync(Usuario);
    }

    private void Abrir(Guid id) => leadAberto = id;

    private void FecharPainel() => leadAberto = null;

    private async Task RecarregarPainel()
    {
        if (leadAberto is not null && painel is not null) await painel.RecarregarAsync();
    }

    /// <summary>Cartão do lead aberto (do funil, ou montado do painel se o filtro o esconde).</summary>
    private LeadCartao? CartaoAberto()
    {
        if (leadAberto is not { } id) return null;
        if (colunas?.SelectMany(c => c.Leads).FirstOrDefault(l => l.Id == id) is { } c) return c;
        return painel?.Detalhe is { } d
            ? new LeadCartao(d.Dados.Id, d.Pessoa.NomeRazao, d.Pessoa.Telefone, d.Pessoa.Email, d.Dados.Finalidade, d.Dados.Origem,
                d.ResponsavelNome, d.Dados.OrcamentoMax, d.Dados.ProximaAcaoEm, d.Dados.Ordem)
            : null;
    }

    private async Task MoverPeloPainel(FunilEstagio destino)
    {
        if (CartaoAberto() is { } l && painel?.Detalhe is { } d) await PedirMovimento(l, d.Estagio, destino, null);
    }

    private void AgendarPeloPainel()
    {
        if (CartaoAberto() is { } l) AbrirAgendar(l);
    }

    private async Task Executar(Func<Task> acao, bool noModal)
    {
        erroModal = null;
        if (!await Executar(acao) && noModal)
        {
            erroModal = Erro;
            Erro = null;
        }
    }
}
