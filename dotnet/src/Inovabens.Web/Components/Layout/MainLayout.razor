@inherits LayoutComponentBase
@implements IDisposable
@inject AlertasService Alertas
@inject NavigationManager Nav

@* data-interativo: o circuito do Blazor já assumiu a página (usado pelos testes de ponta a ponta) *@
<div class="app" data-interativo="@(RendererInfo.IsInteractive ? "sim" : "nao")">
    <aside class="lateral">
        <a class="marca" href="">
            <img src="img/marca.svg" alt="" />
            <span class="marca-texto">
                <span class="marca-nome">INOVA<b>BENS</b></span>
                <span class="marca-sub">Gestão patrimonial</span>
            </span>
        </a>
        <nav>
            <span class="nav-titulo">Menu</span>
            <NavLink class="nav-item" href="" Match="NavLinkMatch.All"><Icone Nome="painel" />Painel</NavLink>
            @if (usuario?.Pode(Permissoes.ImoveisVer) == true)
            {
                <NavLink class="nav-item" href="imoveis"><Icone Nome="imoveis" />Imóveis</NavLink>
            }
            @if (usuario?.Pode(Permissoes.PessoasVer) == true)
            {
                <NavLink class="nav-item" href="pessoas"><Icone Nome="pessoas" />Pessoas</NavLink>
            }
            @if (usuario?.Pode(Permissoes.CrmVer) == true)
            {
                <NavLink class="nav-item" href="crm"><Icone Nome="crm" />CRM</NavLink>
            }
            @if (usuario?.Pode(Permissoes.AgendaVer) == true)
            {
                <NavLink class="nav-item" href="agenda"><Icone Nome="agenda" />Agenda</NavLink>
            }
            @if (usuario is not null && Pages.AdminPagina.PodeAlgo(usuario))
            {
                <NavLink class="nav-item" href="admin"><Icone Nome="admin" />Administração</NavLink>
            }
        </nav>
        <div class="lateral-rodape">CRECI 50457-J</div>
    </aside>

    <div class="principal">
        <header class="topo">
            <a class="sino" href="alertas" title="Alertas" aria-label="Alertas">
                <Icone Nome="sino" />
                @if (alertas > 0)
                {
                    <span class="contador">@(alertas > 99 ? "99+" : alertas.ToString())</span>
                }
            </a>
            <span class="separador-topo"></span>
            <a href="conta" class="usuario-topo" title="Minha conta">
                <span class="avatar">@Iniciais(usuario?.Nome)</span>
                <span class="usuario-dados"><strong>@usuario?.Nome</strong><span>@usuario?.PerfilNome</span></span>
            </a>
            <form method="post" action="sair">
                <AntiforgeryToken />
                <button type="submit" class="btn-ghost mini"><Icone Nome="sair" />Sair</button>
            </form>
        </header>
        <main class="conteudo">
            @if (usuario is null)
            {
                @Body
            }
            else
            {
                <CascadingValue Value="usuario" IsFixed="true">
                    @Body
                </CascadingValue>
            }
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private UsuarioAtual? usuario;
    private int alertas;

    protected override void OnInitialized() => Nav.LocationChanged += AoNavegar;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null) usuario = UsuarioAtual.De((await AuthState).User);
        await ContarAlertas();
    }

    /// <summary>O contador do sino é atualizado a cada navegação (marcar como lido em /alertas reflete aqui).</summary>
    private async void AoNavegar(object? _, LocationChangedEventArgs e)
    {
        await ContarAlertas();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ContarAlertas()
    {
        if (usuario is null) return;
        try { alertas = await Alertas.ContagemAsync(usuario); }
        catch { /* o contador é auxiliar: falha no banco não derruba o layout */ }
    }

    /// <summary>"Ana Maria Souza" -> "AS" (primeira e última palavra).</summary>
    private static string Iniciais(string? nome)
    {
        var partes = (nome ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes switch
        {
            [] => "?",
            [var unico] => unico[..1].ToUpperInvariant(),
            _ => (partes[0][..1] + partes[^1][..1]).ToUpperInvariant(),
        };
    }

    public void Dispose() => Nav.LocationChanged -= AoNavegar;
}
