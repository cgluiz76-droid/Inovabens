@inherits LayoutComponentBase
@implements IDisposable
@inject AlertasService Alertas
@inject LancamentosFinanceirosService LancamentosFin
@inject NavigationManager Nav

@* data-interativo: o circuito do Blazor já assumiu a página (usado pelos testes de ponta a ponta) *@
<div class="app" data-interativo="@(RendererInfo.IsInteractive ? "sim" : "nao")">
    @* Menu lateral: no desktop pode ser recolhido (só ícones; data-menu no <html>); no celular vira gaveta aberta
       pelo "Mais" da barra inferior (data-menu-aberto). Comportamento em wwwroot/interface.js. *@
    <aside class="lateral" id="menu-lateral" aria-label="Menu principal">
        <a class="marca" href="" title="Inovabens">
            <img src="img/marca.svg" alt="" />
            <span class="marca-texto">
                <span class="marca-nome">INOVA<b>BENS</b></span>
                <span class="marca-sub">Gestão patrimonial</span>
            </span>
        </a>
        <nav>
            <NavLink class="nav-item" href="" Match="NavLinkMatch.All" title="Painel"><Icone Nome="painel" /><span class="nav-texto">Painel</span></NavLink>
            @if (Operacao)
            {
                <span class="nav-titulo">Operação</span>
            }
            @if (usuario?.Pode(Permissoes.ImoveisVer) == true)
            {
                <NavLink class="nav-item" href="imoveis" title="Imóveis"><Icone Nome="imoveis" /><span class="nav-texto">Imóveis</span></NavLink>
            }
            @if (usuario?.Pode(Permissoes.PessoasVer) == true)
            {
                <NavLink class="nav-item" href="pessoas" title="Pessoas"><Icone Nome="pessoas" /><span class="nav-texto">Pessoas</span></NavLink>
            }
            @if (usuario?.Pode(Permissoes.CrmVer) == true)
            {
                <NavLink class="nav-item" href="crm" title="CRM"><Icone Nome="crm" /><span class="nav-texto">CRM</span></NavLink>
            }
            @if (usuario?.Pode(Permissoes.ProcessosVer) == true)
            {
                <NavLink class="nav-item" href="processos" title="Processos"><Icone Nome="processos" /><span class="nav-texto">Processos</span></NavLink>
            }
            @if (usuario?.Pode(Permissoes.AgendaVer) == true)
            {
                <span class="nav-titulo">Rotina</span>
                <NavLink class="nav-item" href="agenda" title="Agenda"><Icone Nome="agenda" /><span class="nav-texto">Agenda</span></NavLink>
                <NavLink class="nav-item" href="atividades" title="Atividades"><Icone Nome="atividades" /><span class="nav-texto">Atividades</span></NavLink>
            }
            @if (usuario?.Pode(Permissoes.FinanceiroEmpresaVer) == true)
            {
                @* financeiro da própria imobiliária (o de cada imóvel fica na aba do imóvel) *@
                <span class="nav-titulo">Gestão</span>
                <NavLink class="nav-item" href="financeiro" Match="NavLinkMatch.All" title="Financeiro"><Icone Nome="dinheiro" /><span class="nav-texto">Financeiro</span></NavLink>
            }
            @if (usuario is not null && Pages.AdminPagina.PodeAlgo(usuario))
            {
                <NavLink class="nav-item nav-admin" href="admin" title="Administração"><Icone Nome="admin" /><span class="nav-texto">Administração</span></NavLink>
            }
        </nav>
        <button type="button" class="recolher-menu" data-recolher-menu aria-controls="menu-lateral" title="Recolher/expandir o menu">
            <Icone Nome="recolher" /><span class="nav-texto">Recolher menu</span>
        </button>
        <div class="lateral-rodape">CRECI 50457-J</div>
    </aside>
    <div class="menu-veu" data-fechar-menu aria-hidden="true"></div>

    <div class="principal">
        <header class="topo">
            <a class="marca-topo" href="" aria-label="Inovabens — Painel">
                <img src="img/marca.svg" alt="" />
                <span class="marca-nome">INOVA<b>BENS</b></span>
            </a>
            @if (usuario is not null)
            {
                <button type="button" class="sino" data-abrir-busca aria-label="Buscar (Ctrl+K)" title="Buscar (Ctrl+K)" @onclick="() => busca?.Abrir()">
                    <Icone Nome="busca" />
                </button>
            }
            @* troca de tema feita por interface.js (funciona sem o circuito do Blazor) *@
            <button type="button" class="sino alternar-tema" data-alternar-tema aria-label="Alternar tema claro/escuro" title="Alternar tema">
                <span class="tema-escuro"><Icone Nome="lua" /></span>
                <span class="tema-claro"><Icone Nome="sol" /></span>
            </button>
            @if (usuario?.Pode(Permissoes.FinanceiroVer) == true)
            {
                <a class="sino @(atrasados > 0 ? "sino-financeiro" : "")" href="financeiro/atrasados"
                   title="@(atrasados > 0 ? $"{atrasados} título(s) a pagar/receber em atraso" : "Títulos em atraso: nenhum")"
                   aria-label="@(atrasados > 0 ? $"Títulos em atraso {atrasados}" : "Títulos em atraso")">
                    <Icone Nome="dinheiro" />
                    @if (atrasados > 0)
                    {
                        <span class="contador">@(atrasados > 99 ? "99+" : atrasados.ToString())</span>
                    }
                </a>
            }
            <a class="sino" href="alertas" title="Alertas" aria-label="@(alertas > 0 ? $"Alertas {(alertas > 99 ? "99+" : alertas.ToString())}" : "Alertas")">
                <Icone Nome="sino" />
                @if (alertas > 0)
                {
                    <span class="contador">@(alertas > 99 ? "99+" : alertas.ToString())</span>
                }
            </a>
            <span class="separador-topo"></span>
            <a href="conta" class="usuario-topo" title="Minha conta">
                <span class="avatar">@Iniciais(usuario?.Nome)</span>
                <span class="usuario-dados"><strong>@usuario?.Nome</strong><span>@usuario?.PerfilNome</span></span>
            </a>
            <form method="post" action="sair">
                <AntiforgeryToken />
                <button type="submit" class="btn-ghost mini" aria-label="Sair"><Icone Nome="sair" /><span class="rotulo-sair">Sair</span></button>
            </form>
        </header>
        <main class="conteudo">
            @if (usuario is null)
            {
                @Body
            }
            else
            {
                <CascadingValue Value="usuario" IsFixed="true">
                    @Body
                </CascadingValue>
            }
        </main>
    </div>

    @* celular: atalhos no alcance do polegar; "Mais" abre o menu completo *@
    <nav class="barra-inferior" aria-label="Atalhos">
        <NavLink class="atalho" href="" Match="NavLinkMatch.All"><Icone Nome="painel" /><span>Painel</span></NavLink>
        @if (usuario?.Pode(Permissoes.ImoveisVer) == true)
        {
            <NavLink class="atalho" href="imoveis"><Icone Nome="imoveis" /><span>Imóveis</span></NavLink>
        }
        @if (usuario?.Pode(Permissoes.CrmVer) == true)
        {
            <NavLink class="atalho" href="crm"><Icone Nome="crm" /><span>CRM</span></NavLink>
        }
        @if (usuario?.Pode(Permissoes.AgendaVer) == true)
        {
            <NavLink class="atalho" href="agenda"><Icone Nome="agenda" /><span>Agenda</span></NavLink>
        }
        <button type="button" class="atalho" data-abrir-menu aria-controls="menu-lateral" aria-expanded="false"><Icone Nome="menu" /><span>Mais</span></button>
    </nav>
</div>

@if (usuario is not null)
{
    <BuscaGlobal @ref="busca" Usuario="usuario" />
}

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private UsuarioAtual? usuario;
    private BuscaGlobal? busca;
    private int alertas;
    private int atrasados;

    protected override void OnInitialized() => Nav.LocationChanged += AoNavegar;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null) usuario = UsuarioAtual.De((await AuthState).User);
        await ContarAlertas();
    }

    /// <summary>O contador do sino é atualizado a cada navegação (marcar como lido em /alertas reflete aqui).</summary>
    private async void AoNavegar(object? _, LocationChangedEventArgs e)
    {
        await ContarAlertas();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ContarAlertas()
    {
        if (usuario is null) return;
        try
        {
            alertas = await Alertas.ContagemAsync(usuario);
            atrasados = await LancamentosFin.ContagemAtrasadosAsync(usuario);
        }
        catch { /* os contadores são auxiliares: falha no banco não derruba o layout */ }
    }

    /// <summary>"Ana Maria Souza" -> "AS" (primeira e última palavra).</summary>
    /// <summary>Mostra o título "Operação" só se houver algum item do grupo.</summary>
    private bool Operacao => usuario is not null && (usuario.Pode(Permissoes.ImoveisVer) || usuario.Pode(Permissoes.PessoasVer)
        || usuario.Pode(Permissoes.CrmVer) || usuario.Pode(Permissoes.ProcessosVer));

    private static string Iniciais(string? nome)
    {
        var partes = (nome ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes switch
        {
            [] => "?",
            [var unico] => unico[..1].ToUpperInvariant(),
            _ => (partes[0][..1] + partes[^1][..1]).ToUpperInvariant(),
        };
    }

    public void Dispose() => Nav.LocationChanged -= AoNavegar;
}
