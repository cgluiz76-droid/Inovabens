# Copie para .env (o instalar.sh já faz isso e gera os segredos). Nunca envie o .env ao Git.
DOMINIO=inovabens.exemplo.com.br
SEED_ADMIN_EMAIL=voce@empresa.com
# senha forte do administrador inicial (em produção a senha padrão é recusada)
SEED_ADMIN_PASSWORD=

# gerados pelo instalar.sh (openssl rand -hex 32). Migrando de outro servidor: use a MESMA TOKEN_ENC_KEY de lá.
DB_PASSWORD=
TOKEN_ENC_KEY=
JWT_REFRESH_SECRET=

# opcionais
# drive compartilhado das fotos/documentos (a chave JSON vai em ./google-drive.json)
GOOGLE_DRIVE_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WEBHOOK_URL=
GOOGLE_MAPS_API_KEY=
MAGNIFIC_API_KEY=
